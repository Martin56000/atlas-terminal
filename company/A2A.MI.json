{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:55:02+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:55:02+00:00"},"data":{"profile":{"name":"A2A S.p.A.","sector":"Utilities","industry":"Utilities - Diversified","country":"Italy","city":"Milan","website":"https://www.gruppoa2a.it/it/home","employees":15212,"summary":"A2A S.p.A. engages in the production, sale, and distribution of gas and electricity, and district heating in Italy and internationally. It generates electricity through hydroelectric, thermoelectric, photovoltaic, and wind plants; and sells and distributes gas. The company also engages in the production and sale of heat produced through district heating networks; waste management activities, including collection and street sweeping, treatment, disposal, and recovery of materials and energy; and the construction and management of integrated waste disposal plants and systems. In addition, it offers integrated water cycle management services; and technical consultancy services relating to energy efficiency certificates. Further, the company is involved in the management of public lighting systems and street lights, and water purification and sewer activities, as well as offers garbage collection, street sweeping, video surveillance, energy efficiency, and electric mobility services. A2A S.p.A. is headquartered in Milan, Italy.","exchange":"Milan","currency":"EUR","financial_currency":"EUR","summary_fr":"A2A S.p.A. s’occupe de la production, de la vente et de la distribution de gaz et d’électricité, ainsi que du chauffage urbain en Italie et à l’international. Il produit de l'électricité par le biais de centrales hydroélectriques, thermoélectriques, photovoltaïques et éoliennes; et vend et distribue du gaz. La société se consacre également à la production et à la vente de chaleur produite par les réseaux de chauffage urbain; activités de gestion des déchets, y compris la collecte et le balayage des rues, le traitement, l'élimination et la récupération des matériaux et de l'énergie; et la construction et la gestion d'installations et de systèmes intégrés d'élimination des déchets."},"valuation":{"market_cap_yahoo":7587039232,"shares_outstanding":3127386205,"trailing_pe":11.027273,"forward_pe":11.641076,"price_to_book":1.4596872,"ev_to_ebitda":6.719,"ev_to_revenue":0.902,"dividend_yield":0.0428,"payout_ratio":0.4747,"beta_yahoo":0.792},"targets":{"current_price":2.426,"mean":2.86286,"median":2.9,"high":3.14,"low":2.6,"n_analysts":7,"reco_mean":2.0,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-10"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":3771000000,"ex_dividend":"2026-05-18","dividend_date":null},"holders":{"insiders_pct":0.5,"institutions_pct":0.17,"institutions_float_pct":0.34001,"institutions_n":201,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":7239,"value":17561,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0073,"shares":22998131,"value":55793468,"date":"2026-07-31","chg":-0.008},{"name":"SPDR-EUROPE-SSgA SPDR ETFS Europe I-State Street SPDR S&P Euro Dividen","pct":0.0069999998,"shares":21909408,"value":53152226,"date":"2026-09-30","chg":0.0342},{"name":"SPDR-EUROPE-SSgA SPDR ETFS Europe I-SPDR S&P Euro Dvdnd Arstcrts UCITS","pct":0.0063,"shares":19862466,"value":48186344,"date":"2026-01-31","chg":0.0257},{"name":"iShares Trust-iShares International Select Dividend ETF","pct":0.0055,"shares":17352354,"value":42096812,"date":"2026-09-30","chg":0.0008},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0049,"shares":15281872,"value":37073823,"date":"2026-06-30","chg":0.0076},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0036000002,"shares":11380449,"value":27608970,"date":"2026-09-30","chg":0.0127},{"name":"AQR Funds-AQR Long-Short Equity Fund","pct":0.0034999999