{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-11-06T07:44:23+00:00","status":"ok","error":null,"last_success":"2026-11-06T07:44:23+00:00"},"data":{"profile":{"name":"Airtel Africa Plc","sector":"Communication Services","industry":"Telecom Services","country":"United Kingdom","city":"London","website":"https://airtel.africa","employees":4512,"summary":"Airtel Africa Plc, together with its subsidiaries, provides telecommunications and mobile money services in Nigeria, East Africa, and Francophone Africa. It offers pre and post-paid wireless voice, international roaming, and fixed line telephony services; data services, including 4G and 5G, home broadband, fibre, and data centers; and mobile money services, such as digital wallet payments systems, microloans, merchant, savings, insurance, international, and international money transfers. The company also provides messaging, value added, and tower sharing services, as well as infrastructure sharing, mobile commerce, and support services. The company was incorporated in 2018 and is based in London, the United Kingdom. Airtel Africa Plc is a subsidiary of Airtel Africa Mauritius Limited.","exchange":"LSE","currency":"GBp","financial_currency":"USD","summary_fr":"Airtel Africa Plc, avec ses filiales, fournit des services de télécommunications et d’argent mobile au Nigeria, en Afrique de l’Est et en Afrique francophone. Il offre des services vocaux sans fil pré et postpayés, des services d'itinérance internationale et de téléphonie fixe; services de données, y compris 4G et 5G, haut débit domestique, fibre et centres de données; et des services d'argent mobile, tels que les systèmes de paiement de portefeuille numérique, les microcrédits, les marchands, l'épargne, les assurances, les transferts d'argent internationaux et internationaux. La société fournit également des services de messagerie, de valeur ajoutée et de partage de tours, ainsi que des services de partage d'infrastructures, de commerce mobile et de soutien."},"valuation":{"market_cap_yahoo":10481271808,"shares_outstanding":3624229288,"trailing_pe":19.28,"forward_pe":11.845517,"price_to_book":429.44598,"ev_to_ebitda":5.269,"ev_to_revenue":2.287,"dividend_yield":0.0184,"payout_ratio":0.3433,"beta_yahoo":0.587},"targets":{"current_price":289.2,"mean":395.8057,"median":375.8358,"high":517.31104,"low":302.36087,"n_analysts":6,"reco_mean":2.4,"reco_key":"buy"},"calendar":{"earnings_dates":["2027-01-29"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":2054310000,"ex_dividend":"2026-11-12","dividend_date":null},"holders":{"insiders_pct":0.79668,"institutions_pct":0.11576,"institutions_float_pct":0.56934,"institutions_n":267,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":6832,"value":1975814,"date":"2026-06-30","chg":-0.40080002},{"name":"Meyer Handelman Co","pct":0.0,"shares":12690,"value":3669948,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"New World Fund Inc","pct":0.0047999998,"shares":17500000,"value":5061000213,"date":"2026-09-30","chg":0.2666},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0025,"shares":9224718,"value":2667788558,"date":"2026-07-31","chg":-0.0774},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0018000001,"shares":6564199,"value":1898366430,"date":"2026-09-30","chg":0.0117},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0017,"shares":6143104,"value":1776585751,"date":"2026-06-30","chg":-0.077},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Intl Core Eqy. 2 PORT.","pct":0.0011,"shares":3878871,"value":1121769540,"date":"2026-07-31","chg":0.0},{"name":"iShares Trust-iShares MSCI EAFE ETF","pct":0.00090000004,"shares":3115193,"value":900913853,"date":"2026-09-30","chg":0.0},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.0008,"shares":3011904,"value":871042673,"date":"2026-08-31","chg":0.011},{"name":