{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T15:53:07+00:00","status":"ok","error":null,"last_success":"2026-10-22T15:53:07+00:00"},"data":{"profile":{"name":"ABB Ltd","sector":"Industrials","industry":"Electrical Equipment & Parts","country":"Switzerland","city":"Zurich","website":"https://www.abb.com","employees":111900,"summary":"ABB Ltd provides electrification, motion, and automation solutions and products for customers in utilities, industry and transport, and infrastructure in Europe, the Americas, Asia, the Middle East, and Africa. The company operates through Electrification, Motion, and Automation segments. Its Electrification segment offers renewable power solutions, modular substation packages, distribution automation products, switchboards and panelboards, switchgears, UPS solutions, circuit breakers, measuring and sensing devices, control products, wiring accessories, enclosures and cabling systems, and intelligent home and building solutions. The company's Motion segment designs, manufactures, and sells drives, motors, generators, and traction converters that are driving the low-carbon future for industries, cities, infrastructure, and transportation. The company's Automation segment offers industry-specific, integrated automation, electrification and digital solutions, as well as lifecycle services for the process, hybrid and marine industries. This segment also provides control technologies; process, machine and factory automation; industrial software; advanced analytics; sensing and measurement technology; and marine propulsion systems; services such as remote monitoring, preventive maintenance, asset performance management, emission monitoring and cybersecurity. It serves oil, gas, renewables, chemicals, mining, metals, cement, pulp and paper, pharmaceuticals, battery manufacturing, food and beverage, space, power generation, water, marine, and ports industries. The company was founded in 1883 and is headquartered in Zurich, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"USD","summary_fr":"ABB Ltd fournit des solutions et des produits d'électrification, de mouvement et d'automatisation aux clients des services publics, de l'industrie et des transports, ainsi que des infrastructures en Europe, en Amérique, en Asie, au Moyen-Orient et en Afrique. La société opère à travers les secteurs de l'électrification, du mouvement et de l'automatisation. Son segment Électrification propose des solutions d'énergie renouvelable, des ensembles de postes modulaires, des produits d'automatisation de la distribution, des tableaux électriques et des tableaux, des appareils de commutation, des solutions UPS, des disjoncteurs, des dispositifs de mesure et de détection, des produits de contrôle, des accessoires de câblage, des boîtiers et des systèmes de câblage, ainsi que des solutions intelligentes pour la maison et le bâtiment."},"valuation":{"market_cap_yahoo":124685393920,"shares_outstanding":1809132299,"trailing_pe":31.32727,"forward_pe":22.45821,"price_to_book":9.118745,"ev_to_ebitda":18.2,"ev_to_revenue":3.652,"dividend_yield":0.013099999,"payout_ratio":0.42439997,"beta_yahoo":null},"targets":{"current_price":68.92,"mean":82.23045,"median":81.69823,"high":95.884865,"low":66.51036,"n_analysts":27,"reco_mean":2.80769,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-20"],"eps_avg":0.84764,"eps_low":0.83527,"eps_high":0.86,"revenue_avg":10416498240,"ex_dividend":"2026-03-23","dividend_date":"2025-04-02"},"holders":{"insiders_pct":0.00028,"institutions_pct":0.59453,"institutions_float_pct":0.59470004,"institutions_n":796,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0001,"shares":248586,"value":17132546,"date":"2026-06-30","chg":4.7956},{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":30800,"value":2122735,"date":"2026-06-30","chg":0.0},{"name":"Generali Investments Cee, Investicni Spolecnost, A.s."