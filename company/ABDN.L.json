{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:42:28+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:42:28+00:00"},"data":{"profile":{"name":"Aberdeen Group Plc","sector":"Financial Services","industry":"Asset Management","country":"United Kingdom","city":"Edinburgh","website":"https://www.abrdn.com","employees":4435,"summary":"Aberdeen Group Plc provides asset management services in the United Kingdom, Europe, North America, and Asia. It makes traditional, private equity/ buyout, venture capital, secondary (direct), secondary (indirect), real estate investments & blend investments in early venture, middle market, growth capital & buyout investments. The company offers investment solutions and funds; long-term savings and investment products to individual and corporate customers; and life insurance and savings products. It provides its products through institutional, wholesale, and retail distribution channels. It invests in healthcare, information technology, telecommunication services, media & real estate investments. The firm invests globally. It prefers to have majority stakes in its portfolio companies. Aberdeen Group Plc was founded in 1825 and is based in Edinburgh, United Kingdom with additional offices across Europe, Middle East, Asia Pacific, North America and South America.","exchange":"LSE","currency":"GBp","financial_currency":"GBP","summary_fr":"Aberdeen Group Plc fournit des services de gestion d'actifs au Royaume-Uni, en Europe, en Amérique du Nord et en Asie. Il effectue des investissements traditionnels, du capital-investissement / rachat, du capital-risque, des investissements secondaires (directs), secondaires (indirects), immobiliers et des investissements mixtes dans des investissements de capital-risque, de marché intermédiaire, de capital de croissance et de rachat. L'entreprise offre des solutions et des fonds de placement, des produits d'épargne et de placement à long terme aux particuliers et aux entreprises, ainsi que des produits d'assurance-vie et d'épargne."},"valuation":{"market_cap_yahoo":4018877184,"shares_outstanding":1790943647,"trailing_pe":10.685715,"forward_pe":14.449451,"price_to_book":79.91453,"ev_to_ebitda":11.7,"ev_to_revenue":2.381,"dividend_yield":0.0656,"payout_ratio":0.6986,"beta_yahoo":1.391},"targets":{"current_price":224.4,"mean":241.625,"median":235.5,"high":294.0,"low":205.0,"n_analysts":16,"reco_mean":3.1875,"reco_key":"hold"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-08-13","dividend_date":null},"holders":{"insiders_pct":0.00159,"institutions_pct":0.44267,"institutions_float_pct":0.44338,"institutions_n":144,"institutions":[],"funds":[],"insider_trades":[{"name":"Magnusson (Torbjoern)","relation":"","text":"Bought at price 3.27 per share.","date":"2026-09-21","shares":80670,"value":264113},{"name":"Lacaille (Richard)","relation":"","text":"Bought at price 3.24 per share.","date":"2026-07-30","shares":50000,"value":161800},{"name":"Bickerstaffe (Katie)","relation":"","text":"Bought at price 3.21 per share.","date":"2026-07-30","shares":8313,"value":26676},{"name":"Barclays Global Investors","relation":"","text":"","date":"2026-05-22","shares":279300,"value":null},{"name":"Barclays Global Investors","relation":"","text":"","date":"2026-05-13","shares":274435,"value":null},{"name":"Barclays Global Investors","relation":"","text":"","date":"2026-05-11","shares":875815,"value":null},{"name":"Barclays Global Investors","relation":"","text":"","date":"2026-04-22","shares":384540,"value":null},{"name":"Windsor (Jason)","relation":"","text":"","date":"2026-04-13","shares":173410,"value":null},{"name":"Windsor (Jason)","relation":"","text":"Sold at price 2.71 per share.","date":"2026-04-13","shares":81503,"value":221199},{"name":"Windsor (Jason)","relation":"","text":"","date":"2026-04-08","shares":9758,"value":null},{"name":