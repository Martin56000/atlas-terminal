{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:38:39+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:38:39+00:00"},"data":{"profile":{"name":"Associated British Foods plc","sector":"Consumer Defensive","industry":"Packaged Foods","country":"United Kingdom","city":"London","website":"https://www.abf.co.uk","employees":138000,"summary":"Associated British Foods plc engages in the food, ingredients, and retail businesses worldwide. It operates through five segments: Retail, Grocery, Ingredients, Sugar, and Agriculture. The Retail segment is involved in buying and merchandising clothing and accessories through the Primark and Penneys retail chains, which offer women's, men's, and kidswear, as well as beauty, homeware, and accessories. The Grocery segment manufactures grocery products, including hot beverages, sugar, vegetable oils, balsamic vinegars, bread and baked goods, cereals, ethnic food and meat products to retail, wholesale, and foodservice businesses. The Ingredients segment manufactures yeast and bakery ingredients, specialty ingredients focused on enzymes, procession extracts, health and nutrition, and pharmaceutical delivery systems. The Sugar segment is involved in growing and processing sugar beet and sugar cane. The Agriculture segment manufactures specialty feed ingredients, premix, and compound animal feed; and other products and services for the agriculture sector. The company was incorporated in 1934 and is headquartered in London, the United Kingdom. Associated British Foods plc operates as a subsidiary of Wittington Investments Limited.","exchange":"LSE","currency":"GBp","financial_currency":"GBP","summary_fr":"Associated British Foods plc s'engage dans les secteurs de l'alimentation, des ingrédients et de la vente au détail dans le monde entier. Elle opère à travers cinq segments : la vente au détail, l’épicerie, les ingrédients, le sucre et l’agriculture. Le segment Retail est impliqué dans l'achat et la commercialisation de vêtements et d'accessoires via les chaînes de magasins Primark et Penneys, qui proposent des vêtements pour femmes, hommes et enfants, ainsi que des produits de beauté, des articles ménagers et des accessoires.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":13491565568,"shares_outstanding":698321224,"trailing_pe":14.526315,"forward_pe":13.109771,"price_to_book":119.69518,"ev_to_ebitda":7.669,"ev_to_revenue":0.87,"dividend_yield":0.0326,"payout_ratio":0.4727,"beta_yahoo":0.813},"targets":{"current_price":1932.0,"mean":1798.824,"median":1800.0,"high":2040.0,"low":1520.0,"n_analysts":17,"reco_mean":3.58824,"reco_key":"underperform"},"calendar":{"earnings_dates":["2026-11-03"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-05-28","dividend_date":null},"holders":{"insiders_pct":0.60537,"institutions_pct":0.20799999,"institutions_float_pct":0.52708,"institutions_n":261,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0004,"shares":269882,"value":521412024,"date":"2025-09-30","chg":0.0375}],"funds":[{"name":"Artisan Partners Funds Inc.-Artisan International Value Fund","pct":0.039300002,"shares":27634117,"value":53389114044,"date":"2026-06-30","chg":0.0677},{"name":"Bridge Builder Trust-Bridge Builder International Equity Fund","pct":0.0086,"shares":6019003,"value":11628713796,"date":"2026-06-30","chg":0.0084},{"name":"AMG Funds-AMG Yacktman Focused Fund","pct":0.0070999996,"shares":5000000,"value":9660000000,"date":"2026-06-30","chg":1.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0058,"shares":4080578,"value":7883676696,"date":"2026-07-31","chg":-0.0382},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0038,"shares":2696344,"value":5209336608,"date":"2026-06-30","chg":-0.0419},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0033000002,"shares":2339069,"value":45190813