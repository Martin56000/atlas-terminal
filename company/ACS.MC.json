{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:56:47+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:56:47+00:00"},"data":{"profile":{"name":"ACS, Actividades de Construcción y Servicios, S.A.","sector":"Industrials","industry":"Engineering & Construction","country":"Spain","city":"Madrid","website":"https://www.grupoacs.com","employees":152300,"summary":"ACS, Actividades de Construcción y Servicios, S.A. provides construction and related services in Spain, the United States, Australia, Canada, Germany, the rest of Europe, and internationally. It operates through five segments: Turner, CIMIC, Engineering and Construction, Infrastructure, and Other. The Turner segment offers comprehensive construction and project management services, focusing on high-tech growth markets, including data centers and battery plants, primarily in North America. The CIMIC segment delivers construction, services, and public-private partnership (PPP) solutions, and includes mining services through Thiess. The Engineering and Construction segment encompasses Dragados' activities in Europe and North America, as well as Hochtief's construction and PPP operations in Europe. The Infrastructure segment covers Iridium and ACS Digital & Energy, and manages a 50% equity interest in Abertis Infraestructuras, S.A., focusing on digitalization, energy transition, sustainable mobility, concessions, and traditional infrastructure across Europe, Latin America, and North America. The Other segment comprises real estate, renewable energy, water assets, facilities management, social and health services, and insurance activities. The company offers services such as public and private works construction, maintenance and operation of transport and urban infrastructure, building restoration, development and management of energy and digital infrastructure, environmental services, waste treatment, logistics, and auxiliary urban services. ACS, Actividades de Construcción y Servicios, S.A. was incorporated in 1942 and is based in Madrid, Spain.","exchange":"MCE","currency":"EUR","financial_currency":"EUR","summary_fr":"ACS, Actividades de Construccin y Servicios, S.A. fournit des services de construction et des services connexes en Espagne, aux États-Unis, en Australie, au Canada, en Allemagne, dans le reste de l'Europe et à l'international. Elle exerce ses activités dans cinq secteurs : Turner, CIMIC, Ingénierie et construction, Infrastructure et autres. Le segment Turner offre des services complets de construction et de gestion de projet, en se concentrant sur les marchés en croissance de haute technologie, y compris les centres de données et les usines de batteries, principalement en Amérique du Nord."},"valuation":{"market_cap_yahoo":23995109376,"shares_outstanding":260391846,"trailing_pe":20.120089,"forward_pe":18.490871,"price_to_book":4.0560765,"ev_to_ebitda":10.772,"ev_to_revenue":0.482,"dividend_yield":0.0255,"payout_ratio":0.6102,"beta_yahoo":0.645},"targets":{"current_price":92.15,"mean":132.64375,"median":132.35,"high":159.0,"low":104.0,"n_analysts":16,"reco_mean":1.75,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-12"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":14474000000,"ex_dividend":"2026-06-29","dividend_date":null},"holders":{"insiders_pct":0.20138,"institutions_pct":0.31924,"institutions_float_pct":0.39973998,"institutions_n":411,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0005,"shares":149740,"value":13798541,"date":"2026-06-30","chg":0.2241}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0095999995,"shares":2673612,"value":246373349,"date":"2026-07-31","chg":0.0221},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0063,"shares":1747957,"value":161074240,"date":"2026-06-30","chg":0.0124},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0049,"shar