{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-11-12T16:53:59+00:00","status":"ok","error":null,"last_success":"2026-11-12T16:53:59+00:00"},"data":{"profile":{"name":"Koninklijke Ahold Delhaize N.V.","sector":"Consumer Defensive","industry":"Grocery Stores","country":"Netherlands","city":"Zaandam","website":"https://www.aholddelhaize.com","employees":384000,"summary":"Koninklijke Ahold Delhaize N.V. operates retail food stores and e-commerce in the Netherlands, the United States, and internationally. The company's stores offer produce, dairy, meat, deli, bakery, seafood, and frozen products; grocery, beer, and wine; floral, pet food, health and beauty care, kitchen and cookware, gardening tools, general merchandise articles, electronics, newspapers and magazines, and tobacco; gasoline; and pharmacy products. It operates its supermarkets, convenience stores, and online stores under the Albert, Albert Heijin, Alfa Beta Vassilopoulos, bol, Delhaize, ENA, Food Lion, Gall & Gall, Giant Food, The GIANT Company, Hannaford, Maxi, Mega Image, Stop & Shop, Profi, and Super Indo brands. The company was formerly known as Koninklijke Ahold N.V. and changed its name to Koninklijke Ahold Delhaize N.V. in July 2016. The company was founded in 1867 and is headquartered in Zaandam, the Netherlands.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"Koninklijke Ahold Delhaize N.V. exploite des magasins d'alimentation et de commerce électronique aux Pays-Bas, aux États-Unis et à l'étranger. Les magasins de la société offrent des produits, des produits laitiers, de la viande, des charcuteries, des boulangeries, des fruits de mer et des produits surgelés; épicerie, bière et vin; fleurs, aliments pour animaux de compagnie, soins de santé et de beauté, cuisine et ustensiles de cuisine, outils de jardinage, articles de marchandises générales, produits électroniques, journaux et magazines, et tabac; essence; et produits pharmaceutiques. Elle exploite ses supermarchés, dépanneurs et magasins en ligne sous les marques Albert, Albert Heijin, Alfa Beta Vassilopoulos, bol, Delhaize, ENA, Food Lion, Gall & Gall, Giant Food, The GIANT Company, Hannaford, Maxi, Mega Image, Stop & Shop, Profi et Super Indo."},"valuation":{"market_cap_yahoo":30817320960,"shares_outstanding":873011999,"trailing_pe":13.682171,"forward_pe":12.16545,"price_to_book":2.124586,"ev_to_ebitda":8.56,"ev_to_revenue":0.507,"dividend_yield":0.0352,"payout_ratio":0.4806,"beta_yahoo":0.343},"targets":{"current_price":35.3,"mean":37.29,"median":38.5,"high":44.0,"low":23.02,"n_analysts":18,"reco_mean":2.47368,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-04"],"eps_avg":0.68,"eps_low":0.68,"eps_high":0.68,"revenue_avg":24751419500,"ex_dividend":"2026-08-07","dividend_date":null},"holders":{"insiders_pct":0.00079,"institutions_pct":0.58463,"institutions_float_pct":0.58509,"institutions_n":599,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":35700,"value":1260209,"date":"2026-09-30","chg":0.2061}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.015,"shares":13070372,"value":461384121,"date":"2026-07-31","chg":-0.003},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0099,"shares":8673775,"value":306184250,"date":"2026-06-30","chg":-0.0002},{"name":"Goldman Sachs TRT II-Goldman Sachs GQG Part. Intl Opportunities Fd.","pct":0.0088,"shares":7677744,"value":271024357,"date":"2026-07-31","chg":-0.5034},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0076,"shares":6670963,"value":235484988,"date":"2026-09-30","chg":0.0126},{"name":"Dimensional ETF Trust-Dimensional International Value ETF","pct":0.0047,"shares":4067586,"value":143585782,"date":"2026-07-31","chg":0.1091},{"name":"DFA INVESTMENT TRUST CO-The DFA International Value Series","pct":0.0046,"shares":4003663,"value":141329