{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:53:31+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:53:31+00:00"},"data":{"profile":{"name":"Addtech AB (publ.)","sector":"Industrials","industry":"Industrial Distribution","country":"Sweden","city":"Stockholm","website":"https://www.addtech.com","employees":5051,"summary":"Addtech AB (publ.) provides technical products and solutions for the manufacturing and infrastructure sectors in Sweden, Denmark, Finland, Norway, Germany, the United Kingdom, the rest of Europe, and internationally. The company operates through six segments: Automation, Electrification, Energy, Industry, Process, and Safety. It produces and sells solutions for industrial IT and communications, such as control systems, sensors and vision products, robotics, and data collection solutions; and designs and delivers systems and solutions for the forestry, specialized vehicles, mechanical engineering, electronics industries, waste management and recycling, as well as underwater technology. The company also offers power supply and transmission, electric drivetrain solutions, advanced battery systems, and technical systems for buildings; and overhead line and substation materials for grid construction, railway related electrical infrastructure, control equipment, switchgear, and associated components for delivering electricity to industry, data centers, hospitals and defense. In addition, it is involved in the production and sale of solutions for measuring, controlling, cleaning, and streamlining industrial flows; and provision of components, products, and complete solutions that protect people, property, and critical societal systems. Addtech AB (publ.) was founded in 1906 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Addtech AB (publ.) fournit des produits et des solutions techniques pour les secteurs de la fabrication et des infrastructures en Suède, au Danemark, en Finlande, en Norvège, en Allemagne, au Royaume-Uni, dans le reste de l'Europe et à l'international. La société opère à travers six segments: l'automatisation, l'électrification, l'énergie, l'industrie, les processus et la sécurité. Elle produit et vend des solutions pour l'informatique industrielle et les communications, telles que des systèmes de contrôle, des capteurs et des produits de vision, des solutions de robotique et de collecte de données; et conçoit et fournit des systèmes et des solutions pour la foresterie, les véhicules spécialisés, l'ingénierie mécanique, les industries électroniques, la gestion des déchets et le recyclage, ainsi que la technologie sous-marine."},"valuation":{"market_cap_yahoo":83888103424,"shares_outstanding":257219642,"trailing_pe":36.327484,"forward_pe":39.617348,"price_to_book":9.887941,"ev_to_ebitda":23.135,"ev_to_revenue":3.84,"dividend_yield":0.0117,"payout_ratio":0.42110002,"beta_yahoo":1.079},"targets":{"current_price":310.6,"mean":381.7143,"median":380.0,"high":417.0,"low":340.0,"n_analysts":7,"reco_mean":1.42857,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":2.44866,"eps_low":2.22597,"eps_high":2.77,"revenue_avg":6371183150,"ex_dividend":"2026-08-27","dividend_date":null},"holders":{"insiders_pct":0.01952,"institutions_pct":0.71365,"institutions_float_pct":0.72786003,"institutions_n":289,"institutions":[],"funds":[{"name":"SmallCap World Fund Inc","pct":0.0209,"shares":5442314,"value":1690382761,"date":"2025-09-30","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0125,"shares":3259767,"value":1012483650,"date":"2025-07-31","chg":0.035099998},{"name":"Fidelity Investment Trust-Fidelity Series International Small Cap Fund","pct":0.0117999995,"shares":3057896,"value":949782516,"date":"2025-09-30","chg":0.0},{"name":"Fidelity Investment Trust-Fidelity Series International Gr