{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:53:52+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:53:52+00:00"},"data":{"profile":{"name":"Afry AB","sector":"Industrials","industry":"Engineering & Construction","country":"Sweden","city":"Stockholm","website":"https://afry.com","employees":17179,"summary":"Afry AB provides engineering, design, and advisory services for the infrastructure, industry, and energy sectors in the Nordics, North America, South America, Asia, rest of Europe, and internationally. It operates through Energy, Industry, and Transportation & Places segments. The company offers architecture and design services; automation and manufacturing solutions; automotive and mobility services; building solutions for airports, culture and sports facilities, high security facilities, hospitals, healthcare and research facilities, hotels and restaurants, housing and industrial facilities, offices, retail properties, schools and academic facilities, and stations and terminals; defense technology systems; digital solutions and information technology services; and engineering and consulting services for energy and power applications. It also provides sustainable and environmental solutions; services for food, life science, and pharmaceutical industries; management consulting services; solutions for processing industries, including mining and metals, food and beverage, pulp and paper, and chemical industries, as well as biorefining and biobased solutions; product development services; project management services; transport infrastructure services; solutions for water management; and consulting services and software products. The company was formerly known as ÅF Pöyry AB (publ) and changed its name to Afry AB in June 2021. Afry AB was founded in 1895 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Afry AB fournit des services d'ingénierie, de conception et de conseil pour les secteurs des infrastructures, de l'industrie et de l'énergie dans les pays nordiques, en Amérique du Nord, en Amérique du Sud, en Asie, dans le reste de l'Europe et à l'international. Il opère à travers les secteurs de l'énergie, de l'industrie et des transports et lieux. La société propose des services d'architecture et de conception, des solutions d'automatisation et de fabrication, des services automobiles et de mobilité, des solutions de construction pour les aéroports, les installations culturelles et sportives, les installations de haute sécurité, les hôpitaux, les établissements de santé et de recherche, les hôtels et les restaurants, les logements et les installations industrielles, les bureaux, les établissements de vente au détail, les écoles et les installations universitaires, les stations et les terminaux."},"valuation":{"market_cap_yahoo":14688750592,"shares_outstanding":108961405,"trailing_pe":17.13342,"forward_pe":9.628804,"price_to_book":1.1135436,"ev_to_ebitda":10.804,"ev_to_revenue":0.818,"dividend_yield":0.0469,"payout_ratio":0.79160005,"beta_yahoo":0.908},"targets":{"current_price":129.7,"mean":142.66667,"median":148.0,"high":170.0,"low":110.0,"n_analysts":6,"reco_mean":2.16667,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":3.66594,"eps_low":3.66594,"eps_high":3.66594,"revenue_avg":6845775300,"ex_dividend":"2026-04-29","dividend_date":null},"holders":{"insiders_pct":0.117539994,"institutions_pct":0.59597,"institutions_float_pct":0.67535,"institutions_n":91,"institutions":[],"funds":[{"name":"SmallCap World Fund Inc","pct":0.0198,"shares":2158256,"value":279925796,"date":"2026-09-30","chg":-0.5417},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0126,"shares":1377065,"value":178605326,"date":"2026-07-31","chg":-0.0098},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0087,"share