{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:56:41+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:56:41+00:00"},"data":{"profile":{"name":"Akwel SA","sector":"Consumer Cyclical","industry":"Auto Parts","country":"France","city":"Champfromier","website":"https://akwel-automotive.com","employees":8086,"summary":"Akwel SA manufactures and sells automotive and heavy goods vehicle components in Europe, the Middle East, Africa, Turkey, Morocco, Tunisia, the United States, and Asia. The company offers pipes, valves or sensors for cooling solutions; fuel and oil solutions; control products; and air distributors, turbo air intake and output pipes and exchangers, and exhaust gas recirculation pipes. It also manages washer systems, including tanks and jets comprising storage, pumping, transfer, and jet; mechanism architecture in bonnets, boots, and side and swing doors; and electronic management of hardware, software, transfer, storage, reheating, and pumping systems. Akwel SA was formerly known as MGI Coutier SA and changed its name to AKWEL in June 2018. The company was founded in 1972 and is based in Champfromier, France. Akwel SA operates as a subsidiary of Coutier Junior.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"Akwel SA fabrique et vend des composants automobiles et poids lourds en Europe, au Moyen-Orient, en Afrique, en Turquie, au Maroc, en Tunisie, aux États-Unis et en Asie. La société propose des tuyaux, des vannes ou des capteurs pour les solutions de refroidissement; solutions de carburant et d'huile; produits de contrôle; et les distributeurs d'air, les tuyaux et échangeurs d'admission et de sortie d'air turbo, et les tuyaux de recirculation des gaz d'échappement. Il gère également les systèmes de lavage, y compris les réservoirs et les jets comprenant le stockage, le pompage, le transfert et le jet; architecture du mécanisme dans les capots, les bottes et les portes latérales et battantes; et gestion électronique du matériel, des logiciels, du transfert, du stockage, du réchauffage et des systèmes de pompage."},"valuation":{"market_cap_yahoo":173068160,"shares_outstanding":26544196,"trailing_pe":13.04,"forward_pe":9.518249,"price_to_book":0.28186062,"ev_to_ebitda":1.196,"ev_to_revenue":0.099,"dividend_yield":0.045900002,"payout_ratio":1.2,"beta_yahoo":0.712},"targets":{"current_price":6.52,"mean":8.7,"median":8.7,"high":10.9,"low":6.5,"n_analysts":2,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":["2026-09-17"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-02","dividend_date":null},"holders":{"insiders_pct":0.71009004,"institutions_pct":0.11998,"institutions_float_pct":0.41386002,"institutions_n":19,"institutions":[],"funds":[{"name":"DFA International Small Cap Value Portfolio","pct":0.0062,"shares":166264,"value":1084041,"date":"2023-04-30","chg":0.0},{"name":"DFA Continental Small Company Series","pct":0.0025,"shares":67531,"value":440302,"date":"2023-04-30","chg":-0.0128},{"name":"DFA International Core Equity Portfolio","pct":0.0023999999,"shares":63353,"value":413061,"date":"2023-04-30","chg":0.0},{"name":"iShares MSCI EAFE Small Cap ETF","pct":0.0014,"shares":36551,"value":238312,"date":"2023-07-31","chg":0.0},{"name":"iShares Core MSCI Total International Stock ETF","pct":0.001,"shares":27195,"value":177311,"date":"2023-07-31","chg":0.0},{"name":"DFA International Vector Equity Port","pct":0.0004,"shares":9391,"value":61229,"date":"2023-04-30","chg":0.0},{"name":"Fidelity Low-Priced Stock Fund","pct":0.0004,"shares":11446,"value":74627,"date":"2023-06-30","chg":-0.00029999999},{"name":"College Retirement Equities Fund-Stock Account","pct":0.0004,"shares":10480,"value":68329,"date":"2023-06-30","chg":0.0},{"name":"Dimensional ETF Tr-Dimensional World ex U.S. Core Equity 2 ETF","pct":0.0002,"shares":6684,"value":43579,"date":"2023-04-30