{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-11-13T16:55:27+00:00","status":"ok","error":null,"last_success":"2026-11-13T16:55:27+00:00"},"data":{"profile":{"name":"Auction Technology Group plc","sector":"Communication Services","industry":"Internet Content & Information","country":"United Kingdom","city":"London","website":"https://www.auctiontechnologygroup.com","employees":391,"summary":"Auction Technology Group plc operates online auction marketplaces in the United Kingdom, the United States, and Germany. The company operates through, Arts and Antiques and Industrial and Commercial segments. It offers watches, jewelry, furniture, fine art, decorative art, vintage fashion and classic cars, and collectables; used equipment, commercial vehicles, and machineries from various industries, such as manufacturing, laboratories and pharmaceuticals, warehousing, construction, agriculture, and real estate; and consumer goods and other products. The company also operates marketplaces, such as thesaleroom.com, liveauctioneers.com, lot-tissimo.com, EstateSales.NET, BidSpotter.com, BidSpotter.co.uk, proxibid.com, and i-bidder.com. In addition, it offers Wavebid, a suite of products designed for auction house management; Auction Mobility, which provides digital auction technology for auctioneers, such as customized auction software, website design, and e-commerce solutions; Global Auction Platform, a digital marketplace for real-time audio and video broadcast; and Antiques Trade Gazette, a weekly industry trade magazine and guide to arts and antiques. Further, the company offers atgPay, an integrated payment solution; atgShip, an integrated shipping solution; and atgAMP, a paid-for auctioneer digital marketing solution, as well as provision of auction trading software. Auction Technology Group plc was founded in 1971 and is headquartered in London, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"USD","summary_fr":"Auction Technology Group plc exploite des marchés d'enchères en ligne au Royaume-Uni, aux États-Unis et en Allemagne. La société opère à travers les secteurs des arts et des antiquités et de l'industrie et du commerce. Il offre des montres, des bijoux, des meubles, des beaux-arts, des arts décoratifs, de la mode vintage et des voitures classiques, ainsi que des objets de collection; de l'équipement d'occasion, des véhicules commerciaux et des machines de diverses industries, telles que la fabrication, les laboratoires et les produits pharmaceutiques, l'entreposage, la construction, l'agriculture et l'immobilier; et des biens de consommation et d'autres produits."},"valuation":{"market_cap_yahoo":571059328,"shares_outstanding":121089762,"trailing_pe":null,"forward_pe":13.418671,"price_to_book":144.64632,"ev_to_ebitda":13.582,"ev_to_revenue":3.249,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":0.569},"targets":{"current_price":471.6,"mean":575.6258,"median":602.8131,"high":820.99725,"low":405.0237,"n_analysts":9,"reco_mean":1.55556,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-24"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":null,"dividend_date":null},"holders":{"insiders_pct":0.34728,"institutions_pct":0.78395,"institutions_float_pct":1.20105,"institutions_n":73,"institutions":[],"funds":[{"name":"T. ROWE PRICE Intl Fd.S, INC.-T. Rowe Price Intl Discovery Fd.","pct":0.056399997,"shares":6896119,"value":3252209762,"date":"2026-07-31","chg":-0.025899999},{"name":"TR PRICE-Price (T.Rowe) International Small-Cap Equity Trust","pct":0.013099999,"shares":1603852,"value":756376612,"date":"2026-06-30","chg":-0.026099999},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0033000002,"shares":408655,"value":192721700,"date":"2026-07-31","chg":0.0},{"name":"Dimensional ETF Trust-Dimensional International Small Cap Value ETF","pct":0.003,"shares":364692,"value":171988