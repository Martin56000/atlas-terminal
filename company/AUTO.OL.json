{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:56:21+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:56:21+00:00"},"data":{"profile":{"name":"AutoStore Holdings Ltd.","sector":"Industrials","industry":"Specialty Industrial Machinery","country":"Norway","city":"Nedre Vats","website":"https://www.autostoresystem.com","employees":969,"summary":"AutoStore Holdings Ltd. provides robotic and software technology in Norway, Germany, rest of Europe, the United States, Asia, and internationally. The company offers robots, including R5, R5+, R5 Pro, and R5+ Pro under the Red Line names; AutoStore Bin Liftk Grid-to-Grid configuration; AutoStore Grid; AutoStore Multi-Temperature Solution, a storage solution for frozen and chilled environments; Grid Bracer; and bin products. It also provides VersaAI, a lights-out robotic workstation; CarouselAI, an automated robotic picking workstation solution; VersaPort, a workstation solution; ConveyorPort, a workstation to access bins in the AutoStore grid; CarouselPort which maintains workstation productivity and coordination between robot and man; SwingPort, a work space outside of the storage area; RelayPort workstation; PickUpPort which provides in-store pickup options; FusionPort workstation; and FusionPort Staging. In addition, the company offers CubeControl, a software that executes and coordinates AutoStore daily operations; Router, a traffic optimization software within CubeControl; AutoStore Intelligence; CubeAnalytics; CubeVerse; AutoCase; FlexBins; and Qubit Fulfillment Platform. Further, it provides installation, maintenance, and training of personnel services. It serves grocery, retail, third party logistics, industrials, and healthcare industries. The company was formerly known as AutoStore NewCo Ltd. and changed its name to AutoStore Holdings Ltd. in October 2021. AutoStore Holdings Ltd. was founded in 1996 and is headquartered in Nedre Vats, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"USD"},"valuation":{"market_cap_yahoo":50727682048,"shares_outstanding":3348362015,"trailing_pe":31.5625,"forward_pe":25.077175,"price_to_book":3.2929208,"ev_to_ebitda":226.168,"ev_to_revenue":75.791,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":1.982},"targets":{"current_price":15.15,"mean":17.625124,"median":18.441624,"high":20.75973,"low":12.876288,"n_analysts":11,"reco_mean":2.0,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":0.01207,"eps_low":0.01,"eps_high":0.01322,"revenue_avg":173538530,"ex_dividend":null,"dividend_date":null},"holders":{"insiders_pct":0.00963,"institutions_pct":0.90879,"institutions_float_pct":0.91763,"institutions_n":127,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":6368,"value":96475,"date":"2026-06-30","chg":0.9919}],"funds":[{"name":"GLOBAL X FUNDS-Global X Robotics & Artificial Intelligence ETF","pct":0.0084,"shares":28714350,"value":435022391,"date":"2026-09-30","chg":0.0825},{"name":"Exch TRADED CONCEPTS TRT-ROBO Global Robotics and Automation Index ETF","pct":0.0047999998,"shares":16244906,"value":246110319,"date":"2026-09-30","chg":-0.2932},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0046,"shares":15537529,"value":235393558,"date":"2026-07-31","chg":-0.0083},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0031,"shares":10428426,"value":157990649,"date":"2026-06-30","chg":0.0183},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0025,"shares":8504927,"value":128849640,"date":"2026-08-31","chg":-0.0318},{"name":"First TRT Exch-Trd Fd. VI-First TRT Nasdaq Artificial Intelligence and","pct":0.0023,"shares":7726708,"value":117059623,"date":"2026-08-31","chg":0.0},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.0011999999,"shares":4111982,"value":62296525,"date":"2026-07-31","chg":0.027999999},{"name