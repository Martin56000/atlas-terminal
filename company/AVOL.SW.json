{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:37:17+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:37:17+00:00"},"data":{"profile":{"name":"Avolta AG","sector":"Consumer Cyclical","industry":"Specialty Retail","country":"Switzerland","city":"Basel","website":"https://www.avoltaworld.com","employees":69278,"summary":"Avolta AG operates as a travel retail company in Europe, the Middle East, Africa, North America, Latin America, and the Asia Pacific. It offers perfumes and cosmetics, food and beverages, wines and spirits, luxury goods, fuel, electronics, literature, publications, toys and souvenirs, soft drinks, packaged food, travel accessories, personal items, newspapers, magazines, books, watches and jewelry, sunglasses, destination, and other products; and confectionery and catering, textile, leather, luggage, and tobacco and related products. The company operates general travel retail shops under the Dufry, World Duty Free, Hellenic Duty Free, Autogrill, and HMSHost brands; and convenience stores under the Hudson brand. It operates duty-free and duty-paid shops, restaurants, and hybrid concepts located at airports, border, downtown and hotel shops, railway stations, cruise liners and ferries, seaports, and motorways. The company was formerly known as Dufry AG and changed its name to Avolta AG in November 2023. Avolta AG was incorporated in 1865 and is headquartered in Basel, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"Avolta AG est une entreprise de vente au détail de voyages en Europe, au Moyen-Orient, en Afrique, en Amérique du Nord, en Amérique latine et en Asie-Pacifique. Il propose des parfums et des cosmétiques, des aliments et des boissons, des vins et des spiritueux, des produits de luxe, du carburant, de l'électronique, de la littérature, des publications, des jouets et des souvenirs, des boissons gazeuses, des aliments emballés, des accessoires de voyage, des articles personnels, des journaux, des magazines, des livres, des montres et des bijoux, des lunettes de soleil, des produits de destination et d'autres produits; et des confiseries et de restauration. La société exploite des magasins de détail de voyages généraux sous les marques Dufry, World Duty Free, Hellenic Duty Free, Autogrill et HMSHost; et des dépanneurs sous la marque Hudson."},"valuation":{"market_cap_yahoo":6308457472,"shares_outstanding":141508681,"trailing_pe":30.958334,"forward_pe":11.147146,"price_to_book":3.8812468,"ev_to_ebitda":11.198,"ev_to_revenue":1.294,"dividend_yield":0.025799999,"payout_ratio":0.8099,"beta_yahoo":1.058},"targets":{"current_price":44.58,"mean":51.76471,"median":52.0,"high":60.0,"low":45.0,"n_analysts":17,"reco_mean":2.29412,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-07-30"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":3854500000,"ex_dividend":"2026-05-08","dividend_date":"2025-05-20"},"holders":{"insiders_pct":0.09020001,"institutions_pct":0.62575,"institutions_float_pct":0.68779,"institutions_n":247,"institutions":[{"name":"FCF Advisors LLC","pct":0.0001,"shares":12334,"value":549849,"date":"2024-12-31","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.01,"shares":1419246,"value":63269989,"date":"2026-07-31","chg":0.0379},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0064999997,"shares":924245,"value":41202843,"date":"2026-06-30","chg":0.0217},{"name":"Goldman Sachs TRT-Goldman Sachs Intl Small Cap Insights Fd.","pct":0.0055,"shares":785622,"value":35023030,"date":"2026-07-31","chg":1.1909},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0049,"shares":687518,"value":30649553,"date":"2026-08-31","chg":0.0053},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.003,"shares":431730,"value":19246524,"date":"2026-07-31","chg":0.0},{"name"