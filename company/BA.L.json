{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T15:53:44+00:00","status":"ok","error":null,"last_success":"2026-10-22T15:53:44+00:00"},"data":{"profile":{"name":"BAE Systems plc","sector":"Industrials","industry":"Aerospace & Defense","country":"United Kingdom","city":"London","website":"https://www.baesystems.com","employees":112400,"summary":"BAE Systems plc provides defense, aerospace, and security solutions in the United States, the United Kingdom, the Middle East, Australia, Kingdom of Saudi Arabia, Europe, and internationally. The company operates through five segments: Electronic Systems, Platforms & Services, Air, Maritime, and Cyber & Intelligence. The Electronic Systems segment offers electronic warfare systems, navigation systems, electro-optical sensors, military and commercial avionics, and precision guided solutions and communications systems, as well as space electronics, spacecraft, and ground and tactical systems. The Platforms & Services segment manufactures and sells combat vehicles, weapons, and munitions; and offers naval ship repair services, as well as operates and manages two government-owned and contractor-operated ammunition plants. The Air segment develops future combat air systems and falconworks alongside edgewing, and eurofighter and MBDA. The Maritime segment provides maritime and land services, including submarine, ship build, and support programs. The Cyber & Intelligence segment offers cyber security services for national security, central government, and government enterprises. The company was formerly known as British Aerospace plc and changed its name to BAE Systems plc in May 2000. BAE Systems plc was incorporated in 1979 and is headquartered in London, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"GBP","summary_fr":"BAE Systems plc fournit des solutions de défense, d'aérospatiale et de sécurité aux États-Unis, au Royaume-Uni, au Moyen-Orient, en Australie, au Royaume d'Arabie saoudite, en Europe et à l'international. La société opère à travers cinq segments: Systèmes électroniques, Plateformes et services, Air, Maritime et Cyber & Intelligence. Le segment Systèmes électroniques propose des systèmes de guerre électronique, des systèmes de navigation, des capteurs électro-optiques, des solutions avioniques militaires et commerciales, des solutions guidées de précision et des systèmes de communication, ainsi que des systèmes électroniques spatiaux, spatiaux et terrestres et tactiques."},"valuation":{"market_cap_yahoo":56478978048,"shares_outstanding":2925613794,"trailing_pe":27.578573,"forward_pe":20.162512,"price_to_book":466.86816,"ev_to_ebitda":16.781,"ev_to_revenue":2.144,"dividend_yield":0.0188,"payout_ratio":0.5201,"beta_yahoo":-0.044},"targets":{"current_price":1930.5,"mean":2314.1501,"median":2337.5,"high":2620.0,"low":1700.0,"n_analysts":20,"reco_mean":2.25,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-07-30"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-10-22","dividend_date":null},"holders":{"insiders_pct":0.00449,"institutions_pct":0.71748,"institutions_float_pct":0.72071,"institutions_n":576,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":68000,"value":131274000,"date":"2026-06-30","chg":0.0},{"name":"Front Row Advisors LLC","pct":0.0,"shares":400,"value":772200,"date":"2026-06-30","chg":1.0},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":43658,"value":84281769,"date":"2026-06-30","chg":-0.028199999},{"name":"Gamma Investing LLC","pct":0.0,"shares":4940,"value":9536670,"date":"2026-09-30","chg":0.0},{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0,"shares":50145,"value":96804922,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"Capital World Growth & Income Fund","pct":0.0201,"shares":60283295,"value":116376900997,"date":"2026-09-30","chg":0.0},{"name":"Income Fund of Ameri