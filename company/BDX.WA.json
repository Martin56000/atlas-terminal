{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:58:53+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:58:53+00:00"},"data":{"profile":{"name":"Budimex SA","sector":"Industrials","industry":"Engineering & Construction","country":"Poland","city":"Warsaw","website":"https://budimex.pl","employees":5513,"summary":"Budimex SA, together with its subsidiaries, operates as a construction company in Poland, Germany, Slovakia, Czechia, Latvia, rest of the European Union, and internationally. It operates through Construction Business and Service Activities segments. The company carries out road, bridge, and hydraulic engineering construction projects; general contracting of public buildings, as well as commercial, industrial, military, residential, and sports facilities; railroad projects with infrastructure facilities, such as platforms, stations, and overpasses, including railroad lines; and railroad construction comprising equipment and transportation services, as well as installation of railroad superstructure, turnouts, and welding services. It also constructs gas and steam units, gas transmission pipelines, and thermal waste conversion installations; installs water treatment stations and flue gas desulfurization or denitrification; and provides laboratory and technological facilities. In addition, the company offers waste management services, such as collecting and transporting waste, and managing waste processing facilities and landfills; road infrastructure maintenance and lighting infrastructure management; technical building maintenance, which include fit-out, landscaping, cleaning and maintenance of green areas, and administrative and security services; and renewable energy production services. Further, it develops electromobility infrastructure; recycles construction materials; and operates a network of electric vehicle charging stations. Additionally, the company is involved in the prefabrication, supply, and assembly of steel structures; and provision of mechanical assembly services for machinery and equipment for the cement and lime, power, metallurgical, and chemical industries. Budimex SA, was founded in 1968 and is headquartered in Warsaw, Poland. Budimex SA is a subsidiary of Ferrovial Construction International SE.","exchange":"Warsaw","currency":"PLN","financial_currency":"PLN"},"valuation":{"market_cap_yahoo":18294867968,"shares_outstanding":25530098,"trailing_pe":25.152685,"forward_pe":22.499214,"price_to_book":23.978584,"ev_to_ebitda":16.678,"ev_to_revenue":1.776,"dividend_yield":0.0454,"payout_ratio":1.1379,"beta_yahoo":0.586},"targets":{"current_price":716.6,"mean":735.08,"median":710.0,"high":853.0,"low":619.0,"n_analysts":6,"reco_mean":2.83333,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-27"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-02","dividend_date":null},"holders":{"insiders_pct":0.50143003,"institutions_pct":0.28419,"institutions_float_pct":0.57001,"institutions_n":157,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0073,"shares":186147,"value":133392935,"date":"2026-07-31","chg":0.0},{"name":"iShares, Inc.-iShares Core MSCI Emerging Markets ETF","pct":0.006,"shares":152444,"value":109241366,"date":"2026-08-31","chg":0.0091},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0049,"shares":125091,"value":89640207,"date":"2026-06-30","chg":0.012200001},{"name":"iShares Trust-iShares MSCI Poland ETF","pct":0.0028,"shares":71961,"value":51567250,"date":"2026-08-31","chg":0.1537},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Emerging Markets Core Eqy. 2 PORT.","pct":0.0026,"shares":66681,"value":47783602,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.0019,"shares":48125,"value":34486373,"date":"2026-07-3