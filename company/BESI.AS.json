{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T07:40:34+00:00","status":"ok","error":null,"last_success":"2026-10-29T07:40:34+00:00"},"data":{"profile":{"name":"BE Semiconductor Industries N.V.","sector":"Technology","industry":"Semiconductor Equipment & Materials","country":"Netherlands","city":"Duiven","website":"https://www.besi.com","employees":2001,"summary":"BE Semiconductor Industries N.V. develops, manufactures, markets, sells, and services semiconductor assembly equipment for the semiconductor and electronics industries in the Netherlands, Switzerland, Austria, Singapore, Malaysia, and internationally. It operates through three segments: Die Attach, Packaging, and Plating. The company offers single chip, multi chip, multi module, flip chip, epoxy and soft solder die bonding systems, hybrid, TCB and embedded bridge die bonding, die lid attach, and fan out wafer level packaging systems; and conventional, ultra-thin and wafer level molding, trim and form, and singulation systems. It also provides tin, copper, precious metal and solar plating systems, and related process chemicals; and tooling, conversion kits, spare parts, and other services. The company sells its products under the Fico, Meco, Datacon, and Esec brands. It serves multinational chip manufacturers, foundries, assembly subcontractors and electronics, and industrial companies. BE Semiconductor Industries N.V. was incorporated in 1995 and is headquartered in Duiven, the Netherlands.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"BE Semiconductor Industries N.V. développe, fabrique, commercialise, vend et fournit des équipements d'assemblage de semi-conducteurs pour les industries des semi-conducteurs et de l'électronique aux Pays-Bas, en Suisse, en Autriche, à Singapour, en Malaisie et à l'international. Il opère à travers trois segments : Die Attach, Packaging et Plating. La société propose des systèmes de soudage monopuce, multipuce, multimodule, flip chip, époxy et à soudure molle, des systèmes de soudage hybrides, TCB et intégrés, des systèmes d'emballage de niveau de plaquette; et des systèmes de moulage, d'assiette et de forme, et de singulation conventionnels, ultra-minces et de niveau de plaquette."},"valuation":{"market_cap_yahoo":12779780096,"shares_outstanding":79107273,"trailing_pe":44.50413,"forward_pe":24.802372,"price_to_book":19.713242,"ev_to_ebitda":34.568,"ev_to_revenue":14.488,"dividend_yield":0.0097,"payout_ratio":0.4353,"beta_yahoo":1.301},"targets":{"current_price":161.55,"mean":234.73914,"median":240.0,"high":340.0,"low":148.0,"n_analysts":23,"reco_mean":2.09091,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":1.29645,"eps_low":1.25895,"eps_high":1.32,"revenue_avg":282967560,"ex_dividend":"2026-04-27","dividend_date":null},"holders":{"insiders_pct":0.108909994,"institutions_pct":0.63560003,"institutions_float_pct":0.71329004,"institutions_n":538,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":714,"value":115346,"date":"2026-06-30","chg":-0.0775},{"name":"Stanley-Laman Group, Ltd.","pct":0.0,"shares":1163,"value":187882,"date":"2026-09-30","chg":0.22680001}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0128999995,"shares":1043090,"value":168511192,"date":"2026-07-31","chg":0.0094},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0085,"shares":690066,"value":111480164,"date":"2026-06-30","chg":0.0082},{"name":"Fidelity Contrafund","pct":0.007900001,"shares":640579,"value":103485539,"date":"2026-08-31","chg":-0.00029999999},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0067000003,"shares":540743,"value":87357033,"date":"2026-09-30","chg":0.013099999},{"name":"AMERICAN FUNDS INSURANCE SERIES-Eupac Fund","pct":0.0063,"shares":509268,"value":82272246,"date":"2026-09-30","chg":1.0},{"name":"Fidelity Investment