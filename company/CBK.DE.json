ers prêts."},"valuation":{"market_cap_yahoo":39202324480,"shares_outstanding":1080847095,"trailing_pe":13.896552,"forward_pe":9.229689,"price_to_book":1.1609744,"ev_to_ebitda":null,"ev_to_revenue":3.336,"dividend_yield":0.0295,"payout_ratio":0.42150003,"beta_yahoo":0.704},"targets":{"current_price":36.27,"mean":41.8,"median":42.0,"high":45.0,"low":31.6,"n_analysts":12,"reco_mean":2.53846,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":0.79461,"eps_low":0.73489,"eps_high":0.87128,"revenue_avg":3307649820,"ex_dividend":"2026-05-21","dividend_date":null},"holders":{"insiders_pct":0.44324002,"institutions_pct":0.2912,"institutions_float_pct":0.52301997,"institutions_n":465,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":8000,"value":290160,"date":"2026-06-30","chg":0.0434},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":10660,"value":386638,"date":"2026-06-30","chg":-0.0254}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0091,"shares":9550842,"value":346409043,"date":"2026-07-31","chg":-0.0307},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.006,"shares":6327009,"value":229480619,"date":"2026-06-30","chg":-0.029000001},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0043,"shares":4499178,"value":163185188,"date":"2026-08-31","chg":-0.084},{"name":"DFA INVESTMENT TRUST CO-The DFA International Value Series","pct":0.0023999999,"shares":2497525,"value":90585232,"date":"2026-07-31","chg":0.0},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.0023999999,"shares":2540301,"value":92136718,"date":"2026-08-31","chg":0.0083},{"name":"iShares Trust-iShares MSCI EAFE ETF","pct":0.002,"shares":2109477,"value":76510731,"date":"2026-08-31","chg":-0.0764},{"name":"Dimensional ETF Trust-Dimensional International Value ETF","pct":0.0015,"shares":1624422,"value":58917786,"date":"2026-07-31","chg":0.05269