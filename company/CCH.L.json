{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:39:29+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:39:29+00:00"},"data":{"profile":{"name":"Coca-Cola HBC AG","sector":"Consumer Defensive","industry":"Beverages - Non-Alcoholic","country":"Switzerland","city":"Steinhausen","website":"https://www.coca-colahellenic.com","employees":33500,"summary":"Coca-Cola HBC AG engages in the production, sale, and distribution of non-alcoholic ready-to-drink beverages under franchise in Switzerland, West Coast of Ireland, Central and Eastern Europe, Nigeria, and internationally. It offers sparkling soft drinks, adult sparkling, hydration drinks, juices, ready-to-drink tea and coffee, sports and energy drinks, plant-based drinks, hard seltzers, premium spirit, dairy, and snacks; and distributes third-party products. The company markets and sells its products under several brands, including Coca-Cola, Fanta, Sprite, Adez, Averna, Amita, Aquarius, Aperol, Avra, Deep RiverRock, Fruice, Kinley, Schweppes, and various other brands. It serves various consumer channels, such as supermarkets, convenience stores, vending machines, hotels, cafés, and restaurants, as well as e-commerce channels. Coca-Cola HBC AG was incorporated in 1969 and is headquartered in Steinhausen, Switzerland.","exchange":"LSE","currency":"GBp","financial_currency":"EUR","summary_fr":"Coca-Cola HBC AG se consacre à la production, à la vente et à la distribution de boissons prêtes à boire non alcoolisées en franchise en Suisse, sur la côte ouest de l'Irlande, en Europe centrale et orientale, au Nigéria et à l'étranger. Il propose des boissons gazeuses gazeuses, des boissons gazeuses pour adultes, des boissons d'hydratation, des jus de fruits, du thé et du café prêts à boire, des boissons sportives et énergisantes, des boissons à base de plantes, des seltzers durs, des spiritueux haut de gamme, des produits laitiers et des collations; et distribue des produits tiers. La société commercialise et vend ses produits sous plusieurs marques, notamment Coca-Cola, Fanta, Sprite, Adez, Averna, Amita, Aquarius, Aperol, Avra, Deep RiverRock, Fruice, Kinley, Schweppes et diverses autres marques."},"valuation":{"market_cap_yahoo":16881997824,"shares_outstanding":364464550,"trailing_pe":19.544304,"forward_pe":17.105602,"price_to_book":490.85367,"ev_to_ebitda":10.23,"ev_to_revenue":1.506,"dividend_yield":0.0222,"payout_ratio":0.4396,"beta_yahoo":0.523},"targets":{"current_price":4632.0,"mean":5038.9033,"median":5252.427,"high":5585.382,"low":3787.7507,"n_analysts":15,"reco_mean":2.2,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-08-05"],"eps_avg":0.73788,"eps_low":0.73788,"eps_high":0.73788,"revenue_avg":3455550000,"ex_dividend":"2026-05-14","dividend_date":null},"holders":{"insiders_pct":0.46408,"institutions_pct":0.30442,"institutions_float_pct":0.56803,"institutions_n":393,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0001,"shares":25900,"value":119968800,"date":"2026-06-30","chg":0.0},{"name":"Meyer Handelman Co","pct":0.0,"shares":4184,"value":19380288,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"ADVISORS' INNER CIRCLE III-GQG PARTNERS EMERGING MARKETS EQUITY FUND","pct":0.0112,"shares":4169916,"value":19315050912,"date":"2026-06-30","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0078,"shares":2901433,"value":13439437656,"date":"2026-07-31","chg":-0.0086},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0050999997,"shares":1910534,"value":8849593488,"date":"2026-06-30","chg":-0.0117},{"name":"Capital World Growth & Income Fund","pct":0.0047999998,"shares":1787902,"value":8281562064,"date":"2026-09-30","chg":8.6334},{"name":"Fidelity Puritan Trust-Fidelity Low-Priced Stock Fund","pct":0.0047,"shares":1742997,"value":8073562104,"date":"2026-07-31","chg":0.0},{"name":"Fidelity Investment T