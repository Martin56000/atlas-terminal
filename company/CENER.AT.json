{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:59:51+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:59:51+00:00"},"data":{"profile":{"name":"Cenergy Holdings SA","sector":"Industrials","industry":"Electrical Equipment & Parts","country":"Belgium","city":"Brussels","website":"https://cenergyholdings.com","employees":4192,"summary":"Cenergy Holdings SA manufactures and sells aluminium, copper, cables, steel and steel pipes, and other related products in Belgium, Greece, Germany, Romania, Other European Union countries, Other European countries, the United States, Asia, Africa, and internationally. It operates through two segments: Cables and Steel Pipes. The company offers submarine and land power, power distribution, high-voltage direct current, wind farm, submarine cables for offshore wind farms, industrial, network, telecommunication, data transmission, railway signalling, gauging and control, umbilicals, and optical fiber cables, as well as low, medium, high, and extra high voltage power cables; and fiber to the home cables. It also provides turnkey solutions, such as installation, repair and replacement, original equipment manufacturer, custom-adapted application, supervision, technical support, transport and storage, customer instruction and training, and spare parts for the maintenance of installed energy and telecommunications systems. In addition, the company offers onshore and offshore pipelines for transportation of oil, gas, and hydrogen, as well as carbon capture and storage applications and casing pipes; and hollow structural section products which are primarily used in the construction, power and telecom cables, wires, and raw materials. Further, it serves power grids, interconnections, offshore and onshore wind, solar energy, telecommunications and data transmission cables, oil and gas, and heavy industries. Cenergy Holdings SA was founded in 1949 and is based in Brussels, Belgium. Cenergy Holdings SA operates as a subsidiary of Viohalco S.A.","exchange":"Athens","currency":"EUR","financial_currency":"EUR"},"valuation":{"market_cap_yahoo":4726773248,"shares_outstanding":212343810,"trailing_pe":20.054054,"forward_pe":null,"price_to_book":4.9621043,"ev_to_ebitda":13.036,"ev_to_revenue":2.295,"dividend_yield":0.012,"payout_ratio":0.2338,"beta_yahoo":1.024},"targets":{"current_price":22.26,"mean":null,"median":null,"high":null,"low":null,"n_analysts":null,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-22","dividend_date":null},"holders":{"insiders_pct":0.69712996,"institutions_pct":0.13958,"institutions_float_pct":0.46085,"institutions_n":81,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":2377766670,"rev_low":2293000000,"rev_high":2431200000,"rev_year_ago":2060722000,"rev_n":3,"rev_growth":0.1539,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1y","end_date":"2027-12-31","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":2665800000,"rev_low":2624900000,"rev_high":2740500000,"rev_year_ago":2377766670,"rev_n":3,"rev_growth":0.12109999,"eps_tr