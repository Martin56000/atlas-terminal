{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T15:56:55+00:00","status":"ok","error":null,"last_success":"2026-10-23T15:56:55+00:00"},"data":{"profile":{"name":"Cancom SE","sector":"Technology","industry":"Information Technology Services","country":"Germany","city":"Munich","website":"https://www.cancom.de","employees":5216,"summary":"Cancom SE, together with its subsidiaries, provides information technology services in Germany and internationally. The company offers supply services comprising software asset management, eProcurement, financial services, software licensing services, client lifecycle services, service factory, and IT remarketing; managed services, such as managed applications, IT-outsourcing, out-tasking, and CANCOM datacenters; professional services, including analysis and evaluation, planning and strategy, and realization and transformation; and support services, including onsite, rapid response, and repair services. It serves energy and utilities, insurances, carrier and service provider, retail, manufacturing, federal and state administration, municipality, church and welfare, healthcare, education, and transport and logistics sectors. Cancom SE was founded in 1992 and is headquartered in Munich, Germany.","exchange":"XETRA","currency":"EUR","financial_currency":"EUR","summary_fr":"Cancom SE, avec ses filiales, fournit des services informatiques en Allemagne et à l'international. La société offre des services d'approvisionnement comprenant la gestion des actifs logiciels, l'approvisionnement électronique, les services financiers, les services de licences de logiciels, les services de cycle de vie des clients, l'usine de services et le remarketing informatique; des services gérés, tels que les applications gérées, l'externalisation informatique, les tâches externes et les centres de données CANCOM; des services professionnels, y compris l'analyse et l'évaluation, la planification et la stratégie, et la réalisation et la transformation; et des services de soutien. Il dessert les secteurs de l'énergie et des services publics, des assurances, des transporteurs et des fournisseurs de services, de la vente au détail, de la fabrication, de l'administration fédérale et de l'État, des municipalités, de l'église et du bien-être, de la santé, de l'éducation et des transports et de la logistique."},"valuation":{"market_cap_yahoo":638021440,"shares_outstanding":28739703,"trailing_pe":18.347107,"forward_pe":15.283572,"price_to_book":1.3153996,"ev_to_ebitda":16.318,"ev_to_revenue":0.501,"dividend_yield":0.0429,"payout_ratio":0.8264,"beta_yahoo":1.007},"targets":{"current_price":22.2,"mean":26.4375,"median":25.75,"high":32.0,"low":23.0,"n_analysts":8,"reco_mean":2.0,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-12"],"eps_avg":0.24965,"eps_low":0.24965,"eps_high":0.24965,"revenue_avg":414166380,"ex_dividend":"2026-06-18","dividend_date":null},"holders":{"insiders_pct":0.10264,"institutions_pct":0.50175,"institutions_float_pct":0.55914,"institutions_n":86,"institutions":[{"name":"Legato Capital Management LLC","pct":0.0018000001,"shares":70630,"value":1567986,"date":"2022-09-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0124,"shares":356228,"value":7908261,"date":"2026-07-31","chg":0.0},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0087,"shares":250269,"value":5555971,"date":"2026-08-31","chg":0.0054},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0082,"shares":236592,"value":5252342,"date":"2026-06-30","chg":0.0},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.0054,"shares":155928,"value":3461601,"date":"2026-07-31","chg":0.0},{"name":"Dimensional ETF Trust-Dimensional International Small Cap Value ETF","pct":0.0047999998,"shares":137860,"value":3060492,"date":"2026-07-31","chg":0.099},{"name":"College Retir