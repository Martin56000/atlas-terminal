{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:38:57+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:38:57+00:00"},"data":{"profile":{"name":"Colt CZ Group SE","sector":"Industrials","industry":"Aerospace & Defense","country":"Czech Republic","city":"Prague","website":"https://www.coltczgroup.com","employees":4535,"summary":"Colt CZ Group SE, together with its subsidiaries, engages in the production and sale of firearms, ammunition products, and tactical accessories in the Czech Republic, Canada, the United States, rest of Europe, Africa, Asia, and internationally. Its firearms include pistols, revolvers, rimfire rifles, centerfire rifles, select fire rifles, sub guns, grenade launchers, and sniper rifles; and components for firearms. The company offers tactical and ballistic equipment, such as ballistic vests, helmets and other protection products, combat uniforms, and backpacks, as well as firearms accessories consisting of handgun holsters, and magazine pouches; and optical mounts, accessories and upgrade kits for firearms. It markets and sells its products under the Colt, CZ (Ceská zbrojovka), CZ-USA, Colt Canada, Dan Wesson, Sellier & Bellot, Spuhr i Dalby, swissAA, Colt Optics, and 4M Systems brands. The company was formerly known as CZG - Ceská zbrojovka Group SE and changed its name to Colt CZ Group SE in April 2022. Colt CZ Group SE was founded in 1936 and is headquartered in Prague, the Czech Republic. The company operates as a subsidiary of Ceska Zbrojovka Partners SE.","exchange":"Prague","currency":"CZK","financial_currency":"CZK"},"valuation":{"market_cap_yahoo":52991107072,"shares_outstanding":62637242,"trailing_pe":22.864864,"forward_pe":null,"price_to_book":3.2409942,"ev_to_ebitda":11.996,"ev_to_revenue":2.653,"dividend_yield":0.0355,"payout_ratio":0.8108,"beta_yahoo":0.308},"targets":{"current_price":846.0,"mean":1095.8334,"median":1015.5,"high":1445.0,"low":893.0