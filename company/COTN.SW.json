{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:38:20+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:38:20+00:00"},"data":{"profile":{"name":"Comet Holding AG","sector":"Technology","industry":"Scientific & Technical Instruments","country":"Switzerland","city":"Flamatt","website":"https://comet.tech","employees":1557,"summary":"Comet Holding AG, together with its subsidiaries, provides X-ray and radio frequency (RF) power technology solutions in Europe, North America, Asia, and internationally. It operates through three divisions: Plasma Control Technologies, X-Ray Systems, and Industrial X-Ray Modules. The Plasma Control Technologies division develops, manufactures, and markets vacuum capacitors, RF generators, and RF impedance matching networks for the high-precision control of plasma processes required in the production of memory chips and flat panel displays. The X-Ray Systems division develops, manufactures, and markets compact x-ray and provides related services, for non destructive examination using x-ray computed tomography. The Industrial X-Ray Modules division develops, manufactures, and markets compact X-ray sources and portable X-ray modules for non-destructive examination, steel metrology, and security inspection. The company offers its products under the Comet and Comet Yxlon brands. The company serves manufacturers in the semiconductor, aerospace, automotive, and security sectors. Comet Holding AG was founded in 1948 and is headquartered in Flamatt, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"Comet Holding AG, en collaboration avec ses filiales, fournit des solutions de technologie d'alimentation par rayons X et radiofréquences (RF) en Europe, en Amérique du Nord, en Asie et à l'international. Elle opère à travers trois divisions : Plasma Control Technologies, X-Ray Systems et Industrial X-Ray Modules. La division Plasma Control Technologies développe, fabrique et commercialise des condensateurs à vide, des générateurs RF et des réseaux d'adaptation d'impédance RF pour le contrôle de haute précision des processus plasma nécessaires à la production de puces mémoire et d'écrans plats."},"valuation":{"market_cap_yahoo":2876704000,"shares_outstanding":7770675,"trailing_pe":163.80531,"forward_pe":20.35727,"price_to_book":9.003794,"ev_to_ebitda":61.218,"ev_to_revenue":6.181,"dividend_yield":0.0014,"payout_ratio":0.25,"beta_yahoo":1.718},"targets":{"current_price":370.2,"mean":527.8,"median":543.0,"high":640.0,"low":334.0,"n_analysts":10,"reco_mean":1.5,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-07-31"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-04-16","dividend_date":"2025-04-16"},"holders":{"insiders_pct":0.00226,"institutions_pct":0.54046,"institutions_float_pct":0.54168,"institutions_n":173,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":9.31997,"eps_low":8.02,"eps_high":10.97,"eps_year_ago":1.57,"eps_n":10,"eps_growth":4.9363003,"rev_avg":585832450,"rev_low":581000000,"rev_high":597102850,"rev_year_ago":457044000,"rev_n":10,"rev_growth":0.2818,"eps_trend_now":9.31997,"eps_trend_30d":8.13079,"eps_trend_90d":6.92331},{"period":"+1y","end_date":"2027-12-31","eps_avg":18.18515,"eps_low":16.19,"eps_high":19.5187,"eps_year_