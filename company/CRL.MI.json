{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:56:04+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:56:04+00:00"},"data":{"profile":{"name":"Carel Industries S.p.A.","sector":"Technology","industry":"Electronic Components","country":"Italy","city":"Brugine","website":"https://www.carel.com","employees":2778,"summary":"Carel Industries S.p.A., together with its subsidiaries, designs, manufactures, markets, and distributes control and humidification solutions in Europe, the Middle East, Africa, North America, South America, and the Asia Pacific. The company offers programmable controls; terminals; specialized controls for heating, ventilation, and air-conditioning (HVAC); specialized controls for food retail and refrigeration; steam and adiabatic humidifiers; Reverse osmosis water treatment systems; IoT digital services; remote management, supervision, and monitoring systems; connectivity products; sensors and protection devices; electronic expansion valves; temperature, humidity, and pressure controls; speed controllers and inverters for electric motors; electrical panels and power solutions; and obsolete products for system solutions and unit control applications. It also provides technical support, field, digital, and repair services, as well as spare parts. The company serves residential, industrial, and commercial segments in the HVAC market, as well as food retail and food service segments of the refrigeration market. The company was founded in 1973 and is headquartered in Brugine, Italy.","exchange":"Milan","currency":"EUR","financial_currency":"EUR","summary_fr":"Carel Industries S.p.A., avec ses filiales, conçoit, fabrique, commercialise et distribue des solutions de contrôle et d'humidification en Europe, au Moyen-Orient, en Afrique, en Amérique du Nord, en Amérique du Sud et en Asie-Pacifique. La société propose des contrôles programmables; terminaux; contrôles spécialisés pour le chauffage, la ventilation et la climatisation (CVC); contrôles spécialisés pour la vente au détail et la réfrigération alimentaire; humidificateurs à vapeur et adiabatiques; systèmes de traitement de l'eau par osmose inverse; services numériques IoT; systèmes de gestion, de supervision et de surveillance à distance; produits de connectivité; capteurs et dispositifs de protection; vannes de détente électroniques; contrôles de température, d'humidité et de pression; contrôleurs de vitesse et onduleurs pour moteurs électriques; Il fournit également un support technique, des services sur le terrain, numériques et de réparation, ainsi que des pièces de rechange."},"valuation":{"market_cap_yahoo":3149799680,"shares_outstanding":112492850,"trailing_pe":33.333336,"forward_pe":30.222242,"price_to_book":6.213937,"ev_to_ebitda":23.29,"ev_to_revenue":4.47,"dividend_yield":0.0072000003,"payout_ratio":0.2378,"beta_yahoo":0.976},"targets":{"current_price":28.0,"mean":34.28571,"median":35.7,"high":37.0,"low":30.0,"n_analysts":7,"reco_mean":1.57143,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-12"],"eps_avg":0.21,"eps_low":0.21,"eps_high":0.21,"revenue_avg":192432000,"ex_dividend":"2026-06-22","dividend_date":null},"holders":{"insiders_pct":0.59305,"institutions_pct":0.26396,"institutions_float_pct":0.64864,"institutions_n":122,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":0.21,"eps_low":0.21,"eps_high":0.21,"eps_year_ago":0.14,"eps_n":1,"eps_growth":0.5,"rev_avg":192432000,"rev_low":190000000,"rev_high":194864000,"rev_year_ago":157500000,"rev_n":2,"rev_growth":0.2218,"eps_trend_now":0.21,"eps_trend_30d":0.21,"eps_trend_90d":0.18},{"period":"+1q","end_date":"2026-12-31","eps_avg":0.2,"eps_low":0.2,"eps_high":0.2,"eps_year_ago":0.27,"eps_n":1,"eps_growth":-0.2593,"rev_avg":196538500,"rev_low":190000000,"rev_high":203077000,"rev_year_ago":165334000,"rev_n":2,"rev_growth":0.1887,"eps_trend_now":0.2,"