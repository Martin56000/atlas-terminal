{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:51:30+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:51:30+00:00"},"data":{"profile":{"name":"DSM-Firmenich AG","sector":"Basic Materials","industry":"Specialty Chemicals","country":"Switzerland","city":"Kaiseraugst","website":"https://www.dsm-firmenich.com","employees":20786,"summary":"DSM-Firmenich AG provides nutrition, health, and beauty solutions in Switzerland, the Netherlands, rest of Europe, the Middle East and Africa, North America, Latin America, China, and rest of Asia. The company operates through Perfumery & Beauty; Taste, Texture & Health; and Health, Nutrition & Care segments. The Perfumery & Beauty creates scents using natural, synthetic, and biotech ingredients. The Taste, Texture & Health segment provides food and beverages solutions, including flavors, natural extracts, and sugar reduction; and food enzymes, hydrocolloids, cultures, natural colorants, nutritional ingredients, and plant-based proteins. The Health, Nutrition & Care segment provides solutions for the early life nutrition, dietary supplement, pharmaceutical, medical nutrition, biomedical materials, and nutrition improvement markets. This segment also offers vitamins, nutritional lipids, minerals, carotenoids, botanical nutraceuticals, digestive enzymes, postbiotics, probiotics and prebiotics, and active pharmaceutical ingredients; biomedical solutions; and premix, market-ready, and personalized nutrition solutions, as well as expert services in regulatory affairs and nutrition. DSM-Firmenich AG was founded in 1902 and is based in Kaiseraugst, Switzerland.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"DSM-Firmenich AG fournit des solutions de nutrition, de santé et de beauté en Suisse, aux Pays-Bas, dans le reste de l'Europe, au Moyen-Orient et en Afrique, en Amérique du Nord, en Amérique latine, en Chine et dans le reste de l'Asie. La société opère à travers les segments Parfumerie & Beauté; Goût, Texture & Santé; et Santé, Nutrition & Soins. La Parfumerie & Beauté crée des parfums à l’aide d’ingrédients naturels, synthétiques et biotechnologiques."},"valuation":{"market_cap_yahoo":25841201152,"shares_outstanding":244361250,"trailing_pe":null,"forward_pe":25.552244,"price_to_book":1.484273,"ev_to_ebitda":24.324,"ev_to_revenue":3.519,"dividend_yield":0.023,"payout_ratio":2.0661001,"beta_yahoo":0.533},"targets":{"current_price":105.75,"mean":96.47,"median":98.5,"high":117.0,"low":68.0,"n_analysts":20,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":["2026-07-30"],"eps_avg":0.96681,"eps_low":0.96681,"eps_high":0.96681,"revenue_avg":2373000000,"ex_dividend":"2026-05-11","dividend_date":null},"holders":{"insiders_pct":0.09486,"institutions_pct":0.53383,"institutions_float_pct":0.58977,"institutions_n":417,"institutions":[{"name":"Aristotle Capital Management, LLC","pct":0.0017,"shares":419450,"value":44356837,"date":"2026-06-30","chg":-0.0748},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":856,"value":90522,"date":"2026-06-30","chg":-0.9931}],"funds":[{"name":"Artisan Partners Funds Inc.-Artisan International Value Fund","pct":0.0665,"shares":16878444,"value":1784895453,"date":"2026-06-30","chg":0.0467},{"name":"Dodge & Cox Funds-Dodge & Cox International Stock Fund","pct":0.019299999,"shares":4901906,"value":518376559,"date":"2026-06-30","chg":2.6023998},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0107,"shares":2723718,"value":288033178,"date":"2026-07-31","chg":0.023599999},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0070999996,"shares":1805906,"value":190974559,"date":"2026-06-30","chg":0.0251},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0049,"shares":1245117,"value":131671122,"date":"2026-09-30","chg":0.0139999995},{"name":"Dodge & Cox Funds-Dodge & Cox Global Stock Fu