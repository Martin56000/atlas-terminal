{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:54:19+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:54:19+00:00"},"data":{"profile":{"name":"Elekta AB (publ)","sector":"Healthcare","industry":"Medical Devices","country":"Sweden","city":"Stockholm","website":"https://www.elekta.com","employees":3996,"summary":"Elekta AB (publ), a medical technology company, provides clinical solutions for treating cancer and brain disorders in the Americas, Europe, the Middle East, Africa, and the Asia Pacific. The company offers linear machines and radiation therapy products comprising Elekta Unity for anatomy-specific MR imaging; Elekta Evo, a CT-Linac solution; Elekta Versa HD, a brain metastases solution; Elekta Harmony; and Elekta Infinity for treating a range of patients with simple-to-complex radiotherapy needs, as well as quality assurance, and treatment and motion management solutions. It also provides stereotactic radiosurgery products, such as Elekta Esprit, a gamma knife system; and Elekta Care, a personalized services for radiotherapy suites. In addition, the company offers brachytherapy products, including Elekta Studio, an image-guided brachytherapy solution; ImagingRing for dynamic imaging; Oncentra Brachy, a smart tool that facilitates repetitive tasks; Venezia applicator that enables the oncologist to treat locally advanced cervical cancer; Elekta Flexitron afterloader for enabling the precise execution of all steps in the workflow; Elekta Geneva, an applicator for cervical cancer patients; and Elekta Xoft Axxent electronic brachytherapy systems. Further, it provides Leksell Vantage Stereotactic System, a neurosurgery product; Elekta Kaiku for personalized cancer care; and veterinary radiation therapy solutions. Additionally, the company offers Elekta Care 360, which provides a range of clinical and professional services; Elekta Care Learning; Elekta Care Community, a self-help center; and Elekta Partner Community, an online self-service portal. Elekta AB (publ) was incorporated in 1972 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK"},"valuation":{"market_cap_yahoo":21358448640,"shares_outstanding":367102351,"trailing_pe":null,"forward_pe":11.525774,"price_to_book":2.9348452,"ev_to_ebitda":14.491,"ev_to_revenue":1.609,"dividend_yield":0.043,"payout_ratio":3.1579,"beta_yahoo":0.959},"targets":{"current_price":55.9,"mean":57.71333,"median":52.0,"high":90.0,"low":41.0,"n_analysts":15,"reco_mean":3.13333,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-25"],"eps_avg":0.75443,"eps_low":0.57397,"eps_high":0.94587,"revenue_avg":4126524790,"ex_dividend":"2027-03-04","dividend_date":null},"holders":{"insiders_pct":0.02232,"institutions_pct":0.69374,"institutions_float_pct":0.70957,"institutions_n":122,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0137,"shares":5041630,"value":281827124,"date":"2026-07-31","chg":0.0},{"name":"Exch TRADED CONCEPTS TRT-ROBO Global Robotics and Automation Index ETF","pct":0.0101,"shares":3733211,"value":208686500,"date":"2026-09-30","chg":0.0022},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0092,"shares":3392934,"value":189665015,"date":"2026-06-30","chg":0.0043},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0075,"shares":2752427,"value":153860673,"date":"2026-08-31","chg":0.0052},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.004,"shares":1473634,"value":82376142,"date":"2026-07-31","chg":0.3841},{"name":"Principal Funds, Inc-Overseas Fund","pct":0.0039,"shares":1439198,"value":80451170,"date":"2026-07-31","chg":-0.0691},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.0036000002,"shares":1329142,"value":74299039,"date":"2026-07-31","chg":0.0318},{"name":"iShares T