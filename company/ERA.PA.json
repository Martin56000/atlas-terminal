{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:44:13+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:44:13+00:00"},"data":{"profile":{"name":"ERAMET S.A.","sector":"Basic Materials","industry":"Other Industrial Metals & Mining","country":"France","city":"Paris","website":"https://www.eramet.com","employees":8561,"summary":"ERAMET S.A. produces and sells manganese and nickel metals in Asia, Europe, North America, and internationally. It extracts and processes manganese and nickel ores; extracts and develops mineral sands; and mines and processes lithium deposits. The company also offers manganese alloys, including silicomanganese, low-carbon silicomanganese, and manganese dioxide, as well as medium, low, and high carbon ferromanganese; manganese ores; ferronickel, nickel pig iron, briquettes, nickel salts, nickel ferroalloys, ferronickel slag, and other nickel products; and mineral sands, ilmenite, rutile, and leucoxene, such as zircon and titanium dioxide, and abrasives. In addition, it operates Moanda mine in Gabon; nickel mines in New Caledonia and Indonesia; and mineral sand mine in Senegal. The company was incorporated in 1880 and is headquartered in Paris, France.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"ERAMET S.A. produit et vend des métaux de manganèse et de nickel en Asie, en Europe, en Amérique du Nord et à l’international. Il extrait et traite les minerais de manganèse et de nickel; extrait et développe des sables minéraux; et extrait et traite les dépôts de lithium. La société propose également des alliages de manganèse, y compris le silicomanganèse, le silicomanganèse à faible teneur en carbone et le dioxyde de manganèse, ainsi que le ferroalliage de nickel, le laitier de ferronickel et d'autres produits de nickel; minerais de manganèse; ferronickel, fonte de nickel, briquettes, sels de nickel, ferroalliages de nickel, scorie de ferronickel et autres produits de nickel; sables minéraux, ilménite, rutile et leuc."},"valuation":{"market_cap_yahoo":1048361472,"shares_outstanding":28659415,"trailing_pe":null,"forward_pe":18.079466,"price_to_book":2.3751705,"ev_to_ebitda":20.526,"ev_to_revenue":1.304,"dividend_yield":0.0,"payout_ratio":3.0,"beta_yahoo":0.947},"targets":{"current_price":36.58,"mean":50.66667,"median":51.5,"high":56.0,"low":43.0,"n_analysts":6,"reco_mean":3.16667,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-07-29"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2025-06-02","dividend_date":null},"holders":{"insiders_pct":0.69795,"institutions_pct":0.15293,"institutions_float_pct":0.50631,"institutions_n":69,"institutions":[],"funds":[{"name":"ADVISORS' INNER CIRCLE FUND II-Kopernik Global All-Cap Fund","pct":0.0214,"shares":615727,"value":22523294,"date":"2026-07-31","chg":0.0},{"name":"VanEck ETF Trust-VanEck Rare Earth and Strategic Metals ETF","pct":0.016,"shares":459846,"value":16821167,"date":"2026-09-30","chg":-0.051599998},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0043,"shares":123312,"value":4510753,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0029,"shares":82005,"value":2999743,"date":"2026-06-30","chg":0.0368},{"name":"GLOBAL X FUNDS-Global X Autonomous & Electric Vehicles ETF","pct":0.0029,"shares":81983,"value":2998938,"date":"2026-09-30","chg":0.0084},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0022,"shares":64564,"value":2361751,"date":"2026-08-31","chg":0.0054},{"name":"GLOBAL X FUNDS-Global X Lithium & Battery Tech ETF","pct":0.0014,"shares":40931,"value":1497256,"date":"2026-09-30","chg":-0.021300001},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.0013,"shares":36060,"value":1319074,"date":"2026-07-31","chg":0.1173},{"name":"iShares Trust-iShares MSCI EAFE Smal