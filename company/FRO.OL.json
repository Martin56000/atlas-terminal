{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:54:50+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:54:50+00:00"},"data":{"profile":{"name":"Frontline plc","sector":"Energy","industry":"Oil & Gas Midstream","country":"Cyprus","city":"Limassol","website":"https://www.frontlineplc.cy","employees":85,"summary":"Frontline plc, a shipping company, engages in the ownership and operation of oil and product tankers worldwide. The company owns and operates oil and product tankers, such as very large crude carriers (VLCCs), Suezmax tankers, and LR2/Aframax tankers. As of December 31, 2025, it operated a fleet of 80 vessels, including 41 VLCCs, 21 Suezmax tankers, and 18 LR2/Aframax tankers. The company is also involved in the charter, purchase, and sale of vessels. Frontline plc was founded in 1985 and is based in Limassol, Cyprus.","exchange":"Oslo","currency":"NOK","financial_currency":"USD","summary_fr":"Frontline plc, une société de transport maritime, s'occupe de la propriété et de l'exploitation de pétroliers et de camions-citernes dans le monde entier. La société possède et exploite des pétroliers et des camions-citernes, tels que les très gros transporteurs de brut (VLCC), les pétroliers Suezmax et les pétroliers LR2/Aframax. Au 31 décembre 2025, elle exploitait une flotte de 80 navires, dont 41 VLCC, 21 pétroliers Suezmax et 18 pétroliers LR2/Aframax.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":null,"shares_outstanding":null,"trailing_pe":7.847138,"forward_pe":8.672108,"price_to_book":3.882428,"ev_to_ebitda":69.907,"ev_to_revenue":42.437,"dividend_yield":0.1958,"payout_ratio":0.4693,"beta_yahoo":0.179},"targets":{"current_price":515.4,"mean":418.0977,"median":426.00882,"high":458.5458,"low":360.51816,"n_analysts":5,"reco_mean":3.0,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-30"],"eps_avg":2.585,"eps_low":2.28,"eps_high":2.89,"revenue_avg":716749590,"ex