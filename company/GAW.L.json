{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:42:19+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:42:19+00:00"},"data":{"profile":{"name":"Games Workshop Group PLC","sector":"Consumer Cyclical","industry":"Leisure","country":"United Kingdom","city":"Nottingham","website":"https://investor.games-workshop.com","employees":3321,"summary":"Games Workshop Group PLC, together with its subsidiaries, engages in the design, manufacture, distribution, and sale of fantasy miniature figures and games in the United Kingdom, Continental Europe, North America, Australia, New Zealand, Asia, and internationally. The company operates in two segments, Core and Licensing. It offers games under the Warhammer 40,000; Warhammer: The Horus Heresy; Warhammer: The Old World; Warhammer: Age of Sigmar; and Necromunda and Blood Bowl brand names, as well as has a licensed property for the Lord of the Rings. The company also publishes short stories, audio dramas, full length novels, and audio books under the Black Library name. In addition, it engages in the magazine newsstand business; and grants licences to third parties for the development of video games, PC games, media, and other products. The company sells its products through its own retail stores, third party independent retailers, and online stores. The company was incorporated in 1991 and is headquartered in Nottingham, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"GBP","summary_fr":"Games Workshop Group PLC, avec ses filiales, s'engage dans la conception, la fabrication, la distribution et la vente de figurines et de jeux fantastiques au Royaume-Uni, en Europe continentale, en Amérique du Nord, en Australie, en Nouvelle-Zélande, en Asie et à l'international. La société opère en deux segments, Core et Licensing. Il propose des jeux sous les marques Warhammer 40,000; Warhammer: The Horus Heresy; Warhammer: The Old World; Warhammer: Age of Sigmar; et Necromunda et Blood Bowl, ainsi qu'une propriété sous licence pour le Seigneur des Anneaux."},"valuation":{"market_cap_yahoo":5601190400,"shares_outstanding":33045370,"trailing_pe":27.207062,"forward_pe":25.948181,"price_to_book":1670.4445,"ev_to_ebitda":18.728,"ev_to_revenue":8.298,"dividend_yield":0.023,"payout_ratio":0.77910006,"beta_yahoo":0.876},"targets":{"current_price":16950.0,"mean":22075.0,"median":22075.0,"high":22150.0,"low":22000.0,"n_analysts":2,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-10-22","dividend_date":null},"holders":{"insiders_pct":0.00447,"institutions_pct":0.69321,"institutions_float_pct":0.69632006,"institutions_n":291,"institutions":[{"name":"O'Brien Greene & Co. Inc","pct":0.0,"shares":1061,"value":17983950,"date":"2026-06-30","chg":1.0}],"funds":[{"name":"SmallCap World Fund Inc","pct":0.0299,"shares":987707,"value":16741633650,"date":"2026-06-30","chg":-0.18540001},{"name":"Fidelity Investment Trust-Fidelity Series International Growth Fund","pct":0.0161,"shares":531600,"value":9010620000,"date":"2026-08-31","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0148,"shares":487953,"value":8270803350,"date":"2026-07-31","chg":0.0099},{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Intl Fd.","pct":0.0134000005,"shares":441720,"value":7487154000,"date":"2026-08-31","chg":0.0929},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0097,"shares":320911,"value":5439441450,"date":"2026-06-30","chg":0.010199999},{"name":"Fidelity Investment Trust-Fidelity International Discovery Fund","pct":0.0091,"shares":301067,"value":5103085650,"date":"2026-08-31","chg":-0.0105},{"name":"New Economy Fund","pct":0.0076,"shares":252353,"value":4277383350,"date":"2026-09-30","chg":0.0},{"name":"iShares Trust-iShares Core MSCI EAF