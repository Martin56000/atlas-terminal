{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:52:14+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:52:14+00:00"},"data":{"profile":{"name":"Geberit AG","sector":"Industrials","industry":"Building Products & Equipment","country":"Switzerland","city":"Rapperswil-Jona","website":"https://www.geberit.com","employees":11472,"summary":"Geberit AG develops, produces, and distributes sanitary products and systems for the residential and commercial construction industry. It offers installation and flushing systems, such as installation technology and flushing systems for toilets, including cisterns and interior fittings; and piping systems comprising building drainage and supply systems, as well as piping technology for use in buildings for drinking water, heating, gas, and other media. The company also provides bathroom system products that include bathroom ceramics, furniture, showers, bathtubs, taps and controls, and shower toilets. It operates in Germany, Switzerland, Benelux, Italy, Austria, Central Europe, Western Europe, Northern Europe, Eastern Europe, the United States, the Middle East, Africa, Far East, and the Pacific. The company sells its products to wholesalers, plumbers, architects, and sanitary engineers under the Geberit brand name. Geberit AG was founded in 1874 and is headquartered in Rapperswil-Jona, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"Geberit AG développe, produit et distribue des produits et systèmes sanitaires pour le secteur de la construction résidentielle et commerciale. Il propose des systèmes d'installation et de rinçage, tels que la technologie d'installation et les systèmes de rinçage pour les toilettes, y compris les citernes et les aménagements intérieurs; et les systèmes de tuyauterie comprenant des systèmes de drainage et d'alimentation des bâtiments, ainsi que la technologie de tuyauterie pour une utilisation dans les bâtiments pour l'eau potable, le chauffage, le gaz et d'autres médias. La société fournit également des produits de système de salle de bain qui comprennent des céramiques de salle de bain, des meubles, des douches, des baignoires, des robinets et des commandes, et des toilettes de douche."},"valuation":{"market_cap_yahoo":18631966720,"shares_outstanding":32358401,"trailing_pe":30.530222,"forward_pe":27.347254,"price_to_book":16.809715,"ev_to_ebitda":21.399,"ev_to_revenue":6.166,"dividend_yield":0.0226,"payout_ratio":0.684,"beta_yahoo":1.024},"targets":{"current_price":575.8,"mean":592.2,"median":600.0,"high":712.0,"low":475.0,"n_analysts":15,"reco_mean":2.8,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-03"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":816536200,"ex_dividend":"2026-04-17","dividend_date":"2025-04-24"},"holders":{"insiders_pct":0.0054900004,"institutions_pct":0.45178002,"institutions_float_pct":0.45426998,"institutions_n":484,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":24,"value":13819,"date":"2026-06-30","chg":-0.38459998}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0146,"shares":485671,"value":279649355,"date":"2026-07-31","chg":0.0107},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0095999995,"shares":321072,"value":184873253,"date":"2026-06-30","chg":0.0117},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0075,"shares":250821,"value":144422728,"date":"2026-09-30","chg":0.0137},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.0038,"shares":126272,"value":72707416,"date":"2026-08-31","chg":0.0077},{"name":"iShares Trust-iShares MSCI EAFE ETF","pct":0.0034999999,"shares":116770,"value":67236164,"date":"2026-09-30","chg":0.0},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard European Stock Index Fd.","pct":0.0023999999,"shares":78625,"value":45272274,"date":