{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:54:26+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:54:26+00:00"},"data":{"profile":{"name":"Gjensidige Forsikring ASA","sector":"Financial Services","industry":"Insurance - Property & Casualty","country":"Norway","city":"Oslo","website":"https://www.gjensidige.com","employees":4176,"summary":"Gjensidige Forsikring ASA, together with its subsidiaries, provides general insurance and pension products in Norway, Sweden, Denmark, Finland, Latvia, Lithuania, and Estonia. It operates in four segments: General Insurance Private, General Insurance Commercial, General Insurance Sweden, and Pension. The company offers motor, property, travel, accident and health, general liability, natural perils, agriculture, medical treatment and expense, disability, income protection, workers' compensation, motor vehicle liability, marine, aviation, transport, fire and other damage to property, assistance, other non-life, and life insurance products, as well as non-proportional non-life reinsurance products. It also provides defined contribution occupational pension schemes for businesses, including disability pension, spouse/cohabitant pension, and child's pension; and individual pension savings agreements. The company sells its products to private individuals, commercial and agricultural customers, and private and commercial markets through various distribution channels comprising customer service centres, office channel, call center, Internet, partners, agents, and external brokers. Gjensidige Forsikring ASA was founded in 1816 and is headquartered in Oslo, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"NOK","summary_fr":"Gjensidige Forsikring ASA, avec ses filiales, fournit des produits d'assurance générale et de retraite en Norvège, en Suède, au Danemark, en Finlande, en Lettonie, en Lituanie et en Estonie. Elle opère dans quatre secteurs: Assurances générales privées, Assurances générales commerciales, Assurances générales Suède et Pensions. L'entreprise offre des services en matière d'assurance automobile, de biens, de voyages, d'accidents et de santé, de responsabilité civile générale, de risques naturels, d'agriculture, de soins médicaux et de dépenses, d'invalidité, de protection du revenu, d'indemnisation des travailleurs, de responsabilité automobile, de dommages aux biens maritimes, aériens, de transport, d'incendie et autres, d'assistance, d'autres produits d'assurance non vie et d'assurance vie, ainsi que des produits de réassurance non vie.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":null,"shares_outstanding":null,"trailing_pe":18.828632,"forward_pe":14.905169,"price_to_book":5.7470756,"ev_to_ebitda":5.911,"ev_to_revenue":1.29,"dividend_yield":0.038,"payout_ratio":0.72309995,"beta_yahoo":0.211},"targets":{"current_price":260.4,"mean":283.53125,"median":280.0,"high":321.0,"low":244.0,"n_analysts":16,"reco_mean":2.625,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-23"],"eps_avg":3.84436,"eps_low":3.5,"eps_high":4.13299,"revenue_avg":11523284000,"ex_dividend":"2026-03-27","dividend_date":null},"holders":{"insiders_pct":0.62277,"institutions_pct":0.20212,"institutions_float_pct":0.53578997,"institutions_n":274,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0054,"shares":2714086,"value":706747977,"date":"2026-07-31","chg":0.0015},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0037,"shares":1841731,"value":479586741,"date":"2026-06-30","chg":0.0294},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.003,"shares":1492477,"value":388641001,"date":"2026-09-30","chg":0.0124},{"name":"SEI INSTITUTIONAL INVESTMENTS TRUST-SIIT World Equity EX-US Fund","pct":0.0018000001,"shares":896866,"value":233543900,"date":"2026-08-31","chg":-0.0176},{"name":"AIM Intl Mutual F