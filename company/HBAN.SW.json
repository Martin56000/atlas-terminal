{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:36:43+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:36:43+00:00"},"data":{"profile":{"name":"Helvetia Baloise Holding AG","sector":"Financial Services","industry":"Insurance - Diversified","country":"Switzerland","city":"Basel","website":"https://www.helvetia-baloise.com","employees":20597,"summary":"Helvetia Baloise Holding AG engages in life and non-life insurance, and reinsurance business. It offers life insurance products in the areas of investment-linked, group life, and traditional individual life others; non-life insurance products in the areas of property, motor vehicle, health/accident, liability, engineering, and transport; and pure risk, savings, endowment, and annuity insurance products, as well as pension plans and asset management services. The company also provides marine, aviation, and art insurance. It operates in Switzerland, Spain, Germany, Belgium, Luxembourg, Italian and Austrian Markets, France, and internationally The company was formerly known as Helvetia Holding AG and changed its name to Helvetia Baloise Holding AG in April 2022. Helvetia Baloise Holding AG was incorporated in 2017 and is headquartered in Basel, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"Helvetia Baloise Holding AG exerce des activités d'assurance vie et non-vie et de réassurance. Il offre des produits d'assurance-vie dans les domaines de l'investissement, de la vie de groupe et de la vie individuelle traditionnelle; produits d'assurance non-vie dans les domaines de la propriété, des véhicules à moteur, de la santé / accident, de la responsabilité, de l'ingénierie et du transport; et risques purs, épargne, dotation et produits d'assurance de rente, ainsi que des régimes de retraite et des services de gestion d'actifs. La société fournit également des assurances maritimes, aériennes et artistiques."},"valuation":{"market_cap_yahoo":21506140160,"shares_outstanding":99015373,"trailing_pe":41.529636,"forward_pe":16.47369,"price_to_book":1.7571251,"ev_to_ebitda":-3.567,"ev_to_revenue":-0.322,"dividend_yield":0.0355,"payout_ratio":1.4722999,"beta_yahoo":0.332},"targets":{"current_price":217.2,"mean":232.7375,"median":245.0,"high":267.0,"low":193.9,"n_analysts":8,"reco_mean":1.875,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-09-17"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-05-27","dividend_date":null},"holders":{"insiders_pct":0.22863,"institutions_pct":0.32854,"institutions_float_pct":0.42591998,"institutions_n":315,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0114,"shares":1128838,"value":245183610,"date":"2026-07-31","chg":0.002},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0075,"shares":747783,"value":162418465,"date":"2026-06-30","chg":0.0113},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0058999998,"shares":583591,"value":126755963,"date":"2026-08-31","chg":0.0053},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Intl Core Eqy. 2 PORT.","pct":0.0041,"shares":407647,"value":88540927,"date":"2026-07-31","chg":0.0},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.003,"shares":301972,"value":65588317,"date":"2026-08-31","chg":0.0074},{"name":"iShares Trust-iShares MSCI EAFE ETF","pct":0.0028,"shares":274448,"value":59610104,"date":"2026-08-31","chg":0.0},{"name":"iShares Trust-iShares MSCI EAFE Value ETF","pct":0.0022,"shares":218802,"value":47523793,"date":"2026-08-31","chg":0.085200004},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard European Stock Index Fd.","pct":0.0018000001,"shares":182951,"value":39736956,"date":"2026-07-31","chg":-0.015800001},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0018000001,"shares":179792,"va