{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:51:49+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:51:49+00:00"},"data":{"profile":{"name":"Koninklijke Heijmans N.V.","sector":"Industrials","industry":"Engineering & Construction","country":"Netherlands","city":"Rosmalen","website":"https://www.heijmans.nl","employees":6361,"summary":"Koninklijke Heijmans N.V. engages in the real estate, construction, and infrastructure businesses in the Netherlands and internationally. It focuses on the development of large and smaller-scale projects in urban and out-of-town areas, as well as acts as an initiator, developer, and seller of residential properties. The company is also involved in building homes; and the restoration, redevelopment, renovation, maintenance, and service of existing housing stock. In addition, it designs, realizes, and maintains electro-technical and mechanical installations; and realizes large-scale and complex construction contracts in the customer and market segments of health care, government and semi-government organizations, commercial property, datacentres, and the high-tech clean industry such as, laboratories. Further, the company focuses on the construction, improvement and maintenance of road infrastructure, and public spaces, including related installations and on-site objects. The company was formerly known as Heijmans N.V. and changed its name to Koninklijke Heijmans N.V. in September 2023. Koninklijke Heijmans N.V. was founded in 1923 and is headquartered in Rosmalen, the Netherlands.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"Koninklijke Heijmans N.V. exerce ses activités dans les secteurs de l’immobilier, de la construction et des infrastructures aux Pays-Bas et à l’étranger. Il se concentre sur le développement de projets de grande et de petite envergure dans les zones urbaines et hors ville, et agit comme initiateur, promoteur et vendeur de propriétés résidentielles. La société est également impliquée dans la construction de maisons; et la restauration, le réaménagement, la rénovation, l'entretien et le service du parc de logements existant."},"valuation":{"market_cap_yahoo":2253196544,"shares_outstanding":27478006,"trailing_pe":15.799615,"forward_pe":10.44586,"price_to_book":4.054789,"ev_to_ebitda":10.945,"ev_to_revenue":0.737,"dividend_yield":0.0292,"payout_ratio":0.45229998,"beta_yahoo":1.303},"targets":{"current_price":82.0,"mean":121.5,"median":121.5,"high":123.0,"low":120.0,"n_analysts":2,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-05-04","dividend_date":null},"holders":{"insiders_pct":0.057150003,"institutions_pct":0.54959,"institutions_float_pct":0.5829,"institutions_n":154,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":5.99,"eps_low":5.99,"eps_high":5.99,"eps_year_ago":5.4883,"eps_n":1,"eps_growth":0.091400005,"rev_avg":3167912820,"rev_low":3108130000,"rev_high":3200400000,"rev_year_ago":2772000000,"rev_n":3,"rev_growth":0.1428,"eps_trend_now":5.99,"eps_trend_30d":6.51,"eps_trend_90d":6.08},{"period":"+1y","end_date":"2027-12-31","eps_avg":7.85,"eps_low":7.85,"eps_high":7.85,"eps_year_ago":5.99,"eps_n":1,"eps_growth":0.3105,"rev_avg":3379015230,"rev_