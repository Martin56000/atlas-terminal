{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:38:18+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:38:18+00:00"},"data":{"profile":{"name":"INFICON Holding AG","sector":"Technology","industry":"Scientific & Technical Instruments","country":"Switzerland","city":"Bad Ragaz","website":"https://www.inficon.com","employees":1681,"summary":"INFICON Holding AG develops instruments for gas analysis, measurement, and control in Switzerland and internationally. The company offers industrial gas analyzers, mass spectrometers, and process control sensors; vacuum gauges, controllers, components, and feedthroughs; leak detectors; thin film controllers; application-based software solutions; quartz crystal, RF sensing, and xParts coating technologies; chemical detectors and monitors; micro gas chromatography; and service tools. It also provides toxic chemical analysis products for emergency response, security, and environmental monitoring, as well as instruments for energy and petrochemical applications. The company's analysis, measurement, and control products are used for gas leak detection in air conditioning, refrigeration, and automotive manufacturing; and for equipment manufacturers and end-users in the fabrication of semiconductors and thin film coatings for optics, flat panel displays, solar cells, LED lighting, and industrial vacuum coating applications. Its products are also used in the life sciences, research, aerospace, packaging, heat treatment, laser cutting, and other industrial sectors. The company was founded in 2000 and is based in Bad Ragaz, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"USD","summary_fr":"INFICON Holding AG développe des instruments pour l’analyse, la mesure et le contrôle des gaz en Suisse et à l’international. La société propose des analyseurs de gaz industriels, des spectromètres de masse et des capteurs de contrôle de processus; jauges à vide, contrôleurs, composants et traversées; détecteurs de fuites; contrôleurs à couches minces; solutions logicielles basées sur des applications; quartz, détection RF et technologies de revêtement xParts; détecteurs et moniteurs chimiques; chromatographie en phase gazeuse micro; et outils de service. Il fournit également des produits d'analyse chimique toxiques pour les interventions d'urgence, la sécurité et la surveillance de l'environnement, ainsi que des instruments pour les applications énergétiques et pétrochimiques."},"valuation":{"market_cap_yahoo":4522763264,"shares_outstanding":24447367,"trailing_pe":58.176098,"forward_pe":29.459198,"price_to_book":13.237075,"ev_to_ebitda":30.162,"ev_to_revenue":6.115,"dividend_yield":0.0108,"payout_ratio":0.62439996,"beta_yahoo":1.466},"targets":{"current_price":185.0,"mean":204.06819,"median":198.85878,"high":238.22203,"low":179.48807,"n_analysts":9,"reco_mean":1.9,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-27"],"eps_avg":1.84994,"eps_low":1.84994,"eps_high":1.84994,"revenue_avg":null,"ex_dividend":"2026-04-24","dividend_date":"2025-04-14"},"holders":{"insiders_pct":0.30594,"institutions_pct":0.44929,"institutions_float_pct":0.64733005,"institutions_n":179,"institutions":[],"funds":[{"name":"SmallCap World Fund Inc","pct":0.015700001,"shares":384305,"value":71096425,"date":"2026-09-30","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.010199999,"shares":249313,"value":46122905,"date":"2026-07-31","chg":-0.0368},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0068,"shares":165514,"value":30620090,"date":"2026-06-30","chg":0.0115},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.0052,"shares":126120,"value":23332200,"date":"2026-07-31","chg":0.0},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0050999997,"shares":125558,"value":23228230,"date":"2026-09-30","chg":0.0138},{"name":"D