{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:53:29+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:53:29+00:00"},"data":{"profile":{"name":"Indutrade AB (publ)","sector":"Industrials","industry":"Industrial Distribution","country":"Sweden","city":"Kista","website":"https://www.indutrade.com","employees":10143,"summary":"Indutrade AB (publ) manufactures, develops, and sells components, systems, and services to various industries worldwide. It operates through five segments: Industrial & Engineering, Infrastructure & Construction, Life Science, Process, Energy & Water, and Technology & Systems Solutions. The company offers industrial equipment, tools, filters, hydraulics, fasteners, and chemical technology for general engineering and automotive industries; and flow technology products, including valves, pipes and pipe systems, and pumps, as well as measurement technology and industrial equipment for energy sector, water and wastewater, and process industries. It also provides measurement technology, sensors, control and regulating technology, as well as monitoring equipment to various industries; and materials, products, tools, and equipment for infrastructure and construction sectors. In addition, the company offers components; medical technology products, including products for diagnostics; and production equipment and system solutions to pharmaceutical, health care, and food sectors. Indutrade AB (publ) was incorporated in 1919 and is based in Kista, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Indutrade AB (publ) fabrique, développe et vend des composants, des systèmes et des services à diverses industries dans le monde entier. Elle opère à travers cinq segments : Industrie & Ingénierie, Infrastructure & Construction, Sciences de la Vie, Processus, Énergie & Eau, et Technologies & Systèmes Solutions. La société propose des équipements industriels, des outils, des filtres, des systèmes hydrauliques, des fixations et des technologies chimiques pour les industries de l'ingénierie générale et de l'automobile; et des produits de technologie de flux, y compris des vannes, des tuyaux et des systèmes de tuyaux, et des pompes, ainsi que des technologies de mesure et des équipements industriels pour le secteur de l'énergie, l'eau et les eaux usées, et les industries de transformation."},"valuation":{"market_cap_yahoo":96837050368,"shares_outstanding":364323000,"trailing_pe":34.43005,"forward_pe":29.665176,"price_to_book":5.0625677,"ev_to_ebitda":19.145,"ev_to_revenue":3.071,"dividend_yield":0.0117999995,"payout_ratio":0.4016,"beta_yahoo":1.151},"targets":{"current_price":265.8,"mean":284.125,"median":277.5,"high":322.0,"low":260.0,"n_analysts":8,"reco_mean":1.85714,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-23"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":9499702500,"ex_dividend":"2026-04-02","dividend_date":null},"holders":{"insiders_pct":0.27374,"institutions_pct":0.61758,"institutions_float_pct":0.85035,"institutions_n":250,"institutions":[],"funds":[{"name":"Fidelity Investment Trust-Fidelity Series Overseas Fund","pct":0.0165,"shares":6029277,"value":1602581753,"date":"2026-08-31","chg":0.0},{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Intl Fd.","pct":0.0146,"shares":5314411,"value":1412570378,"date":"2026-08-31","chg":-0.004},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.011,"shares":3994510,"value":1061740709,"date":"2026-07-31","chg":0.0143},{"name":"Fidelity Investment Trust-Fidelity Overseas Fund","pct":0.008,"shares":2898441,"value":770405582,"date":"2026-08-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0072000003,"shares":2620775,"value":696601963,"date":"2026-06-30","chg":0.0108},{"name":"Fidelity Central Investment PORT.s LLC-Fidelity Intl Eqy. Centr