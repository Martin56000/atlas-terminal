{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:56:33+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:56:33+00:00"},"data":{"profile":{"name":"Infotel SA","sector":"Technology","industry":"Information Technology Services","country":"France","city":"Paris","website":"https://www.infotel.com","employees":3548,"summary":"Infotel SA designs, develops, markets, and maintains software solutions in the areas of security, performance, and management in France, rest of Europe, and the United States. It operates through two segments, Software and Services. The company offers Arcsys, an archiving platform for electronic data; iDBA-Online, an intelligent management solution for administration and maintenance operations for DB2 databases; and Infoscope, a quality control software solution. It also provides InfoPak, InfoVic, and InfoUtil, as well as Orlando, a software solution for manufacturers in the aerospace industry; Deepeo, which offers a response to data protection; and utilities for Db2 for z/OS and LUW. In addition, the company offers consultancy, analysis, IT system audits, and third-party application maintenance services. It serves banking, insurance-retirement, industrial, aerospace, transportation, and the public sectors. Infotel SA was incorporated in 1979 and is headquartered in Paris, France.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"Infotel SA conçoit, développe, commercialise et entretient des solutions logicielles dans les domaines de la sécurité, de la performance et de la gestion en France, dans le reste de l’Europe et aux États-Unis. Il opère à travers deux segments, les logiciels et les services. La société propose Arcsys, une plateforme d’archivage de données électroniques ; iDBA-Online, une solution de gestion intelligente pour les opérations d’administration et de maintenance des bases de données DB2 ; et Infoscope, une solution logicielle de contrôle qualité."},"valuation":{"market_cap_yahoo":287490880,"shares_outstanding":6845021,"trailing_pe":17.872341,"forward_pe":12.162174,"price_to_book":2.4255025,"ev_to_ebitda":6.536,"ev_to_revenue":0.696,"dividend_yield":0.0494,"payout_ratio":0.8511,"beta_yahoo":0.344},"targets":{"current_price":42.0,"mean":51.375,"median":51.75,"high":55.0,"low":47.0,"n_analysts":4,"reco_mean":1.0,"reco_key":"strong_buy"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":76900000,"ex_dividend":"2026-06-03","dividend_date":null},"holders":{"insiders_pct":0.35367,"institutions_pct":0.20007999,"institutions_float_pct":0.30957,"institutions_n":23,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":76900000,"rev_low":76900000,"rev_high":76900000,"rev_year_ago":null,"rev_n":1,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":3.31667,"eps_low":3.11,"eps_high":3.44,"eps_year_ago":2.992,"eps_n":3,"eps_growth":0.108500004,"rev_avg":322000000,"rev_low":321000000,"rev_high":323000000,"rev_year_ago":294000000,"rev_n":2,"rev_growth":0.0952,"eps_trend_now":3.31667,"eps_trend_30d":3.32,"eps_trend_90d":3.22},{"period":"+1y","end_date":"2027-12-31","eps_avg":3.45333,"eps_low":3.23,"eps_high":3.63,"eps_year_ago":3.31667,"eps_n":3,"eps_growth":0.041199997,"rev_avg":331250000,"rev_low":322000000,"rev_high":344000000,"rev_year_ago":322000000,"rev_n":4,"rev_growth":0.0287,"eps_trend_now":3.45333,"eps_trend_30d":3.5175,"eps_trend_90d":3.44333}],"s