{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:41:11+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:41:11+00:00"},"data":{"profile":{"name":"Jacquet Metals SA","sector":"Basic Materials","industry":"Steel","country":"France","city":"Saint-Priest","website":"https://www.jacquetmetals.com","employees":3290,"summary":"Jacquet Metals SA, together with its subsidiaries, engages in the storage and distribution of special metals in Germany, France, Italy, North America, Spain, the Netherlands, rest of Europe, and internationally. It operates through JACQUET, STAPPERT, and IMS Group segments. The company distributes stainless steel and nickel alloys quarto plates for use in water, environment, energy, mechanical and forged metal construction, chemical and agri-food, gas processing and storage, pharmaceutical, and cosmetic sectors. It is also involved in the distribution of stainless-steel long products in the form of bars, profiles, welded tubes, and fittings that are used in the agri-food, chemical, and petrochemical industries, as well as the pipefitting, energy, transport, and decoration sectors. In addition, the company distributes carbon, alloy, and stainless-steel engineering steels, tool steels, and engineering aluminums used in mechanical engineering, public works machinery, agricultural machinery, lifting machinery, car and HGV suppliers, and energy sectors. Jacquet Metals SA was founded in 1962 and is headquartered in Saint-Priest, France.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"Jacquet Metals SA, avec ses filiales, s’occupe du stockage et de la distribution de métaux spéciaux en Allemagne, en France, en Italie, en Amérique du Nord, en Espagne, aux Pays-Bas, dans le reste de l’Europe et à l’international. Elle opère à travers les segments JACQUET, STAPPERT et IMS Group. La société distribue des plaques quarto en acier inoxydable et en alliages de nickel destinées aux secteurs de l'eau, de l'environnement, de l'énergie, de la construction mécanique et en métal forgé, de la chimie et de l'agroalimentaire, du traitement et du stockage du gaz, de la pharmacie et des cosmétiques."},"valuation":{"market_cap_yahoo":405870304,"shares_outstanding":20242908,"trailing_pe":15.787401,"forward_pe":9.570405,"price_to_book":0.6203589,"ev_to_ebitda":9.083,"ev_to_revenue":0.347,"dividend_yield":0.01,"payout_ratio":0.1575,"beta_yahoo":0.99},"targets":{"current_price":20.05,"mean":24.4,"median":24.4,"high":27.0,"low":21.8,"n_analysts":2,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-30","dividend_date":null},"holders":{"insiders_pct":0.51714003,"institutions_pct":0.30599,"institutions_float_pct":0.6337,"institutions_n":31,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":1.33699,"eps_low":1.33699,"eps_high":1.33699,"eps_year_ago":0.477,"eps_n":1,"eps_growth":1.8029,"rev_avg":1887400000,"rev_low":1887400000,"rev_high":1887400000,"rev_year_ago":1839632000,"rev_n":1,"rev_growth":0.025999999,"eps_trend_now":1.33699,"eps_trend_30d":1.39,"eps_trend_90d":1.39},{"period":"+1y","end_date":"2027-12-31","eps_avg":2.095,"eps_low":1.85,"eps_high":2.34,"eps_year_ago":1.33699,"eps_n":2,"eps_growth":0.56700003,"rev_avg":20315