{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:45:36+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:45:36+00:00"},"data":{"profile":{"name":"KBC Group NV","sector":"Financial Services","industry":"Banks - Regional","country":"Belgium","city":"Brussels","website":"https://www.kbc.com","employees":39803,"summary":"KBC Group NV, together with its subsidiaries, provides banking, insurance, and asset management services in Belgium, Bulgaria, the Czech Republic, Hungary, and Slovakia. The company offers demand deposits, time deposits, and savings and current accounts; home and mortgage loans; home insurance; consumer finance and SME funding services, investment fund, and life and non-life insurance; cash management, payments, trade finance, leasing, corporate finance, money and capital market products; and other financial services, such as factoring and stockbroking services. It also provides digital and mobile banking services. In addition, the company engages in the credit institution, software, driving school/roadside assistance business. It primarily serves retail, private banking, small and medium sized enterprises, and mid-cap clients. The company was formerly known as KBC Bank and Insurance Holding Company NV and changed its name to KBC Group NV in March 2005. KBC Group NV was incorporated in 1935 and is headquartered in Brussels, Belgium.","exchange":"Brussels","currency":"EUR","financial_currency":"EUR","summary_fr":"KBC Group NV, avec ses filiales, fournit des services bancaires, d'assurance et de gestion d'actifs en Belgique, en Bulgarie, en République tchèque, en Hongrie et en Slovaquie. La société offre des dépôts à vue, des dépôts à terme et des comptes d'épargne et courants; prêts immobiliers et hypothécaires; assurance habitation; services de financement à la consommation et de financement aux PME, fonds d'investissement et assurance vie et non-vie; gestion de la trésorerie, paiements, financement du commerce, crédit-bail, financement des entreprises, argent et produits du marché des capitaux; et d'autres services financiers, tels que les services d'affacturage et de courtage. Il fournit également des services bancaires numériques et mobiles."},"valuation":{"market_cap_yahoo":46054768640,"shares_outstanding":396681919,"trailing_pe":12.972067,"forward_pe":10.279249,"price_to_book":1.8047847,"ev_to_ebitda":null,"ev_to_revenue":3.865,"dividend_yield":0.044299997,"payout_ratio":0.5648,"beta_yahoo":0.694},"targets":{"current_price":116.1,"mean":134.05,"median":136.5,"high":156.0,"low":88.0,"n_analysts":20,"reco_mean":2.4,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-12"],"eps_avg":2.86175,"eps_low":2.79,"eps_high":2.94701,"revenue_avg":3443894800,"ex_dividend":"2026-11-04","dividend_date":null},"holders":{"insiders_pct":0.41968,"institutions_pct":0.32018003,"institutions_float_pct":0.55173,"institutions_n":486,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":10100,"value":1172609,"date":"2026-06-30","chg":0.0},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":2954,"value":342959,"date":"2026-06-30","chg":-0.0296},{"name":"Heritage Wealth Advisors","pct":0.0,"shares":139,"value":16137,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0078,"shares":3268774,"value":379504656,"date":"2026-07-31","chg":-0.0128},{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Intl Fd.","pct":0.0069999998,"shares":2919566,"value":338961608,"date":"2026-08-31","chg":0.0},{"name":"Fidelity Investment Trust-Fidelity Series International Value Fund","pct":0.0056,"shares":2347004,"value":272487160,"date":"2026-08-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0052,"shares":2166422,"value":251521590,"date":"2026-06-30","chg":-0.010199999},{"name":"Fidelity Investment Trust-Fide