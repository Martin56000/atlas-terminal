{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T07:40:14+00:00","status":"ok","error":null,"last_success":"2026-10-29T07:40:14+00:00"},"data":{"profile":{"name":"KION GROUP AG","sector":"Industrials","industry":"Farm & Heavy Construction Machinery","country":"Germany","city":"Frankfurt am Main","website":"https://www.kiongroup.com","employees":42403,"summary":"KION GROUP AG provides industrial trucks and supply chain solutions in Western and Eastern Europe, the Middle East, Africa, North America, Central and South America, China, and the rest of the Asia Pacific. It operates through Industrial Trucks & Services; and Supply Chain Solutions segments. The company offers forklift and heavy trucks, counterbalance trucks with electric drive and internal combustion engine, intralogistics systems, components and spare parts, narrow aisle trucks, lithium-ion batteries, and industrial and warehouse trucks under the Linde, STILL, Baoli, Fenwick, and OM brands. It also leases and rents industrial trucks and related equipment; and provides maintenance and repair services, fleet management solutions, driver assistance systems, and service options, as well as finance solutions. In addition, the company provides integrated technology and software solutions, automated guided vehicle systems, warehouse automation solutions, palletizers, storage and picking equipment, automated storage and retrieval systems, system components and racking, sorters, and conveyors under the Dematic brand. Further, it offers logistics solutions. The company was formerly known as KION Holding 1 GmbH. KION GROUP AG was founded in 2006 and is headquartered in Frankfurt am Main, Germany.","exchange":"XETRA","currency":"EUR","financial_currency":"EUR","summary_fr":"KION GROUP AG fournit des camions industriels et des solutions de chaîne d'approvisionnement en Europe de l'Ouest et de l'Est, au Moyen-Orient, en Afrique, en Amérique du Nord, en Amérique centrale et du Sud, en Chine et dans le reste de l'Asie-Pacifique. Elle opère à travers les segments Industrial Trucks & Services; et Supply Chain Solutions. La société propose des chariots élévateurs et des camions lourds, des chariots à contrepoids avec entraînement électrique et moteur à combustion interne, des systèmes intralogistiques, des composants et des pièces de rechange, des chariots étroits, des batteries lithium-ion et des camions industriels et d'entrepôt sous les marques Linde, STILL, Baoli, Fenwick et OM."},"valuation":{"market_cap_yahoo":4405792256,"shares_outstanding":131124771,"trailing_pe":11.467576,"forward_pe":7.9105167,"price_to_book":0.69402844,"ev_to_ebitda":6.815,"ev_to_revenue":1.025,"dividend_yield":0.0183,"payout_ratio":0.2116,"beta_yahoo":2.045},"targets":{"current_price":33.6,"mean":49.73333,"median":51.0,"high":62.0,"low":37.0,"n_analysts":15,"reco_mean":1.66667,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":0.83954,"eps_low":0.83,"eps_high":0.84909,"revenue_avg":2844786070,"ex_dividend":"2026-05-29","dividend_date":null},"holders":{"insiders_pct":0.4652,"institutions_pct":0.39033002,"institutions_float_pct":0.72986,"institutions_n":281,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":465,"value":15623,"date":"2026-06-30","chg":0.0356}],"funds":[{"name":"T. ROWE PRICE Intl Fd.S, INC.-T. Rowe Price Overseas Stock Fd.","pct":0.012200001,"shares":1595456,"value":53607319,"date":"2026-07-31","chg":-0.0276},{"name":"TR PRICE-Price (T.Rowe) International Core Equity Trust","pct":0.0089,"shares":1164104,"value":39113892,"date":"2026-06-30","chg":-0.0359},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.007900001,"shares":1031592,"value":34661489,"date":"2026-07-31","chg":0.0062},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0077,"shares":1005529,"value":33785772,"date":"2026-07-31","chg":0.0},{"name":"Columbia Funds Serie