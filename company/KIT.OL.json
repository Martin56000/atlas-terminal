{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:55:07+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:55:07+00:00"},"data":{"profile":{"name":"Kitron ASA","sector":"Technology","industry":"Electronic Components","country":"Norway","city":"Billingstad","website":"https://kitron.com","employees":3241,"summary":"Kitron ASA operates as an electronics manufacturing services provider in Norway, Sweden, Denmark, Lithuania, Germany, Poland, the Czech Republic, India, China, Malaysia, and the United States. The company manufactures and sells electronics that are embedded in the customer's own products; and box-built electronic products. It also provides electronics manufacturing services, including automated assembly of printed circuit boards and higher-level system integration; development services, such as product development, product management, and re-engineering services; and industrialization services, including prototype manufacturing, evaluation of new products, component engineering and database, test development, design and build of high-level assembly lines, and environmental durability testing. In addition, the company offers sourcing and procurement services; logistics and distribution; redesign, repair, and maintenance; product deployment services; cable harness manufacturing and components analysis; and resilience testing services. It markets its services to the connectivity, electrification, industry, medical devices, and defense/aerospace sectors. The company was founded in 1962 and is headquartered in Billingstad, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"EUR","summary_fr":"Kitron ASA opère en tant que fournisseur de services de fabrication électronique en Norvège, en Suède, au Danemark, en Lituanie, en Allemagne, en Pologne, en République tchèque, en Inde, en Chine, en Malaisie et aux États-Unis. La société fabrique et vend des produits électroniques intégrés dans les produits du client; et des produits électroniques fabriqués en boîte. Il fournit également des services de fabrication électronique, y compris l'assemblage automatisé de cartes de circuits imprimés et l'intégration de systèmes de niveau supérieur; services de développement, tels que le développement de produits, la gestion de produits et les services de réingénierie; et services d'industrialisation, y compris la fabrication de prototypes, l'évaluation de nouveaux produits, l'ingénierie de composants et la base de données, le développement de tests, la conception et la construction de lignes d'assemblage de haut niveau et les essais environnementaux.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":19552000000,"shares_outstanding":218702471,"trailing_pe":22.462313,"forward_pe":18.177998,"price_to_book":4.8996725,"ev_to_ebitda":155.758,"ev_to_revenue":17.311,"dividend_yield":0.0082,"payout_ratio":0.1675,"beta_yahoo":0.926},"targets":{"current_price":89.4,"mean":104.816246,"median":98.49651,"high":132.47115,"low":88.64789,"n_analysts":6,"reco_mean":1.83333,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":0.1,"eps_low":0.1,"eps_high":0.1,"revenue_avg":314820000,"ex_dividend":"2026-04-27","dividend_date":null},"holders":{"insiders_pct":0.027679998,"institutions_pct":0.63067,"institutions_float_pct":0.64862,"institutions_n":133,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-12-31","eps_avg":0.1,"eps_low":0.1,"eps_high":0.1,"eps_year_ago":0.08,"eps_n":2,"eps_growth":0.25,"rev_avg":314820000,"rev_low":288100000,"rev_high":389000000,"rev_year_ago":233800000,"rev_n":6,"rev_growth":0.3465,"eps_trend_now":0.1,"eps_trend_30d":0.09,"eps_trend_90d":0.09},{"period":"+1q","end_date":"2027-03-31","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":310000000,"rev_low":310000000,"rev_high":310000000,"rev_year_ago":272700000,"rev_n"