{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T07:36:40+00:00","status":"ok","error":null,"last_success":"2026-10-29T07:36:40+00:00"},"data":{"profile":{"name":"Komercní banka, a.s.","sector":"Financial Services","industry":"Banks - Regional","country":"Czech Republic","city":"Prague","website":"https://www.kb.cz","employees":6627,"summary":"Komercní banka, a.s., together with its subsidiaries, provides various retail, corporate, and investment banking services primarily in the Czech Republic, and Central and Eastern Europe. The company operates through Retail Banking, Corporate Banking, and Investment Banking segments. It accepts various deposits, such as current, business, and savings accounts; term deposits; and building savings. The company's loan products include personal, revolving, sustainable housing, syndicated, consumer, credit card, and business loans; mortgages; home equity loans and lines of credit; and overdrafts, as well as operational, investment, pension, import and export, claim, real estate, and structured financing. It also offers debit and credit cards; travel, risk life, savings life, accident, residential real estate, household, investment life, property, capital life, solvency, and payment insurance products; bond issuance and private banking services; foreign currency and derivative products; investment solutions; securities; guarantee transactions; payments; cash pooling; and currency spot, cross currency swap, currency option and forward, and foreign exchange forward and swap services, as well as trades in financial instruments. In addition, the company internet and mobile banking, online tools for international trade, and other digital services. It serves individuals, entrepreneurs, small businesses, and corporations and institutions. The company was founded in 1990 and is headquartered in Prague, the Czech Republic. Komercní banka, a.s. is a subsidiary of Société Générale Société anonyme.","exchange":"Prague","currency":"CZK","financial_currency":"CZK"},"valuation":{"market_cap_yahoo":190177902592,"shares_outstanding":188855900,"trailing_pe":6.098964,"forward_pe":12.200146,"price_to_book":1.6174213,"ev_to_ebitda":null,"ev_to_revenue":10.271,"dividend_yield":0.0949,"payout_ratio":1.0162001,"beta_yahoo":0.136},"targets":{"current_price":1007.0,"mean":1121.48,"median":1114.0,"high":1218.76,"low":1040.0,"n_analysts":12,"reco_mean":2.75,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":23.19772,"eps_low":23.19772,"eps_high":23.19772,"revenue_avg":9485250000,"ex_dividend":"2026-05-04","dividend_date":"1970-08-22"},"holders":{"insiders_pct":0.6035,"institutions_pct":0.101660006,"institutions_float_pct":0.2564,"institutions_n":178,"institutions":[{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0021,"shares":401626,"value":404437382,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0058,"shares":1103310,"value":1111033170,"date":"2026-07-31","chg":-0.0053},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard Emerging Markets Stock Index Fd","pct":0.0055,"shares":1046377,"value":1053701639,"date":"2026-07-31","chg":0.0226},{"name":"iShares, Inc.-iShares Core MSCI Emerging Markets ETF","pct":0.0047,"shares":887010,"value":893219070,"date":"2026-09-30","chg":-0.0215},{"name":"MFS Series Trust V-MFS International New Discovery Fund","pct":0.0022,"shares":417668,"value":420591676,"date":"2026-06-30","chg":-0.0217},{"name":"Dimensional Emerging Markets Value Fund","pct":0.0015,"shares":277089,"value":279028623,"date":"2026-07-31","chg":0.0},{"name":"SPDR INDEX SHARES Fd.S-State Street SPDR PORT. Emerging Markets ETF","pct":0.0011999999,"shares":220937,"value":222483559,"date":"2026-09-30","chg":-0.00059999997},{"name":"Cambria ETF Trust-Cambria Global Value ETF","pct":0.0011,"shares":207746,"value":209200222,"date":"2026-09-30","chg