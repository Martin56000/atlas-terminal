{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:51:32+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:51:32+00:00"},"data":{"profile":{"name":"Koninklijke KPN N.V.","sector":"Communication Services","industry":"Telecom Services","country":"Netherlands","city":"Rotterdam","website":"https://www.kpn.com","employees":4789,"summary":"Koninklijke KPN N.V. provides telecommunications and information technology (IT) services in the Netherlands. The company operates through Consumer, Business, Wholesale and Network, and Operations & IT segments. It offers fixed and mobile telephony, fixed and mobile broadband internet, and TV to retail and business consumers; infrastructure and network-related IT solutions to business customers; and wholesale network services to third parties. The company also provides network-related ICT solutions, such as security, internet of things, cloud, connectivity, and smart combinations; interconnect traffic, visitor roaming, digital products, and NL-ix interconnect exchange services; and sale of handsets and peripheral equipment, as well as software licenses. It offers its products and services under the KPN, XS4ALL, Simyo, KPN Security, KPN Health, Solcon, Inspark, and KPN Partner Network, KPN IoT, and youfone brands. The company was formerly known as Koninklijke PTT Nederland NV and changed its name to Koninklijke KPN N.V. in June 1998. Koninklijke KPN N.V. was founded in 1881 and is headquartered in Rotterdam, the Netherlands.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"Koninklijke KPN N.V. fournit des services de télécommunications et de technologie de l'information (TI) aux Pays-Bas. La société opère à travers les secteurs de la consommation, des affaires, de la vente en gros et du réseau, et des opérations et des TI. Elle offre des services de téléphonie fixe et mobile, d'Internet haut débit fixe et mobile et de télévision aux particuliers et aux entreprises; des solutions informatiques liées aux infrastructures et aux réseaux aux entreprises; et des services de réseau de gros à des tiers."},"valuation":{"market_cap_yahoo":15756151808,"shares_outstanding":3772121708,"trailing_pe":18.986364,"forward_pe":15.474382,"price_to_book":6.870066,"ev_to_ebitda":9.292,"ev_to_revenue":3.828,"dividend_yield":0.0462,"payout_ratio":0.8273,"beta_yahoo":0.261},"targets":{"current_price":4.177,"mean":4.549,"median":4.69,"high":5.3,"low":2.3,"n_analysts":20,"reco_mean":2.28571,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-28"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":1473292060,"ex_dividend":"2026-07-24","dividend_date":null},"holders":{"insiders_pct":0.00135,"institutions_pct":0.72028,"institutions_float_pct":0.72126,"institutions_n":479,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":20649,"value":86250,"date":"2026-06-30","chg":-0.059499998}],"funds":[{"name":"Income Fund of America","pct":0.024400001,"shares":92088031,"value":384651709,"date":"2026-09-30","chg":-0.3678},{"name":"THORNBURG INVESTMENT TRUST-Thornburg Investment Income Builder Fund","pct":0.0168,"shares":63491000,"value":265201909,"date":"2026-06-30","chg":0.0719},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0148,"shares":55946560,"value":233688783,"date":"2026-07-31","chg":0.0239},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0099,"shares":37399759,"value":156218795,"date":"2026-06-30","chg":0.040900003},{"name":"Capital Income Builder","pct":0.007900001,"shares":29786540,"value":124418378,"date":"2026-09-30","chg":0.0},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0078,"shares":29288772,"value":122339201,"date":"2026-09-30","chg":0.013099999},{"name":"Intl Growth & Income Fd.-Intl Growth and Income Fd.","pct":0.0076,"shares":28582027,"value":119387128,"date":"2026-09-30","chg":0.0},{"name":"MFS 