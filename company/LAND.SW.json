{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:38:45+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:38:45+00:00"},"data":{"profile":{"name":"Landis+Gyr Group AG","sector":"Industrials","industry":"Electrical Equipment & Parts","country":"Switzerland","city":"Cham","website":"https://www.landisgyr.com","employees":6042,"summary":"Landis+Gyr Group AG, together with its subsidiaries, provides integrated energy management solutions to utility sector in the Americas and the Asia Pacific. The company offers smart and non-smart electricity, prepayment electricity, commercial/industrial and grid, and gas meters; advanced metering infrastructure solutions; heat and water meters and solutions; load control devices; street light controllers; and distribution automation, system deployment, and managed network solutions. It also provides various advanced metering infrastructure offerings, including software, meter data management, installation, implementation, consulting, maintenance support, and related services; and communication modules for water and gas meters. The company was formerly known as Landis+Gyr Holding AG. Landis+Gyr Group AG was incorporated in 1896 and is headquartered in Cham, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"USD","summary_fr":"Landis+Gyr Group AG, en collaboration avec ses filiales, fournit des solutions intégrées de gestion de l'énergie au secteur des services publics en Amérique et en Asie-Pacifique. La société propose de l'électricité intelligente et non intelligente, de l'électricité à prépaiement, des compteurs commerciaux / industriels et de réseau, et des solutions d'infrastructure de comptage avancées; compteurs de chaleur et d'eau et solutions; dispositifs de contrôle de charge; contrôleurs de réverbères; et automatisation de la distribution, déploiement de systèmes et solutions de réseau gérées. Il fournit également diverses offres d'infrastructure de comptage avancées, notamment des logiciels, la gestion des données des compteurs, l'installation, la mise en œuvre, le conseil, le soutien à la maintenance et les services connexes; et des modules de communication pour les compteurs d'eau et de gaz."},"valuation":{"market_cap_yahoo":1397169280,"shares_outstanding":26018050,"trailing_pe":46.695652,"forward_pe":17.62875,"price_to_book":1.6736466,"ev_to_ebitda":10.862,"ev_to_revenue":1.522,"dividend_yield":0.0223,"payout_ratio":0.9271,"beta_yahoo":0.77},"targets":{"current_price":53.7,"mean":58.768665,"median":58.604134,"high":66.29486,"low":51.571537,"n_analysts":4,"reco_mean":2.5,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-30","dividend_date":"2024-07-01"},"holders":{"insiders_pct":0.10569,"institutions_pct":0.55722,"institutions_float_pct":0.62307,"institutions_n":149,"institutions":[],"funds":[{"name":"Artisan Partners Funds Inc.-Artisan International Small-Mid Fund","pct":0.0195,"shares":563093,"value":30238094,"date":"2026-06-30","chg":0.1692},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0128,"shares":370662,"value":19904549,"date":"2026-07-31","chg":-0.0078},{"name":"First TRT Exch-Trd Fd. II-First TRT NASDAQ Clean Edge Smart Grid Infra","pct":0.0116,"shares":335706,"value":18027412,"date":"2026-09-30","chg":0.015},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0114,"shares":328903,"value":17662091,"date":"2026-07-31","chg":0.0},{"name":"Columbia Fd.s Varbl Series TRT II-Columbia Varbl PORT. - Overseas Core","pct":0.0091,"shares":263371,"value":14143022,"date":"2026-06-30","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0087,"shares":250913,"value":13474028,"date":"2026-06-30","chg":0.02},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0066000004,"sha