{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:54:08+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:54:08+00:00"},"data":{"profile":{"name":"Lenzing Aktiengesellschaft","sector":"Consumer Cyclical","industry":"Textile Manufacturing","country":"Austria","city":"Lenzing","website":"https://www.lenzing.com","employees":7556,"summary":"Lenzing Aktiengesellschaft, together with its subsidiaries, produces and markets regenerated cellulosic fibers for textiles and nonwovens. The company operates through Division Fiber, Division Pulp, and Others segments. It offers lyocell, modal, and viscose fibers for application in textiles and nonwovens products, such as denim, activewear, intimates, haute couture and footwear, home and interiors, luxury textiles, and workwear; body care, intimate hygiene comprising baby wipes, surface cleaning, beauty and personal care, facial sheet masks, and cosmetic wipes; and protective clothing, engineered products, packaging, filtration as well as medical and industrial applications, and automotive interiors under the TENCEL, VEOCEL, LENZING ECOVERO, and LENZING brand names. The company also provides biorefinery products, including acetic acid biobased, furfural biobased, magnesium-lignosulphonate biobased, soda ash, sodium sulphate, and xylose. In addition, it engages in training and personnel development activities and converts renewable electricity directly into process heat. The company operates in Austria; rest of Europe; Asia; North, Central, and South America; and internationally. Lenzing Aktiengesellschaft was formerly known as Chemiefaser Lenzing AG and changed its name to Lenzing Aktiengesellschaft in 1984. Lenzing Aktiengesellschaft was founded in 1892 and is headquartered in Lenzing, Austria.","exchange":"Vienna","currency":"EUR","financial_currency":"EUR","summary_fr":"Lenzing Aktiengesellschaft, avec ses filiales, produit et commercialise des fibres cellulosiques régénérées pour les textiles et les non-tissés. La société opère à travers les segments Division Fiber, Division Pulp et autres. Il propose des fibres lyocell, modales et viscose pour une application dans les textiles et les produits non tissés, tels que le denim, les vêtements de sport, les articles intimes, la haute couture et les chaussures, la maison et les intérieurs, les textiles de luxe et les vêtements de travail; soins corporels, hygiène intime comprenant des lingettes pour bébé, nettoyage de surface, soins de beauté et personnels, masques pour le visage et lingettes cosmétiques;"},"valuation":{"market_cap_yahoo":581026304,"shares_outstanding":52439200,"trailing_pe":null,"forward_pe":-14.703345,"price_to_book":0.91721857,"ev_to_ebitda":6.309,"ev_to_revenue":0.926,"dividend_yield":0.0,"payout_ratio":1.5216,"beta_yahoo":1.0},"targets":{"current_price":11.08,"mean":19.175,"median":17.5,"high":29.0,"low":12.7,"n_analysts":4,"reco_mean":3.5,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2022-04-28","dividend_date":"1970-08-23"},"holders":{"insiders_pct":0.275,"institutions_pct":0.065910004,"institutions_float_pct":0.090909995,"institutions_n":56,"institutions":[],"funds":[{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0126,"shares":925162,"value":10250794,"date":"2026-09-30","chg":0.0162},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0037,"shares":269718,"value":2988475,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0023999999,"shares":176280,"value":1953182,"date":"2026-06-30","chg":0.0},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0021,"shares":153427,"value":1699971,"date":"2026-09-30","chg":0.0143},{"name":"iShares, Inc.-iShares MSCI Austria ETF","pct":0.0018000001,"shares":130411,"value":14