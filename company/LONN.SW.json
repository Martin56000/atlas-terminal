{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:52:07+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:52:07+00:00"},"data":{"profile":{"name":"Lonza Group AG","sector":"Healthcare","industry":"Diagnostics & Research","country":"Switzerland","city":"Basel","website":"https://www.lonza.com","employees":20141,"summary":"Lonza Group AG, together with its subsidiaries, operates as a contract development and manufacturing organization for pharma and biotech companies in Europe, North and Central America, Latin America, Asia, Australia, New Zealand, and internationally. It operates through Integrated Biologics; Advanced Synthesis; and Specialized Modalities segments. The Integrated Biologics segment offers CDMO biologics services from clinical development, drug substance, and drug product manufacturing; and operates mammalian and drug product platforms. Its Advanced Synthesis segment manufactures antibody-drug conjugates (ADCs) and other bioconjugates, small molecules, and highly potent active pharmaceutical ingredients; and operates small molecules and bioconjugates platforms. The Specialized Modalities segment operates various technologies, such as spanning cell & gene, microbial, bioscience, and mRNA. Lonza Group AG was incorporated in 1897 and is headquartered in Basel, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"Lonza Group AG, avec ses filiales, opère en tant qu'organisation de développement et de fabrication de contrats pour des sociétés pharmaceutiques et biotechnologiques en Europe, en Amérique du Nord et centrale, en Amérique latine, en Asie, en Australie, en Nouvelle-Zélande et à l'international. Il opère par le biais de produits biologiques intégrés, de synthèse avancée et de modes spécialisés. Le segment des produits biologiques intégrés offre des services de produits biologiques CDMO provenant du développement clinique, de la fabrication de substances médicamenteuses et de produits pharmaceutiques, et exploite des plateformes de produits pour les mammifères et les médicaments."},"valuation":{"market_cap_yahoo":44756180992,"shares_outstanding":69844229,"trailing_pe":42.465206,"forward_pe":28.670254,"price_to_book":5.5064316,"ev_to_ebitda":19.94,"ev_to_revenue":6.936,"dividend_yield":0.007900001,"payout_ratio":0.32279998,"beta_yahoo":0.811},"targets":{"current_price":640.8,"mean":696.6087,"median":680.0,"high":887.0,"low":550.0,"n_analysts":23,"reco_mean":1.54167,"reco_key":"buy"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-05-12","dividend_date":"2025-05-15"},"holders":{"insiders_pct":0.00090000004,"institutions_pct":0.58816004,"institutions_float_pct":0.58869,"institutions_n":611,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":543,"value":347954,"date":"2026-06-30","chg":-0.0234},{"name":"Gamma Investing LLC","pct":0.0,"shares":92,"value":58953,"date":"2026-09-30","chg":0.0},{"name":"Main Street Group, Ltd                          ","pct":0.0,"shares":124,"value":79459,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"VANGUARD WORLD FUND-Vanguard International Growth Fund","pct":0.0153,"shares":1076692,"value":689944220,"date":"2026-05-31","chg":2.7941},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0146,"shares":1028512,"value":659070477,"date":"2026-07-31","chg":0.0227},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0097,"shares":683586,"value":438041900,"date":"2026-06-30","chg":0.0287},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0076,"shares":530637,"value":340032183,"date":"2026-09-30","chg":0.0128},{"name":"College Retirement Equities Fd.-College Retirement Equities Fd. - Tota","pct":0.0046,"shares":321600,"value":206081276,"date":"2026-06-30","chg":-0.017},{"name":"Fidelity Concord Street Trust-Fidelity Inte