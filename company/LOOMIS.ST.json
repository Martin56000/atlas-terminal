{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-11-11T16:57:10+00:00","status":"ok","error":null,"last_success":"2026-11-11T16:57:10+00:00"},"data":{"profile":{"name":"Loomis AB (publ)","sector":"Industrials","industry":"Security & Protection Services","country":"Sweden","city":"Stockholm","website":"https://www.loomis.com","employees":23100,"summary":"Loomis AB (publ) provides secure payment solutions in the United States, France, Switzerland, Spain, the United Kingdom, Sweden, and internationally. The company provides transportation of cash and valuables with logistics systems to and from central banks, financial institutions, retailers, restaurants and other businesses; cash management services, and vault and cash storage outsourcing for central banks and commercial banks; and international valuables logistics services, including collection and coordination of cross-border transportation, as well as customs clearance, storage, and secure delivery. It also offers automated teller machine services; automated cash-handling solutions, such as SafePoint, cash recyclers, and front office solutions; foreign exchange services; and Loomis Pay, an end-to-end payment solution that handles all types of payment instruments comprising cards, cash, and digital options in one system. Loomis AB (publ) was founded in 1852 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Loomis AB (publ) fournit des solutions de paiement sécurisées aux États-Unis, en France, en Suisse, en Espagne, au Royaume-Uni, en Suède et à l'international. La société fournit le transport de trésorerie et d'objets de valeur avec des systèmes logistiques vers et depuis les banques centrales, les institutions financières, les détaillants, les restaurants et d'autres entreprises; services de gestion de trésorerie, et externalisation des coffres et du stockage de trésorerie pour les banques centrales et les banques commerciales; et services logistiques internationaux de valeurs, y compris la collecte et la coordination du transport transfrontalier, ainsi que le dédouanement, le stockage et la livraison sécurisée. Il propose également des services de guichet automatique, des solutions de traitement automatique de l'argent, telles que SafePoint, des solutions de recyclage de l'argent et des solutions de front office, des services de change et Loomis Pay, une solution de paiement de bout en bout qui gère tous les types d'instruments de paiement comprenant les cartes, l'argent et les options numériques dans un seul système."},"valuation":{"market_cap_yahoo":35134181376,"shares_outstanding":66922247,"trailing_pe":17.459263,"forward_pe":15.550949,"price_to_book":2.6050453,"ev_to_ebitda":7.707,"ev_to_revenue":1.461,"dividend_yield":0.029000001,"payout_ratio":0.499,"beta_yahoo":0.49},"targets":{"current_price":525.0,"mean":586.25,"median":577.5,"high":630.0,"low":560.0,"n_analysts":4,"reco_mean":2.5,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-30"],"eps_avg":12.49,"eps_low":12.49,"eps_high":12.49,"revenue_avg":8660490000,"ex_dividend":"2026-05-07","dividend_date":null},"holders":{"insiders_pct":0.0,"institutions_pct":0.68627,"institutions_float_pct":0.68627,"institutions_n":180,"institutions":[],"funds":[{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0172,"shares":1153688,"value":605686200,"date":"2026-09-30","chg":0.0094},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0147,"shares":986266,"value":517789650,"date":"2026-07-31","chg":-0.0031},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0098,"shares":657553,"value":345215325,"date":"2026-06-30","chg":0.0042},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.008,"shares":533232,"value":279946800,"date":"2026-09-30","chg":0.0127},{"name":"Fidelity Puritan Trust-Fidelity 