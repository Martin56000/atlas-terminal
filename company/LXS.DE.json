{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:57:42+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:57:42+00:00"},"data":{"profile":{"name":"LANXESS Aktiengesellschaft","sector":"Basic Materials","industry":"Specialty Chemicals","country":"Germany","city":"Cologne","website":"https://lanxess.com","employees":11495,"summary":"LANXESS Aktiengesellschaft, a specialty chemicals company, engages in the development, manufacture, and marketing of chemical intermediates, additives, and consumer protection products worldwide. It operates through three segments: Consumer Protection, Specialty Additives, and Advanced Intermediates. The company provides material protection products; disinfectant, hygiene, and preservative solutions; flavors and fragrances; liquid purification technologies for the treatment of water and other liquids; and precursors and intermediates for the agrochemicals, pharmaceuticals, and specialty chemicals industries. It also offers additives, lubricants, flame retardants, plasticizers, and bromine derivatives for various rubber, plastic and paint, electrical/electronics, and construction industries. In addition, the company provides basic and fine chemicals, organometallics, and inorganic pigments for the coloring of construction materials, as well as paints and coatings. It serves the energy, natural resources, industrial applications, nutrition, health, consumer goods, agriculture, animal health, construction, chemicals, and mobility industries. LANXESS Aktiengesellschaft was founded in 1863 and is headquartered in Cologne, Germany.","exchange":"XETRA","currency":"EUR","financial_currency":"EUR","summary_fr":"LANXESS Aktiengesellschaft, une société de produits chimiques spécialisés, se consacre au développement, à la fabrication et à la commercialisation d'intermédiaires chimiques, d'additifs et de produits de protection des consommateurs dans le monde entier. Elle opère à travers trois segments : Protection des consommateurs, Additifs spécialisés et Intermédiaires avancés. La société fournit des produits de protection des matériaux; désinfectants, solutions d'hygiène et de conservation; arômes et parfums; technologies de purification des liquides pour le traitement de l'eau et d'autres liquides; et précurseurs et intermédiaires pour les industries agrochimiques, pharmaceutiques et chimiques de spécialité."},"valuation":{"market_cap_yahoo":null,"shares_outstanding":null,"trailing_pe":null,"forward_pe":14.236226,"price_to_book":0.28872892,"ev_to_ebitda":10.478,"ev_to_revenue":0.554,"dividend_yield":0.0085,"payout_ratio":0.7047,"beta_yahoo":1.175},"targets":{"current_price":11.63,"mean":15.29231,"median":13.5,"high":30.0,"low":11.0,"n_analysts":13,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":1436853000,"ex_dividend":"2026-05-22","dividend_date":null},"holders":{"insiders_pct":0.01818,"institutions_pct":0.6426,"institutions_float_pct":0.65449995,"institutions_n":136,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":727,"value":8455,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"CAUSEWAY CAPITAL MANAGEMENT TRUST-CAUSEWAY INTERNATIONAL VALUE FUND","pct":0.051999997,"shares":4490724,"value":52227120,"date":"2026-06-30","chg":-0.47529998},{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0352,"shares":3040145,"value":35356886,"date":"2026-09-30","chg":0.1383},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0139999995,"shares":1206634,"value":14033153,"date":"2026-07-31","chg":0.0022},{"name":"HARRIS ASSOCIATES INVESTMENT TRT-Oakmark Intl Small Cap Fd.","pct":0.0121,"shares":1044300,"value":12145209,"date":"2026-06-30","chg":0.008},{"name":"Goldman Sachs TRT-Goldman Sachs Intl Small Cap Insights Fd.","pct":0.0106,"shares":913009,"valu