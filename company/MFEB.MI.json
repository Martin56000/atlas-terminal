{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:56:11+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:56:11+00:00"},"data":{"profile":{"name":"MFE-Mediaforeurope N.V.","sector":"Communication Services","industry":"Broadcasting","country":"Italy","city":"Milan","website":"https://www.mfemediaforeurope.com","employees":11021,"summary":"MFE-Mediaforeurope N.V. operates in the television industry in Italy and Spain. It is involved in the content production and third-party content acquisition; and content distribution for linear and non-linear, and free-to-air and pay-per-view television across various platforms and radio content. The company also engages in the advertising sale for television and radio operations through its concessionaires and online; and sells advertising space on managed media with cross-media coverage. In addition, it is involved in film production and distribution, licensing and merchandising, and advertising concessions of third-party publishing houses through Digitalia and Mediamond, as well as foreign media through Publieurope. The company was formerly known as Mediaset S.p.A. and changed its name to MFE-Mediaforeurope N.V. in November 2021. MFE-Mediaforeurope N.V. was incorporated in 1987 and is headquartered in Milan, Italy.","exchange":"Milan","currency":"EUR","financial_currency":"EUR","summary_fr":"MFE-Mediaforeurope N.V. opère dans le secteur de la télévision en Italie et en Espagne. Il est impliqué dans la production de contenu et l'acquisition de contenu par des tiers; et la distribution de contenu pour la télévision linéaire et non linéaire, et la télévision en clair et à la carte sur diverses plateformes et contenus radiophoniques. La société se livre également à la vente de publicité pour les opérations de télévision et de radio par le biais de ses concessionnaires et en ligne; et vend des espaces publicitaires sur des médias gérés avec une couverture cross-média."},"valuation":{"market_cap_yahoo":2056912640,"shares_outstanding":229732507,"trailing_pe":15.473684,"forward_pe":5.630027,"price_to_book":0.59048,"ev_to_ebitda":10.684,"ev_to_revenue":0.862,"dividend_yield":0.0752,"payout_ratio":0.0,"beta_yahoo":1.138},"targets":{"current_price":2.94,"mean":3.98571,"median":4.2,"high":4.65,"low":3.0,"n_analysts":7,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-07-20","dividend_date":null},"holders":{"insiders_pct":0.74574,"institutions_pct":0.08174,"institutions_float_pct":0.3215,"institutions_n":55,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":0.3715,"eps_low":0.369,"eps_high":0.374,"eps_year_ago":0.36873,"eps_n":2,"eps_growth":0.0075,"rev_avg":6387047760,"rev_low":6321353500,"rev_high":6445000000,"rev_year_ago":4031100000,"rev_n":4,"rev_growth":0.5844,"eps_trend_now":0.3715,"eps_trend_30d":0.44511,"eps_trend_90d":0.47595},{"period":"+1y","end_date":"2027-12-31","eps_avg":0.5222,"eps_low":0.39386,"eps_high":0.92,"eps_year_ago":0.3715,"eps_n":6,"eps_growth":0.4057,"rev_avg":6492179940,"rev_low":6296472250,"rev_high":6574000000,"rev_year_ago":6387047760,"rev_n":7,"rev_growth":0.0165,"eps_trend_now":0.5222,"eps_trend_30d":0.5317,"eps_trend_90d":0.56899}],"surprises":[],"recommendations":[{"strongBuy":3,"buy"