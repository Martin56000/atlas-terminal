{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T16:00:02+00:00","status":"ok","error":null,"last_success":"2026-10-21T16:00:02+00:00"},"data":{"profile":{"name":"MONETA Money Bank, a.s.","sector":"Financial Services","industry":"Banks - Regional","country":"Czech Republic","city":"Prague","website":"https://www.moneta.cz","employees":2433,"summary":"MONETA Money Bank, a.s., together with its subsidiaries, offers banking and financial products and services in the Czech Republic, Cyprus, the United States, the United Kingdom, and worldwide. It operates through Commercial Clients, Retail Clients, and Treasury/Other segments. Its deposit products include current, building saving, and savings accounts; term deposits; and transactional banking products such as payment services and debit cards. It also provides lending products, such as mortgages; unsecured lending products comprising consumer and auto loans, credit cards, personal overdrafts, building savings loans, and bridging loans; and commercial lending products that include working capital, investment loans, finance leases and loans, auto loans, and inventory financing, as well as financing of small businesses and entrepreneurs through guarantees, letters of credit, and foreign exchange transactions. In addition, the company intermediates additional payment protection insurance, which covers the customer's monthly loan payment in the event of unemployment, accident, or sickness; and acts as the intermediary to provide its customers with other insurance and investment products. Further, it is involved in the foreign exchange transactions, interest rate swaps, debt securities investment, equity investments, and other noninterest bearing assets activities, as well as provision of debit and credit cards. Additionally, the company offers domestic and foreign payments services, insurance and investment funds, merchant acquiring services, and treasury and trade finance products. It serves retail customers, small and medium-sized enterprises, corporate clients, and financial and public sector institutions. It operates through a network of branches and ATMs. The company was formerly known as GE Money Bank, a.s. and changed its name to MONETA Money Bank, a.s. in May 2016. MONETA Money Bank, a.s. was incorporated in 1998 and is based in Prague, the Czech Republic.","exchange":"Prague","currency":"CZK","financial_currency":"CZK"},"valuation":{"market_cap_yahoo":97652105216,"shares_outstanding":511000000,"trailing_pe":14.554456,"forward_pe":17.612904,"price_to_book":3.024883,"ev_to_ebitda":null,"ev_to_revenue":3.619,"dividend_yield":0.0602,"payout_ratio":0.8765,"beta_yahoo":0.127},"targets":{"current_price":191.1,"mean":187.4,"median":191.0,"high":225.0,"low":149.0,"n_analysts":8,"reco_mean":3.125,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-23"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":3406333330,"ex_dividend":"2026-04-24","dividend_date":"1970-08-22"},"holders":{"insiders_pct":0.53362,"institutions_pct":0.17976,"institutions_float_pct":0.38542998,"institutions_n":152,"institutions":[{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0211,"shares":10788569,"value":2061695601,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"FINANCIAL INVESTORS TRUST-Seafarer Overseas Growth and Income Fund","pct":0.0125,"shares":6400000,"value":1223040039,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0078,"shares":3998973,"value":764203764,"date":"2026-07-31","chg":-0.0044},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard Emerging Markets Stock Index Fd","pct":0.0070999996,"shares":3650200,"value":697553242,"date":"2026-07-31","chg":0.0239},{"name":"iShares, Inc.-iShares Core MSCI Emerging Markets ETF","pct":0.0058999998,"shares":3035058,"value":579999602,"date":"2026-08-31","chg":-0.0081},{"name":"iShares, Inc.-iShares 