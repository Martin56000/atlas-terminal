{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T15:55:58+00:00","status":"ok","error":null,"last_success":"2026-10-23T15:55:58+00:00"},"data":{"profile":{"name":"Nemetschek SE","sector":"Technology","industry":"Software - Application","country":"Germany","city":"Munich","website":"https://www.nemetschek.com","employees":4268,"summary":"Nemetschek SE provides software solutions for architecture, engineering, construction, operation, and media industries in Germany, the rest of Europe, the Americas, the Asia Pacific, and internationally. The company operates in four segments: Design, Build, Manage, and Media. The Design segment offers software solutions primarily under the Allplan, Graphisoft, and dRofus brands for architects, designers, engineers, structural engineers, specialist planners, and landscape designers, as well as developers and general contractors. This segment provides building information modeling (BIM) solutions for computer-aided design and engineering. The Build segment offers 5D BIM solutions, commercial enterprise resource planning solutions, and cloud-based workflow solutions under the Nevaris and Bluebeam brands to construction companies, developers, suppliers, general contractors, planning offices, architects, and civil engineers. The Manage segment provides software solutions for property, facility, and workplace management; building platforms for the operation and management of buildings under the Spacewell and Crem Solutions brands to property managers, facility managers, global real estate companies, banks, and insurance companies. The Media segment offers software solutions under the Maxon name, including 3D modeling, painting, animation, sculpting, and rendering solutions to create 3D motion graphics, architectural or product visualizations, graphics for computer games, medical illustrations, industrial designs, and visual effects for architects and designers, film and TV studios, advertising agencies, the video game industry, product and graphic designers, and freelancers. Nemetschek SE was founded in 1963 and is headquartered in Munich, Germany.","exchange":"XETRA","currency":"EUR","financial_currency":"EUR","summary_fr":"Nemetschek SE fournit des solutions logicielles pour les industries de l'architecture, de l'ingénierie, de la construction, de l'exploitation et des médias en Allemagne, dans le reste de l'Europe, en Amérique, en Asie-Pacifique et à l'international. La société opère dans quatre segments: Design, Build, Manage et Media. Le segment Design propose des solutions logicielles principalement sous les marques Allplan, Graphisoft et dRofus pour les architectes, les concepteurs, les ingénieurs, les ingénieurs structurels, les planificateurs spécialisés et les paysagistes, ainsi que les développeurs et les entrepreneurs généraux."},"valuation":{"market_cap_yahoo":8742652928,"shares_outstanding":115490794,"trailing_pe":35.5399,"forward_pe":26.650799,"price_to_book":8.577904,"ev_to_ebitda":24.986,"ev_to_revenue":7.036,"dividend_yield":0.0091,"payout_ratio":0.3192,"beta_yahoo":0.609},"targets":{"current_price":75.7,"mean":87.01471,"median":87.0,"high":115.0,"low":52.0,"n_analysts":17,"reco_mean":1.83333,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":0.57666,"eps_low":0.48,"eps_high":0.65403,"revenue_avg":371353280,"ex_dividend":"2026-05-22","dividend_date":null},"holders":{"insiders_pct":0.45074,"institutions_pct":0.29608,"institutions_float_pct":0.53906,"institutions_n":420,"institutions":[{"name":"Aristotle Capital Management, LLC","pct":0.0074,"shares":852964,"value":64569372,"date":"2026-06-30","chg":-0.058000002},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":3598,"value":272368,"date":"2026-06-30","chg":1.5978}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0073,"shares":846749,"value":64098896,"date":"2026-07-31","chg":0.019199999},{"name":"VANGUARD