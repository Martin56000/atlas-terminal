{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:55:36+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:55:36+00:00"},"data":{"profile":{"name":"Nordic Semiconductor ASA","sector":"Technology","industry":"Semiconductors","country":"Norway","city":"Trondheim","website":"https://www.nordicsemi.com","employees":1465,"summary":"Nordic Semiconductor ASA, a fabless semiconductor company, provides low power wireless connectivity solutions in Europe, the Americas, and the Asia Pacific. The company offers cellular IoT that comprises NB-IoT and LTE-M; non-terrestrial networks; Wi-Fi solutions; Bluetooth low energy System-on-Chip (SoC); Bluetooth direction finding solution; DECT NR+, a non-cellular radio standard; Thread, an IP-based wireless networking protocol solution; nRF52 and nRF51 wireless SoCs; and range extenders, as well as Bluetooth LE audio, Bluetooth mesh, and Zigbee products. It also provides Matter, a Connected Home over IP solution; Amazon sidewalk; multiprotocol SoCs; Bluetooth wireless technology; security solution; Edge AI; ANT solutions, including wireless multiprotocol SoCs supporting the ANT wireless protocol; and KNX IoT. In addition, the company offers power management integrated circuits (PMIC) comprising nPM1100 PMIC, nPM1300 PMIC, nPM2100, and nPM6001 PMIC; cloud services, such as location, security, and device management services; nRF Cloud solution; and application specific integrated circuits and related consulting services. Its products are used for consumer devices, including asset tracking, audio, education, HID, smart home and remotes, gaming, virtual reality and augmented reality products, and wearables; for industrial automation, such as automotive, beacons, building automation, professional lighting, transportation, retail, and smart agriculture and metering; and healthcare devices that include connected health and sports and fitness. Nordic Semiconductor ASA was founded in 1983 and is headquartered in Trondheim, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"USD"},"valuation":{"market_cap_yahoo":34851508224,"shares_outstanding":197795167,"trailing_pe":111.51898,"forward_pe":36.29562,"price_to_book":5.2498198,"ev_to_ebitda":620.559,"ev_to_revenue":45.114,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":0.921},"targets":{"current_price":176.2,"mean":196.09244,"median":185.0,"high":250.0,"low":136.479,"n_analysts":16,"reco_mean":2.4375,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":0.9556,"eps_low":0.589,"eps_high":1.138,"revenue_avg":2197589880,"ex_dividend":"2011-06-17","dividend_date":null},"holders":{"insiders_pct":0.098450005,"institutions_pct":0.5565,"institutions_float_pct":0.61727,"institutions_n":138,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":230,"value":40525,"date":"2026-06-30","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0124,"shares":2467713,"value":434811023,"date":"2026-07-31","chg":0.0001},{"name":"Artisan Partners Funds Inc.-Artisan International Small-Mid Fund","pct":0.0104,"shares":2081723,"value":366799586,"date":"2026-06-30","chg":-0.0013},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0083,"shares":1651360,"value":290969626,"date":"2026-06-30","chg":0.0119},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0067000003,"shares":1332541,"value":234793720,"date":"2026-08-31","chg":0.0049},{"name":"SPDR INDEX SHARES Fd.S-State Street SPDR PORT. Developed World ex-US E","pct":0.0037,"shares":745239,"value":131311109,"date":"2026-09-30","chg":0.0},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.0032,"shares":645758,"value":113782557,"date":"2026-07-31","chg":0.038900003},{"name":"iShares Trust-iShares MSCI EAFE Small-Cap ETF","pct":0.0032,"shares":632982,"value":111531426,"date":"2026-08-31","c