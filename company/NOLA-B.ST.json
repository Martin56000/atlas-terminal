{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:53:36+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:53:36+00:00"},"data":{"profile":{"name":"Nolato AB (publ)","sector":"Healthcare","industry":"Medical Devices","country":"Sweden","city":"Torekov","website":"https://www.nolato.com","employees":5343,"summary":"Nolato AB (publ) develops, manufactures, and sells plastic, silicone, and thermoplastic elastomer products in Europe, Asia, North America, and internationally. It operates through the Medical Solutions and Engineered Solutions segments. The company offers catheter balloons; breathing bags; non-conductive sealing and damping silicone products; primary plastic packaging for medicines; and crimp and dropper bottles. It also provides thermal heating pads, gap fillers, and paste under the Compatherm brand; Autolys M products, deep well plates, microtubes, PCR/qPCR products, pipettes and slim-line pipette tips, vial HP, and quality grades under the TreffLab by Nolato; and electromagnetic compatibility (EMC) products, including Compashield molded and extruded electromagnetic interference (EMI) shielding gaskets, Trishield, and MIL SPEC EMI shielding products. In addition, the company offers laboratory products, such as boxes with integrated lids; containers with hinged lids; sampling and transport tubes; spoons and cups; disposable tubes and containers; test tubes and ergonomic caps; and containers, vials, and slide tubes with push on lids. Further, it provides injection molding of plastic and silicone, injection blow molding, scientific and ceramic injection molding, dip and compression molding, and micro molding; extrusion and silicone sponge extrusion technologies; thermal management; decoration and cutting technologies; cleanroom production; assembly solutions; design and virtual prototyping solutions; and tool manufacturing. It serves medical technology, pharmaceutical, consumer electronics, telecom, automotive, hygiene, and other industrial sectors. The company was formerly known as Nordiska Latexfabriken i Torekov AB and changed its name to Nolato AB (publ) in 1982. Nolato AB (publ) was founded in 1938 and is headquartered in Torekov, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Nolato AB (publ) développe, fabrique et vend des élastomères plastiques, silicones et thermoplastiques en Europe, en Asie, en Amérique du Nord et à l’international. Elle opère à travers les segments Medical Solutions et Engineered Solutions. La société propose des ballons de cathéter, des sacs respiratoires, des produits en silicone d'étanchéité et d'amortissement non conducteurs, des emballages en plastique primaire pour les médicaments et des bouteilles à sertir et à compte-gouttes."},"valuation":{"market_cap_yahoo":14034746368,"shares_outstanding":241786942,"trailing_pe":20.84,"forward_pe":17.781569,"price_to_book":2.3504465,"ev_to_ebitda":10.448,"ev_to_revenue":1.608,"dividend_yield":0.0317,"payout_ratio":0.68,"beta_yahoo":null},"targets":{"current_price":52.1,"mean":66.0,"median":66.0,"high":69.0,"low":63.0,"n_analysts":2,"reco_mean":1.0,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":0.8,"eps_low":0.8,"eps_high":0.8,"revenue_avg":2600000000,"ex_dividend":"2026-05-07","dividend_date":null},"holders":{"insiders_pct":0.20472999,"institutions_pct":0.58343,"institutions_float_pct":0.73363,"institutions_n":78,"institutions":[{"name":"Legato Capital Management LLC","pct":0.0001,"shares":20081,"value":1046220,"date":"2022-06-30","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0111,"shares":2693224,"value":140316966,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.007900001,"shares":1921592,"value":100114940,"date":"2026-06-30","chg":0.0538},{"name":"iShares Trust-iShares 