{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:58:19+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:58:19+00:00"},"data":{"profile":{"name":"NTG Nordic Transport Group A/S","sector":"Industrials","industry":"Integrated Freight & Logistics","country":"Denmark","city":"Hvidovre","website":"https://ntg.com","employees":3143,"summary":"NTG Nordic Transport Group A/S, together with its subsidiaries, provides asset-light freight forwarding services through road, rail, air, and ocean in Denmark, Germany, the United States, Sweden, Finland, and internationally. The company operates through two segments, Road & Logistics and Air & Ocean. It offers road freight solutions, including full-loads, part loads, and groupage; special transport; project transport; temperature-controlled freight transport; and temperature-controlled freight transport, high-tech, furniture transport and logistics, automotive, cycling, textiles, sensitive and regulated goods, dangerous goods freight transport, powder, distribution, and express service. The company also provides ocean freight, such as port-to-port/door-to-door, full container load, less-than-container-load, short sea, buyer's consolidation, cross trade, project transport, charter customs clearance, temperature-controlled transport, and dangerous goods; and air freight comprising airport-to-airport/door-to-door, consolidation, direct shipments, temperature-controlled transport, full/part charter, onboard courier, and dangerous goods. In addition, it offers daily departures, day to day, express, and door to door services; project transportation, including RoRo, oversized cargo, break bulk/heavy loads, point to point/cross trade/third party logistics, vessel and project charter, dangerous goods, turnkey transport, and surveillance and reporting services; and project transport consulting services which include vessel load surveying, velles operations, packaging and securing control, export/import document control, customs clearance, heavy lifting and load planning, and reporting services. Further, the company provides furniture logistics; warehouse logistics; 4PL services; and multimodal freight transport services. NTG Nordic Transport Group A/S was founded in 1988 and is based in Hvidovre, Denmark.","exchange":"Copenhagen","currency":"DKK","financial_currency":"DKK"},"valuation":{"market_cap_yahoo":7069600256,"shares_outstanding":21553659,"trailing_pe":26.580227,"forward_pe":16.378569,"price_to_book":4.3683825,"ev_to_ebitda":14.077,"ev_to_revenue":0.771,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":1.061},"targets":{"current_price":328.0,"mean":336.42856,"median":330.0,"high":395.0,"low":285.0,"n_analysts":7,"reco_mean":1.28571,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-11-09"],"eps_avg":4.42,"eps_low":4.06,"eps_high":4.7,"revenue_avg":3274250000,"ex_dividend":null,"dividend_date":null},"holders":{"insiders_pct":0.25333,"institutions_pct":0.24476999,"institutions_float_pct":0.32782,"institutions_n":60,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":4.42,"eps_low":4.06,"eps_high":4.7,"eps_year_ago":2.8994,"eps_n":3,"eps_growth":0.5245,"rev_avg":3274250000,"rev_low":3188000000,"rev_high":3314000000,"rev_year_ago":2941000000,"rev_n":4,"rev_growth":0.113299996,"eps_trend_now":4.42,"eps_trend_30d":4.39667,"eps_trend_90d":4.5},{"period":"+1q","end_date":"2026-12-31","eps_avg":3.94333,"eps_low":3.74,"eps_high":4.19,"eps_year_ago":4.2252,"eps_n":3,"eps_growth":-0.066700004,"rev_avg":3120333330,"rev_low":3024000000,"rev_high":3198000000,"rev_year_ago":2884000000,"rev_n":3,"rev_growth":0.08189999,"eps_trend_now":3.94333,"eps_trend_30d":4.02333,"eps_trend_90d":4.085},{"period":"0y","end_date":"2026-12-31","eps_avg":15.61383,"eps_low":14.8,"eps_high":16.36,"eps_year_ago":11.2877,"eps_n":6,"eps_growth":0.3833,"rev_avg":12628782970,"rev_low":