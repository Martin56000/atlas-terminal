{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:54:15+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:54:15+00:00"},"data":{"profile":{"name":"Orkla ASA","sector":"Consumer Defensive","industry":"Packaged Foods","country":"Norway","city":"Oslo","website":"https://www.orkla.com","employees":17541,"summary":"Orkla ASA operates as an industrial investment company within brands and consumer-oriented businesses worldwide. It offers decorative paints, marine coatings, protective coatings, and powder coatings; frozen pizza, condiments, bread toppings, and ready-to-eat meals; bakery, ice cream, and plant-based products; and confectionery, biscuits, and salty snacks. The company also provides branded consumer health products, such as daily nutrition and oral health, wound care, and functional personal care under the Möller's, Jordan, and Salvequick brand names; spices and spice blends, ready-to-eat sweets, breakfast mixes, and other; and cleaning and personal hygiene products, such as detergents, cleaning equipment, and personal care products. In addition, it operates a franchised pizza business; offers paintbrushes, rollers, and other painting project consumables comprising sanding equipment, tape, protective gear, and cleaning products; and health and sports nutrition products. The company was founded in 1654 and is headquartered in Oslo, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"NOK","summary_fr":"Orkla ASA opère en tant que société d'investissement industriel au sein de marques et d'entreprises orientées vers le consommateur dans le monde entier. Il propose des peintures décoratives, des revêtements marins, des revêtements protecteurs et des revêtements en poudre; pizzas surgelées, condiments, garnitures de pain et repas prêts-à-manger; boulangerie, crème glacée et produits à base de plantes; et confiseries, biscuits et collations salées. La société fournit également des produits de santé grand public de marque, tels que la nutrition quotidienne et la santé bucco-dentaire, les soins des plaies et les soins personnels fonctionnels sous les marques Mller's, Jordan et Salvequick; des épices et des mélanges d'épices, des bonbons prêts-à-manger, des mélanges pour le petit-déjeuner et autres; et des produits de nettoyage et d'hygiène personnelle, tels que des détergents, du matériel de nettoyage et des produits de soins personnels.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":92791562240,"shares_outstanding":955137013,"trailing_pe":14.78691,"forward_pe":14.169822,"price_to_book":2.261406,"ev_to_ebitda":13.166,"ev_to_revenue":1.708,"dividend_yield":0.040999997,"payout_ratio":0.6088,"beta_yahoo":0.2},"targets":{"current_price":97.15,"mean":107.625,"median":99.5,"high":140.0,"low":89.0,"n_analysts":8,"reco_mean":3.0,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-06"],"eps_avg":1.69447,"eps_low":1.58235,"eps_high":1.92,"revenue_avg":17345517980,"ex_dividend":"2026-04-24","dividend_date":null},"holders":{"insiders_pct":0.05244,"institutions_pct":0.79972,"institutions_float_pct":0.84398,"institutions_n":354,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0001,"shares":120100,"value":11667715,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"First Eagle Funds-First Eagle Global Fund","pct":0.0161,"shares":16166787,"value":1570603381,"date":"2026-07-31","chg":0.0},{"name":"First Eagle Funds-First Eagle Overseas Fund","pct":0.012999999,"shares":13060096,"value":1268788346,"date":"2026-07-31","chg":0.0},{"name":"Fidelity Covington Trust-Fidelity High Dividend ETF","pct":0.0113,"shares":11278820,"value":1095737380,"date":"2026-09-30","chg":0.007900001},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0095999995,"shares":9609464,"value":933559442,"date":"2026-07-31","chg":-0.0175},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pc