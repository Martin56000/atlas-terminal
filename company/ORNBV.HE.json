{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:56:41+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:56:41+00:00"},"data":{"profile":{"name":"Orion Oyj","sector":"Healthcare","industry":"Drug Manufacturers - General","country":"Finland","city":"Espo","website":"https://www.orionpharma.com","employees":4000,"summary":"Orion Oyj develops, manufactures, and markets human and veterinary pharmaceuticals and active pharmaceutical ingredients (APIs) in Finland, Scandinavia, rest of Europe, North America, and internationally. It offers pharmaceutical products, which includes Nubeqa for the treatment of prostate cancer; Entacapone, Stalevo, Comtess, and Comtan to treat Parkinson's disease; Burana for inflammatory pain; Divina series for menopausal symptoms; Simdax for acute decompensated heart failure; Fareston for breast cancer; Quetiapine products for antipsychotic; Trexan for rheumatoid arthritis and cancer; Easyhaler product portfolio for asthma and COPD; and Dexdor, Precedex, and Dexmedetomidine products for human use. The company also provides Salmeterol/fluticasone Easyhaler, Budesonide/formoterol Easyhaler, Formoterol Easyhaler, Budesonide Easyhaler, Beclomet Easyhaler, and Buventol Easyhaler drugs for the treatment of asthma and chronic obstructive pulmonary disease. In addition, it offers veterinary drugs comprising Bonqat, Clevor, Domosedan, Domitor, Antisedan, Dexdomitor, Domosedan Gel, Sileo, and Tessie; APIs for generic compounds and proprietary products, as well as contract manufacturing services; and markets and sells drugs and products manufactured by other companies. Additionally, the company provides self-care products, including non-prescription medicines, cosmetics, dietary supplements, vitamins, and skincare products. It also offers its products online. The company has a licensing agreement with Tenax Therapeutics, Inc. to develop oral levosimendan (TNX-103) for pulmonary hypertension in heart failure with preserved ejection fraction (PH-HFpEF); and Bayer for the development and commercialisation of darolutamide Nubeqa. Orion Oyj was founded in 1917 and is headquartered in Espo, Finland.","exchange":"Helsinki","currency":"EUR","financial_currency":"EUR"},"valuation":{"market_cap_yahoo":12611895296,"shares_outstanding":108992933,"trailing_pe":21.546762,"forward_pe":18.918537,"price_to_book":9.974466,"ev_to_ebitda":15.669,"ev_to_revenue":6.046,"dividend_yield":0.020399999,"payout_ratio":0.4125,"beta_yahoo":0.28},"targets":{"current_price":89.85,"mean":77.33333,"median":80.5,"high":88.0,"low":55.0,"n_analysts":6,"reco_mean":2.16667,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-28"],"eps_avg":1.09922,"eps_low":1.01,"eps_high":1.24,"revenue_avg":538037500,"ex_dividend":"2026-10-19","dividend_date":null},"holders":{"insiders_pct":0.02629,"institutions_pct":0.45685002,"institutions_float_pct":0.46919,"institutions_n":340,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":485,"value":43577,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.014199999,"shares":1562870,"value":140423867,"date":"2026-07-31","chg":0.0164},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0094,"shares":1039129,"value":93365739,"date":"2026-06-30","chg":0.0257},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0075,"shares":825344,"value":74157157,"date":"2026-08-31","chg":0.0046},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.0055,"shares":600779,"value":53979992,"date":"2026-07-31","chg":0.0},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Intl Core Eqy. 2 PORT.","pct":0.0045,"shares":497917,"value":44737841,"date":"2026-07-31","chg":0.0},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.0039,"shares":429629,"value":38602164,"date":"2026-08-31","chg":0.0079000