{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:56:03+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:56:03+00:00"},"data":{"profile":{"name":"Outokumpu Oyj","sector":"Basic Materials","industry":"Steel","country":"Finland","city":"Helsinki","website":"https://www.outokumpu.com","employees":8205,"summary":"Outokumpu Oyj produces and sells various stainless-steel products in Finland, Germany, Italy, the United Kingdom, other European countries, North America, the Asia-Pacific, and internationally. It operates through Europe, the Americas, Ferrochrome, and Other operations segments. The company offers cold rolled coils, strips, and sheets; hot rolled coils, strips, and plates; quarto plates; precision strips; and specialized components, such as welded stainless-steel I-beams, H-beams, hollow-section tubes, bent profiles, duprof structural sections, hardened and customized press plates, suction roll shells, and blancs and disks. It also provides stainless steel powder which includes Supra 316L, Dura 17-4PH, Ultra 904L, Therma 253MA, Dura 4116, and Ni-free austenitic stainless-steel powder, ferritic grades as well as tailored product; and nickel-based alloys for environments in the process industry, oil and gas, and electric vehicles. In addition, the company offers cutting, polishing and brushing, welding, machining, plate bending and other services. Further, its products are used in various applications, including commercial kitchens, cooking, food industry, and home appliances; automotive and transportation; building and infrastructure; energy; marine; and heavy industries. Outokumpu Oyj was founded in 1910 and is headquartered in Helsinki, Finland.","exchange":"Helsinki","currency":"EUR","financial_currency":"EUR","summary_fr":"Outokumpu Oyj produit et vend divers produits en acier inoxydable en Finlande, en Allemagne, en Italie, au Royaume-Uni, dans d'autres pays européens, en Amérique du Nord, en Asie-Pacifique et à l'international. Il opère à travers l'Europe, les Amériques, Ferrochrome, et d'autres secteurs d'activité. La société propose des bobines, des bandes et des feuilles laminées à froid; des bobines, des bandes et des plaques laminées à chaud; des plaques quarto; des bandes de précision; et des composants spécialisés, tels que des poutres soudées en acier inoxydable, des poutres en H, des tubes à section creuse, des profilés pliés, des sections structurelles duprof, des plaques de presse durcies et personnalisées, des coquilles de rouleaux aspirants et des disques.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":2137226624,"shares_outstanding":471377716,"trailing_pe":null,"forward_pe":9.439736,"price_to_book":0.623059,"ev_to_ebitda":21.388,"ev_to_revenue":0.44,"dividend_yield":0.0301,"payout_ratio":0.2551,"beta_yahoo":1.469},"targets":{"current_price":4.534,"mean":5.85833,"median":5.75,"high":7.5,"low":4.0,"n_analysts":12,"reco_mean":2.25,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-06"],"eps_avg":0.06667,"eps_low":0.06,"eps_high":0.07,"revenue_avg":1549512920,"ex_dividend":"2026-10-14","dividend_date":null},"holders":{"insiders_pct":0.21959999,"institutions_pct":0.34682,"institutions_float_pct":0.44441003,"institutions_n":109,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0117,"shares":5341526,"value":24218478,"date":"2026-07-31","chg":0.0097},{"name":"HARTFORD MUTUAL FUNDS INC/CT-The Hartford International Value Fund","pct":0.0109,"shares":4991559,"value":22631728,"date":"2026-07-31","chg":-0.081199996},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0078,"shares":3576218,"value":16214572,"date":"2026-06-30","chg":0.0038},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0061000003,"shares":2764282,"value":12533254,"date":"2026-09-30","chg":0.013300001},{"name":"SCHWAB STRATEGIC TRUST-Schwab Fundament