{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:41:24+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:41:24+00:00"},"data":{"profile":{"name":"Oxford Instruments plc","sector":"Technology","industry":"Scientific & Technical Instruments","country":"United Kingdom","city":"High Wycombe","website":"https://www.oxinst.com","employees":1760,"summary":"Oxford Instruments plc provides scientific technology products and services for academic and commercial organizations in the United Kingdom, North America, China, Japan, Germany, Rest of Europe, Rest of Asia, and internationally. It operates through two segments: Imaging and Analysis and Advanced Technologies. The company offers atomic force microscopy; electron microscopy, such as BEX, EBSD, and EDS; light microscopy, including widefield microscopes, confocal microscopes, super resolution microscopes, and 3d/4d visualization software; nanoindentation; modular optical spectroscopy; nuclear magnetic resonance, such as benchtop NMR spectroscopy, and time domain NMR; confocal RAMAN microscopes, such as witec360  RAMAN imaging microscope, rise  RAMAN-SEM microscopes, and RAMAN-based particle analysis; and scientific imaging cameras. It also offers deposition tools, such as plasma enhanced chemical vapour deposition (PECVD), inductively coupled plasma chemical vapour deposition (ICPCVD), atomic layer deposition (ALD), and Ion beam deposition (IBD); etch tools, including inductively coupled plasma etching (ICP RIE), reactive ion etching (RIE), deep silicon etching (DSiE), atomic layer etching (ALE), and ion beam etching (IBE); and dilution fridges & low temperature solutions, such as x-ray, x-ray sources, and x-ray cameras. Its products are used in various industries, such as advanced manufacturing, agriculture and food, astronomy, automotive and aerospace, bio imaging and life science, chemical and catalysis, energy generation and storage, forensics and environment, geology, petrology, mining, metal, alloys, composites, ceramics, pharma, photonics, polymers, quantum technologies, semiconductors, microelectronics, and data storage. In addition, it offers contracts and agreements, spares, upgrades, training, application and product support, and live assist services. Oxford Instruments plc was founded in 1959 and is headquartered in High Wycombe, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"GBP"},"valuation":{"market_cap_yahoo":1400586112,"shares_outstanding":54753171,"trailing_pe":33.22078,"forward_pe":20.139036,"price_to_book":437.1155,"ev_to_ebitda":17.417,"ev_to_revenue":3.366,"dividend_yield":0.0092,"payout_ratio":0.2911,"beta_yahoo":1.029},"targets":{"current_price":2558.0,"mean":3227.143,"median":3300.0,"high":3500.0,"low":2840.0,"n_analysts":7,"reco_mean":2.375,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-10"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-07-09","dividend_date":null},"holders":{"insiders_pct":0.03512,"institutions_pct":0.72458,"institutions_float_pct":0.75095004,"institutions_n":125,"institutions":[],"funds":[{"name":"Fidelity Investment Trust-Fidelity Series International Small Cap Fund","pct":0.0344,"shares":1881600,"value":4813132800,"date":"2026-07-31","chg":0.2282},{"name":"Fidelity Investment TRT-Fidelity Intl Small Cap Opportunities Fd.","pct":0.023599999,"shares":1291613,"value":3303946054,"date":"2026-07-31","chg":0.5409},{"name":"Franklin Value Investors Trust-FRANKLIN SMALL CAP VALUE FUND","pct":0.014199999,"shares":777376,"value":1988527808,"date":"2026-07-31","chg":-0.40060002},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0139999995,"shares":768479,"value":1965769282,"date":"2026-07-31","chg":-0.0418},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0091,"shares":499733,"value":1278317014,"date":"2026-06-30","chg":-0