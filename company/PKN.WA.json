{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:58:33+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:58:33+00:00"},"data":{"profile":{"name":"Orlen S.A.","sector":"Energy","industry":"Oil & Gas Integrated","country":"Poland","city":"Plock","website":"https://www.orlen.pl","employees":65889,"summary":"Orlen S.A. operates in refining, petrochemical, energy, retail, gas, and upstream business. It engages in the processing and wholesale of refinery products, such as crude oil; production and sale of fuel, oil, chemicals, and petrochemicals, as well as provision of supporting services; production, distribution, and sale of electricity and heat from conventional and renewable energy sources comprising solar photovoltaics, as well as natural gas; trading of electricity; exploration and extraction of mineral resources; exploration, production, and import of natural gas; and trading and storage of gas and liquid gas. The company is also involved in the exploration, recognition, and extraction of hydrocarbons; fuel station activities; and provision of transportation, maintenance and overhaul, laboratory, security, design, administrative, courier, insurance, and financial services, as well as press distribution, and media activities, such as newspapers and websites. It offers petrol, diesel, LPG, and biofuels; aviation and marine fuels; heating oils; aromatics, including phenol, benzene, paraxylene, purified terephthalic acid, benzene-toulene fraction, and naphthalene concentrate; olefins; polyolefins comprising polyethylene; plastics, including polyvinyl chloride polanvil, compounds creovil, and PVC neralit; glycols; nitrogen fertilizers; and other products, such as acetone, ethylene oxide, masterbatch, advanced technical carbon black Chezacarb, caprolactam, soda lye, and sodium hypochlorite. In addition, the company provides base, car and motorbike, truck, marine, industrial, and agricultural oils, as well as paraffin and solvents; table, pickling, iodized table, feed, scrap, and industrial salt, as well as industrial salt brine and dishwasher salt granules; and bitumen. The company was formerly known as Polski Koncern Naftowy ORLEN Spólka Akcyjna and changed its name to Orlen S.A. in July 2023. The company was founded in 1999 and is headquartered in Plock, Poland.","exchange":"Warsaw","currency":"PLN","financial_currency":"PLN"},"valuation":{"market_cap_yahoo":179876364288,"shares_outstanding":1160942049,"trailing_pe":8.555494,"forward_pe":13.711504,"price_to_book":1.2153682,"ev_to_ebitda":3.798,"ev_to_revenue":0.678,"dividend_yield":0.053200003,"payout_ratio":1.3060001,"beta_yahoo":0.454},"targets":{"current_price":154.94,"mean":156.39091,"median":165.0,"high":185.0,"low":103.0,"n_analysts":11,"reco_mean":2.45455,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":5.86685,"eps_low":5.65384,"eps_high":6.07986,"revenue_avg":72226309460,"ex_dividend":"2026-06-17","dividend_date":null},"holders":{"insiders_pct":0.499,"institutions_pct":0.18697001,"institutions_float_pct":0.3732,"institutions_n":250,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0028,"shares":1215610,"value":188346616,"date":"2026-06-30","chg":1.0},{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0005,"shares":193596,"value":29995764,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0201,"shares":8600636,"value":1332582562,"date":"2026-07-31","chg":0.0097},{"name":"iShares, Inc.-iShares Core MSCI Emerging Markets ETF","pct":0.0155,"shares":6626890,"value":1026770352,"date":"2026-08-31","chg":0.0092},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.013300001,"shares":5696843,"value":882668868,"date":"2026-06-30","chg":0.0109},{"name":"iShares Trust-iShares MSCI Poland ETF","pct":0.0066000004,"shares":2838520,"value":439800295,"date