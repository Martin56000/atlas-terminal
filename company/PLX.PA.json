{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T06:44:35+00:00","status":"ok","error":null,"last_success":"2026-10-22T06:44:35+00:00"},"data":{"profile":{"name":"Pluxee N.V.","sector":"Industrials","industry":"Specialty Business Services","country":"France","city":"Issy-les-Moulineaux","website":"https://www.pluxeegroup.com","employees":5600,"summary":"Pluxee N.V. offers employee benefits and engagement solutions services in France, Latin America, Continental Europe, and internationally. The company provides employee benefits comprising meal, food, gift, mobility, training, insurance, and wellness benefits as well as engagement solutions; health, mental and physical well-being, leisure and culture, hybrid work, training, and uniforms; and other products and services, including rewards and recognition, public benefits, and fuel, fleet and expense management solutions. Its products are distributed through pre-paid cards, unreimbursed cards, digital solutions, paper vouchers. Pluxee N.V. was formerly known as Sodexo Asset Management 2 B.V. and changed its name to Pluxee N.V. in December 2023. The company was incorporated in 2022 and is headquartered in Issy-les-Moulineaux, France.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"Pluxee N.V. offre des services d’avantages sociaux et de solutions d’engagement en France, en Amérique latine, en Europe continentale et à l’international. La société offre aux employés des avantages sociaux comprenant des repas, de la nourriture, des cadeaux, de la mobilité, de la formation, des assurances et des avantages pour le bien-être ainsi que des solutions d'engagement; des solutions de santé, de bien-être mental et physique, de loisirs et de culture, de travail hybride, de formation et d'uniformes; et d'autres produits et services, y compris des récompenses et reconnaissance, des avantages publics et des solutions de gestion du carburant, de la flotte et des dépenses. Ses produits sont distribués via des cartes prépayées, des cartes non remboursées, des solutions numériques, des bons papier."},"valuation":{"market_cap_yahoo":2051323008,"shares_outstanding":137396054,"trailing_pe":10.588653,"forward_pe":9.773117,"price_to_book":5.3435936,"ev_to_ebitda":2.001,"ev_to_revenue":0.712,"dividend_yield":0.0252,"payout_ratio":0.26950002,"beta_yahoo":0.77},"targets":{"current_price":14.93,"mean":15.87857,"median":15.75,"high":22.0,"low":10.5,"n_analysts":14,"reco_mean":2.92857,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":321000000,"ex_dividend":"2025-12-19","dividend_date":null},"holders":{"insiders_pct":0.48076,"institutions_pct":0.27815,"institutions_float_pct":0.5357,"institutions_n":111,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":440,"value":6569,"date":"2024-12-31","chg":-0.0638}],"funds":[{"name":"Artisan Partners Funds Inc.-Artisan International Value Fund","pct":0.0919,"shares":12990509,"value":193948303,"date":"2026-06-30","chg":0.0559},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0077,"shares":1093106,"value":16320072,"date":"2026-07-31","chg":-0.0573},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0050999997,"shares":716086,"value":10691164,"date":"2026-06-30","chg":-0.0385},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0046,"shares":652157,"value":9736704,"date":"2026-08-31","chg":0.0053},{"name":"MFS Series Trust V-MFS International New Discovery Fund","pct":0.0042,"shares":600126,"value":8959881,"date":"2026-06-30","chg":-0.0217},{"name":"iShares Trust-iShares MSCI EAFE Small-Cap ETF","pct":0.0021,"shares":292407,"value":4365636,"date":"2026-08-31","chg":-0.0577},{"name":"Capital Group International Core Equity ETF","pct":0.0019,"shares":272716,"value":4071649,"date":"2026-05-31","chg":0.2787},{"name":"VANGUARD In