{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:58:05+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:58:05+00:00"},"data":{"profile":{"name":"Royal Unibrew A/S","sector":"Consumer Defensive","industry":"Beverages - Brewers","country":"Denmark","city":"Faxe","website":"https://www.royalunibrew.com","employees":4006,"summary":"Royal Unibrew A/S engages in the production of beverages in Denmark, Germany, Norway, Sweden, Italy, the Netherlands, France, Finland, Lithuania, Latvia, Estonia, Belgium, Luxembourg, and internationally. It offers soft drinks under the Faxe Kondi, Jaffa, Lemon Soda, Lorina, Royal Club, Fonti di Crodo, Adelhardt, Frem, Rebæl, Crystal Clear, Sisi, Sourcy Vitamin Water, Borg, Hansa, CB, and Pommac brands, as well as other partner brands. The company also provides energy drinks under the Faxe Kondi Booster, CULT, Crazy Tiger, Lemon Soda Energy, Jaffa Booster, and ED energy brands; water under the Novelle, Egekilde, Sourcy, Vichy Original, Olden, Mangali, and other partner brands; and malt beverages under the Vitamalt, Supermalt, and Powermalt brands. In addition, it offers beers under the Ceres Italy, Faxe, Royal, Hansa, Anarkist, Lapin Kulta, Amsterdam, Bauskas, Albani, Too Old To Die Young, Slots, Fuglsang, Thor, Nørrebro Bryghus, Schiøtz, Ceres Denmark, Borg, Kalnapilis, Helsinki Bryggeri, Tanker, Vilkmergés, Aura, Nøgne Ø, CB, Madonas Alus, Lielvardes, Frederikstad, Karjala, Lahden Erikois, Maltti, Lacplesis and other partner brands. Further, the company provides ready-to-drink products, cocktails, and ciders under the Original Long Drink, Grevens, Shaker, Tempt Cider, GiG Drinks, Mokai, Nohrlund, Happy Joe, Hartwall Seltzer, Hartwall Cocktails, Hansa Hard Seltzer, Urban Cocktails, Royale Cocktail Co., Lielvardes Sidrs, Vilkmerges Sidras, Strongbow, and other partner brands. Additionally, it offers juice under the Cido, Adelhardt, Looza, Pagoi, and Ranja brands; enhanced beverages under the Faxe Kondi Pro, Hartwall Sport, Cido Hydrate+, Sourcy Vitamin water, and Gatorda; and tea and coffee under partner brands. The company was formerly known as Bryggerigruppen A/S and changed its name to Royal Unibrew A/S in 2005. Royal Unibrew A/S was founded in 1901 and is headquartered in Faxe, Denmark.","exchange":"Copenhagen","currency":"DKK","financial_currency":"DKK"},"valuation":{"market_cap_yahoo":20807763968,"shares_outstanding":47161747,"trailing_pe":13.492354,"forward_pe":11.717974,"price_to_book":3.3974528,"ev_to_ebitda":9.186,"ev_to_revenue":1.739,"dividend_yield":0.0366,"payout_ratio":0.4893,"beta_yahoo":0.371},"targets":{"current_price":441.2,"mean":489.26666,"median":490.0,"high":570.0,"low":420.0,"n_analysts":15,"reco_mean":2.6,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-11"],"eps_avg":12.22207,"eps_low":12.04927,"eps_high":12.4611,"revenue_avg":4319399500,"ex_dividend":"2026-04-30","dividend_date":null},"holders":{"insiders_pct":0.00217,"institutions_pct":0.43338,"institutions_float_pct":0.43433,"institutions_n":141,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0002,"shares":10809,"value":4768930,"date":"2022-12-31","chg":0.1499}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0146,"shares":720473,"value":317872696,"date":"2026-07-31","chg":-0.0128999995},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0095999995,"shares":474422,"value":209314992,"date":"2026-06-30","chg":-0.0063},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0073,"shares":360067,"value":158861564,"date":"2026-08-31","chg":0.0053},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.0056,"shares":274075,"value":120921893,"date":"2026-07-31","chg":0.0},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Intl Core Eqy. 2 PORT.","pct":0.0047,"shares":231059,"value":101943233,"date":"2026-07-31","chg":-0.