{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-11-12T16:53:34+00:00","status":"ok","error":null,"last_success":"2026-11-12T16:53:34+00:00"},"data":{"profile":{"name":"Rheinmetall AG","sector":"Industrials","industry":"Aerospace & Defense","country":"Germany","city":"Düsseldorf","website":"https://www.rheinmetall.com","employees":30845,"summary":"Rheinmetall AG provides mobility and security technologies in Germany, Rest of Europe, North, Middle, and South America, Asia and the Near East, and internationally. The company operates through the Vehicle Systems, Weapon and Ammunition, and Electronic Solutions segments. Its Vehicle Systems segment offers combat, logistics, support, and special vehicles, including armored tracked vehicles, CBRN protection systems, artillery, turret systems, and wheeled logistics and tactical vehicles. The Weapon and Ammunition segment provides firepower and protection solutions, such as weapons and ammunition, protection systems, propellants, and international projects and services. Its Electronic Solutions segment offers a chain of systems network, such as sensors, networking platforms, automated connected effectors for soldiers, cyberspace protection solutions, and training and simulation solutions. The company's products include air defense, soldier, and fire control systems; radar technology; and command, control and reconnaissance systems, as well as simulations for the army, air force, navy, and civil applications. It also engages in the aftermarket activities. The company was formerly known as Rheinmetall Berlin AG and changed its name to Rheinmetall AG in 1996. Rheinmetall AG was founded in 1889 and is headquartered in Düsseldorf, Germany.","exchange":"XETRA","currency":"EUR","financial_currency":"EUR","summary_fr":"Rheinmetall AG fournit des technologies de mobilité et de sécurité en Allemagne, dans le reste de l'Europe, en Amérique du Nord, au Moyen-Orient et en Amérique du Sud, en Asie et au Proche-Orient, ainsi qu'à l'international. La société opère à travers les secteurs des systèmes de véhicules, des armes et munitions et des solutions électroniques. Son segment Vehicle Systems propose des véhicules de combat, de logistique, de soutien et spéciaux, y compris des véhicules blindés à chenilles, des systèmes de protection CBRN, de l'artillerie, des systèmes de tourelles et des véhicules tactiques et logistiques à roues."},"valuation":{"market_cap_yahoo":36055744512,"shares_outstanding":46668063,"trailing_pe":27.18508,"forward_pe":15.509369,"price_to_book":6.7500153,"ev_to_ebitda":16.275,"ev_to_revenue":3.32,"dividend_yield":0.0135,"payout_ratio":0.3976,"beta_yahoo":0.449},"targets":{"current_price":772.6,"mean":1375.091,"median":1310.0,"high":2100.0,"low":900.0,"n_analysts":22,"reco_mean":1.72727,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":16.14259,"eps_low":16.14259,"eps_high":16.14259,"revenue_avg":4824000000,"ex_dividend":"2026-05-13","dividend_date":null},"holders":{"insiders_pct":0.016490001,"institutions_pct":0.46063,"institutions_float_pct":0.46835,"institutions_n":658,"institutions":[{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0001,"shares":3570,"value":2758181,"date":"2026-09-30","chg":0.0},{"name":"Financial Gravity Companies, Inc.","pct":0.0,"shares":20,"value":15451,"date":"2026-06-30","chg":0.0},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":632,"value":488283,"date":"2026-06-30","chg":0.0276},{"name":"Gamma Investing LLC","pct":0.0,"shares":40,"value":30903,"date":"2026-09-30","chg":0.0},{"name":"Ascentis Independent Advisors","pct":0.0,"shares":3,"value":2317,"date":"2026-09-30","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0145000005,"shares":674668,"value":521248480,"date":"2026-07-31","chg":0.0224},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0095999995,"shar