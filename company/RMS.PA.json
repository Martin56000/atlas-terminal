{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T07:38:05+00:00","status":"ok","error":null,"last_success":"2026-10-29T07:38:05+00:00"},"data":{"profile":{"name":"Hermès International Société en commandite par actions","sector":"Consumer Cyclical","industry":"Luxury Goods","country":"France","city":"Paris","website":"https://finance.hermes.com","employees":27107,"summary":"Hermès International Société en commandite par actions engages in the production, wholesale, and retail of various goods. The company offers leather goods and saddlery, such as bags for men and women, travel articles, small leather goods and accessories, saddles, bridles, and various equestrian products and clothing; ready-to-wear garments for men and women; and accessories, including jewelry, belts, hats, gloves, internet of things products, and shoes. It also provides silk and textiles for men and women; art of living and tableware products; beauty and perfume products; and watches. In addition, the company is involved in weaving, engraving, printing, dyeing, finishing, and producing textiles; purchasing, tanning, dyeing, finishing, and selling tanneries and precious leathers; and creating and producing of metal parts. It sells its products through a network of stores in France, rest of Europe, Japan, the Asia Pacific, the Americas, and the Middle East, as well as sells watches, perfumes, and tableware through a network of specialized stores. The company was founded in 1837 and is headquartered in Paris, France. Hermès International Société en commandite par actions is a subsidiary of H51 SAS.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"Hermès International Société en commandite par actions se consacre à la production, à la vente en gros et au détail de divers produits. La société propose des articles de maroquinerie et de sellerie, tels que des sacs pour hommes et femmes, des articles de voyage, de la petite maroquinerie et des accessoires, des selles, des brides et divers produits et vêtements équestres; des vêtements de prêt-à-porter pour hommes et femmes; et des accessoires, y compris des bijoux, des ceintures, des chapeaux, des gants, des produits Internet des objets et des chaussures. Il fournit également de la soie et des textiles pour les hommes et les femmes; art de vivre et articles de table; produits de beauté et de parfum; et montres."},"valuation":{"market_cap_yahoo":131914424320,"shares_outstanding":104735548,"trailing_pe":29.290697,"forward_pe":26.201777,"price_to_book":6.9348855,"ev_to_ebitda":17.275,"ev_to_revenue":7.557,"dividend_yield":0.014199999,"payout_ratio":0.4186,"beta_yahoo":1.038},"targets":{"current_price":1259.5,"mean":1554.0869,"median":1500.0,"high":1920.0,"low":1150.0,"n_analysts":23,"reco_mean":2.47826,"reco_key":"buy"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":4349000000,"ex_dividend":"2026-04-21","dividend_date":null},"holders":{"insiders_pct":0.66982,"institutions_pct":0.10425,"institutions_float_pct":0.31573,"institutions_n":823,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":449,"value":565515,"date":"2026-06-30","chg":-0.0154},{"name":"Leo H. Evart, Inc.","pct":0.0,"shares":29,"value":36525,"date":"2026-06-30","chg":-0.275},{"name":"Generali Investments Cee, Investicni Spolecnost, A.s.","pct":0.0,"shares":2126,"value":2677697,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0047999998,"shares":502259,"value":632595210,"date":"2026-07-31","chg":0.0083},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0032,"shares":334014,"value":420690633,"date":"2026-06-30","chg":0.0145000005},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0025,"shares":260180,"value":327696710,"date":"2026-09-30","chg":0.0375},{"name":"VANGUARD WORLD FUND-Vanguard In