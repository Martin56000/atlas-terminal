{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:40:22+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:40:22+00:00"},"data":{"profile":{"name":"Rentokil Initial plc","sector":"Industrials","industry":"Specialty Business Services","country":"United Kingdom","city":"Crawley","website":"https://www.rentokil-initial.com","employees":63388,"summary":"Rentokil Initial plc, together with its subsidiaries, provides route-based services in North America, Europe, the United Kingdom, Asia, the Middle East, North Africa, Turkey, and Pacific. The company offers a range of pest control services for rodents, and flying and crawling insects, as well as other forms of wildlife management. It provides hygiene services, including the provision and maintenance of products, such as soap and hand sanitizer dispensers, hand dryers, air care and purification, cubicle and surface sanitizers, feminine hygiene units, toilet paper dispensers, and floor protection mats. In addition, the company engages in the supply and laundering of garments for commercial organizations. Further, the company provides a range of specialist cleaning services, such as graffiti removal, deep cleaning of kitchens and washrooms, trauma cleaning, and flood or fire damage cleaning, as well as specialist deep cleaning services. Rentokil Initial plc was founded in 1903 and is headquartered in Crawley, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"USD","summary_fr":"Rentokil Initial plc, avec ses filiales, fournit des services de routage en Amérique du Nord, en Europe, au Royaume-Uni, en Asie, au Moyen-Orient, en Afrique du Nord, en Turquie et dans le Pacifique. La société offre une gamme de services de lutte antiparasitaire pour les rongeurs, les insectes volants et rampants, ainsi que d'autres formes de gestion de la faune. Il fournit des services d'hygiène, y compris la fourniture et l'entretien de produits, tels que des distributeurs de savon et de désinfectant pour les mains, des sèche-mains, des soins et de la purification de l'air, des désinfectants pour les cabines et les surfaces, des unités d'hygiène féminines, des distributeurs de papier toilette et des tapis de protection des sols."},"valuation":{"market_cap_yahoo":8731352064,"shares_outstanding":2516239885,"trailing_pe":38.555553,"forward_pe":15.333666,"price_to_book":212.81079,"ev_to_ebitda":9.93,"ev_to_revenue":1.743,"dividend_yield":0.0274,"payout_ratio":0.97160006,"beta_yahoo":0.452},"targets":{"current_price":347.0,"mean":442.54733,"median":418.28964,"high":629.4748,"low":344.0082,"n_analysts":19,"reco_mean":1.73684,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-07-30"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":1902000000,"ex_dividend":"2026-08-13","dividend_date":null},"holders":{"insiders_pct":0.02765,"institutions_pct":1.01099,"institutions_float_pct":1.03974,"institutions_n":373,"institutions":[{"name":"Aristotle Capital Management, LLC","pct":0.0034999999,"shares":8808169,"value":3056434643,"date":"2026-06-30","chg":-0.066199996},{"name":"Chickasaw Capital Management, LLC","pct":0.0,"shares":64350,"value":22329450,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"AMERICAN FUNDS INSURANCE SERIES-Eupac Fund","pct":0.0223,"shares":56277335,"value":19528235245,"date":"2026-09-30","chg":17.6915},{"name":"BLACKROCK EQUITY DIVIDEND FUND","pct":0.0166,"shares":41925251,"value":14548062097,"date":"2026-07-31","chg":-0.0456},{"name":"AIM Sector Fd.s -INVESCO VALUE OPPORTUNITIES Fd.","pct":0.0150999995,"shares":38153696,"value":13239332512,"date":"2026-07-31","chg":0.2171},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.014400001,"shares":36327694,"value":12605709818,"date":"2026-07-31","chg":-0.0099},{"name":"First Eagle Funds-First Eagle Global Fund","pct":0.014099999,"shares":35712281,"value":12392161507,"date":"2026-07-31","chg":3.1726},{"name