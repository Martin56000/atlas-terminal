{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:56:13+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:56:13+00:00"},"data":{"profile":{"name":"Rai Way S.p.A.","sector":"Communication Services","industry":"Telecom Services","country":"Italy","city":"Rome","website":"https://www.raiway.it","employees":600,"summary":"Rai Way S.p.A. operates as a digital infrastructure operator and service provider in Italy. The company offers broadcasting services, such as local broadcasting, and mobility and network services; and connectivity services. It also provides content delivery network services, including distribution of live and on-demand video content via protocols; Storage availability for VoD content within catalogue; transcoding service to adapt live and vod content to any device and format; protection of origin from requests for content coming from CDN caches; secure storage of live streams in the CDN's storage; and dashboard to monitor CDN services and traffic. In addition, the company offers colocation, virtual private cloud, cloud object storage, and certifications; tower hosting for TV, FM and DAB+, MNO operators, FWA, and public authorities; and on-demand integrated solutions. The company was founded in 1924 and is based in Rome, Italy. Rai Way S.p.A. operates as a subsidiary of Rai Radiotelevisione italiana SpA.","exchange":"Milan","currency":"EUR","financial_currency":"EUR","summary_fr":"Rai Way S.p.A. opère en tant qu’opérateur d’infrastructure numérique et fournisseur de services en Italie. La société offre des services de radiodiffusion, tels que la radiodiffusion locale, et des services de mobilité et de réseau; et des services de connectivité. Il fournit également des services de réseau de diffusion de contenu, y compris la distribution de contenu vidéo en direct et à la demande via des protocoles; Disponibilité de stockage pour le contenu VoD dans le catalogue; Service de transcodage pour adapter le contenu en direct et vod à tout appareil et format; Protection de l'origine contre les demandes de contenu provenant de caches CDN; Stockage sécurisé des flux en direct dans le stockage du CDN; et tableau de bord pour surveiller les services et le trafic CDN."},"valuation":{"market_cap_yahoo":1150541440,"shares_outstanding":268504421,"trailing_pe":13.82258,"forward_pe":12.5922,"price_to_book":5.993007,"ev_to_ebitda":7.966,"ev_to_revenue":4.61,"dividend_yield":0.0773,"payout_ratio":1.0645,"beta_yahoo":0.436},"targets":{"current_price":4.285,"mean":6.18333,"median":6.15,"high":7.2,"low":5.2,"n_analysts":6,"reco_mean":2.0,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-11"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":72600000,"ex_dividend":"2026-05-18","dividend_date":null},"holders":{"insiders_pct":0.6497,"institutions_pct":0.15525,"institutions_float_pct":0.44319,"institutions_n":95,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":72600000,"rev_low":72600000,"rev_high":72600000,"rev_year_ago":70900000,"rev_n":1,"rev_growth":0.024,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":"2026-12-31","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":73900000,"rev_low":73900000,"rev_high":73900000,"rev_year_ago":71600000,"rev_n":1,"rev_growth":0.0321,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":0.33471,"eps_low":0.33,"eps_high":0.34,"eps_year_ago":0.3371,"eps_n":4,"eps_growth":-0.0070999996,"rev_avg":290012220,"rev_low":289800000,"rev_high":290257000,"rev_year_ago":282800000,"rev_n":4,"rev_growth":0.0255,"eps_trend_now":0.33471,"eps_trend_30d":0.336,"eps_trend_90d":0.328},{"period":"+1y","end_date":"2027-12