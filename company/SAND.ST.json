{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:52:28+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:52:28+00:00"},"data":{"profile":{"name":"Sandvik AB (publ)","sector":"Industrials","industry":"Specialty Industrial Machinery","country":"Sweden","city":"Stockholm","website":"https://www.home.sandvik","employees":42831,"summary":"Sandvik AB (publ), an engineering company, provides products and solutions for mining and rock excavation, metal cutting, and materials technology worldwide. The company offers mining and rock excavation equipment, including drill rigs and bolters, underground loaders and trucks, mechanical cutting equipment, rock tools and rock drills, and mining automation; rock processing equipment, such as crushers, screens, hydraulic breakers, demolition tools, and breaker booms. It provides cutting tools and tooling systems, and digital solutions and software; metal powder for additive manufacturing, and products made from controlled expansion alloys; and tungsten powders, as well as recycling services of secondary tungsten raw materials. It serves aerospace, automotive, mining, general engineering, infrastructure, and other industries. Sandvik AB (publ) was founded in 1862 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Sandvik AB (publ), une société d'ingénierie, fournit des produits et des solutions pour l'extraction minière et l'excavation de roches, la coupe de métaux et la technologie des matériaux dans le monde entier. La société offre de l'équipement d'extraction minière et d'excavation de roches, y compris des engins de forage et des boulonneuses, des chargeuses et des camions souterrains, de l'équipement de coupe mécanique, des outils pour la roche et des perceuses de roches, et de l'équipement de traitement de la roche, comme des concasseurs, des écrans, des brise-roches hydrauliques, des outils de démolition et des rampes de brise-roches. Il fournit des outils de coupe et des systèmes d'outillage, des solutions numériques et des logiciels; poudre métallique pour la fabrication additive, et des produits fabriqués à partir d'alliages d'expansion contrôlés; et poudres de tungstène, ainsi que des services de recyclage des matières premières de tungstène secondaires."},"valuation":{"market_cap_yahoo":450199093248,"shares_outstanding":1254385923,"trailing_pe":23.596317,"forward_pe":26.389704,"price_to_book":4.105186,"ev_to_ebitda":15.418,"ev_to_revenue":3.608,"dividend_yield":0.0165,"payout_ratio":0.39470002,"beta_yahoo":1.304},"targets":{"current_price":358.9,"mean":395.85715,"median":405.0,"high":465.0,"low":290.0,"n_analysts":21,"reco_mean":2.38095,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":5.64461,"eps_low":5.13845,"eps_high":6.28,"revenue_avg":41221320060,"ex_dividend":"2026-04-29","dividend_date":null},"holders":{"insiders_pct":0.18474,"institutions_pct":0.49640998,"institutions_float_pct":0.6089,"institutions_n":502,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":8388,"value":3010453,"date":"2026-06-30","chg":-0.047}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0121,"shares":15126907,"value":5429046829,"date":"2026-07-31","chg":0.0038},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.008,"shares":10021303,"value":3596645585,"date":"2026-06-30","chg":0.006},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0063,"shares":7841014,"value":2814139876,"date":"2026-09-30","chg":0.0117999995},{"name":"T. ROWE PRICE Intl Fd.S, INC.-T. Rowe Price Overseas Stock Fd.","pct":0.0044,"shares":5523477,"value":1982375861,"date":"2026-07-31","chg":-0.0276},{"name":"TR PRICE-Price (T.Rowe) International Core Equity Trust","pct":0.0032,"shares":3987168,"value":1430994570,"date":"2026-06-30","chg":-0.17969999},{"name":"Fide