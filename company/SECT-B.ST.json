{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:54:36+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:54:36+00:00"},"data":{"profile":{"name":"Sectra AB (publ)","sector":"Healthcare","industry":"Medical Devices","country":"Sweden","city":"Linköping","website":"https://sectra.com","employees":1403,"summary":"Sectra AB (publ) provides solutions for medical IT and cybersecurity sectors in Sweden, the United Kingdom, the United States, rest of Europe, and internationally. The company operates through Imaging IT Solutions, Secure Communications, Business Innovation, and Other Operations. The Imaging IT Solutions segment develops and sells medical IT systems and services for diagnostics, managing, archiving, presenting, and communicating various types of medical images and patient information, as well as for operational follow-up and radiation dose monitoring; and maintenance in the form of support, system monitoring, and consulting services. The Secure Communications segment develops and sells products and services for secure voice and data communications, and project-based development, as well as security and threat analyses, and system monitoring services for control systems. The Business Innovation segment develops and sells IT systems for planning and monitoring orthopedic surgery; products for medical education and research projects; and IT support services for precision diagnostics in cancer care. The Other Operations is involved in the property management activities. It serves hospitals and private clinic chains. Sectra AB (publ) was incorporated in 1957 and is headquartered in Linköping, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK"},"valuation":{"market_cap_yahoo":63657336832,"shares_outstanding":179564029,"trailing_pe":102.608696,"forward_pe":98.333336,"price_to_book":27.419086,"ev_to_ebitda":74.48,"ev_to_revenue":16.157,"dividend_yield":0.004,"pay