{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:53:01+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:53:01+00:00"},"data":{"profile":{"name":"Securitas AB (publ)","sector":"Industrials","industry":"Security & Protection Services","country":"Sweden","city":"Stockholm","website":"https://www.securitas.com","employees":322000,"summary":"Securitas AB (publ) provides security services in North America, Europe, Latin America, Africa, the Middle East, Asia, and Australia. The company operates through three segments: Securitas North America, Securitas Europe, and Securitas Ibero-America. It provides intelligence services, such as risk intelligence; safety and security services, including aviation security, fire and safety services, mobile security services, and on-site guarding; operation management security services, such as remote video solutions, smart security, and track and trace services; advisory security services comprising corporate risk management; and technology security services, which include electronic security. The company also operates operation centers. Securitas AB (publ) was founded in 1934 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Securitas AB (publ) fournit des services de sécurité en Amérique du Nord, en Europe, en Amérique latine, en Afrique, au Moyen-Orient, en Asie et en Australie. La société opère à travers trois segments: Securitas Amérique du Nord, Securitas Europe et Securitas Ibero-America. Il fournit des services de renseignement, tels que le renseignement sur les risques; des services de sûreté et de sécurité, y compris la sûreté aérienne, les services d'incendie et de sécurité, les services de sécurité mobiles et la protection sur site; des services de sécurité de gestion des opérations, tels que les solutions vidéo à distance, la sécurité intelligente et les services de suivi et de traçabilité; des services consultatifs de sécurité comprenant la gestion des risques de l'entreprise; et des services de sécurité technologique, notamment la sécurité électronique."},"valuation":{"market_cap_yahoo":88957566976,"shares_outstanding":545504181,"trailing_pe":12.593192,"forward_pe":12.392344,"price_to_book":2.0105572,"ev_to_ebitda":9.227,"ev_to_revenue":0.795,"dividend_yield":0.0346,"payout_ratio":0.3971,"beta_yahoo":0.713},"targets":{"current_price":155.4,"mean":167.42857,"median":165.5,"high":210.0,"low":128.0,"n_analysts":14,"reco_mean":2.78571,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-23"],"eps_avg":3.36717,"eps_low":3.06265,"eps_high":3.56,"revenue_avg":39265367200,"ex_dividend":"2026-11-18","dividend_date":null},"holders":{"insiders_pct":0.042740002,"institutions_pct":0.58043,"institutions_float_pct":0.60635,"institutions_n":301,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":191,"value":29681,"date":"2026-06-30","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0126,"shares":6860486,"value":1066119482,"date":"2026-07-31","chg":-0.00059999997},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0084,"shares":4604101,"value":715477267,"date":"2026-06-30","chg":0.0082},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0066000004,"shares":3622826,"value":562987138,"date":"2026-09-30","chg":0.0123000005},{"name":"Columbia Funds Series Trust-Columbia Overseas Value Fund","pct":0.0043,"shares":2369611,"value":368237534,"date":"2026-08-31","chg":1.0},{"name":"Dimensional ETF Trust-Dimensional International Value ETF","pct":0.0036000002,"shares":1947041,"value":302570159,"date":"2026-07-31","chg":0.0809},{"name":"Fidelity Concord Street Trust-Fidelity International Index Fund","pct":0.0034,"shares":1873575,"value":291153543,"date":"2026-08-31","chg":0.0069},{"name":"iShares Trust-iShares MSCI EAFE ETF","pct":0.0031,"share