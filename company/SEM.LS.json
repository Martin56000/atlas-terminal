{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T15:59:58+00:00","status":"ok","error":null,"last_success":"2026-10-22T15:59:58+00:00"},"data":{"profile":{"name":"Semapa - Sociedade de Investimento e Gestão, SGPS, S.A.","sector":"Basic Materials","industry":"Paper & Paper Products","country":"Portugal","city":"Lisbon","website":"https://www.semapa.pt","employees":5343,"summary":"Semapa - Sociedade de Investimento e Gestão, SGPS, S.A., through its subsidiaries, engages in the production and sale of pulp, printing and writing papers, and tissues in Portugal, the rest of Europe, the United States, Africa, Asia, and Oceania. It operates through Pulp and Paper, Cement, and Other Businesses segments. The company produces and sells writing and printing thin paper, tissue paper, and moulded fibre packaging; researches, develops, produces, and sells forestry and agricultural products; and produces and sells bleached eucalyptus kraft pulp (BEKP), cork, and pine wood products, as well as electric and thermal energy. It is also involved in the production and sale of cement, ready-mixed concrete, aggregates, mortars, precast concrete, and hydraulic lime. In addition, the company engages in the production of aluminium e-bike frames; and the provision of services related to the recovery of animal by-products and food products containing animal-origin substances to produce fertilizers, animal feed, and biodiesel. The company was incorporated in 1991 and is based in Lisbon, Portugal.","exchange":"Lisbon","currency":"EUR","financial_currency":"EUR","summary_fr":"Semapa - Sociedade de Investimento e Gesto, SGPS, S.A., à travers ses filiales, se consacre à la production et à la vente de pâtes, de papiers d'imprimerie et d'écriture, et de tissus au Portugal, dans le reste de l'Europe, aux États-Unis, en Afrique, en Asie et en Océanie. Il opère à travers les secteurs de la pâte à papier, du ciment et d'autres activités. L'entreprise produit et vend du papier d'écriture et d'impression mince, du papier de soie et des emballages en fibres moulées; recherche, développe, produit et vend des produits forestiers et agricoles; et produit et vend de la pâte kraft blanchie d'eucalyptus (BEKP), du liège et des produits en bois de pin, ainsi que de l'énergie électrique et thermique."},"valuation":{"market_cap_yahoo":1533492096,"shares_outstanding":79869373,"trailing_pe":147.69232,"forward_pe":11.112268,"price_to_book":0.64807945,"ev_to_ebitda":7.334,"ev_to_revenue":1.03,"dividend_yield":0.0319,"payout_ratio":1.0338,"beta_yahoo":0.601},"targets":{"current_price":19.2,"mean":29.2,"median":30.8,"high":31.1,"low":25.7,"n_analysts":3,"reco_mean":1.66667,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-11-04"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":478000000,"ex_dividend":"2026-06-15","dividend_date":null},"holders":{"insiders_pct":0.81787,"institutions_pct":0.08882,"institutions_float_pct":0.48769,"institutions_n":58,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":478000000,"rev_low":478000000,"rev_high":478000000,"rev_year_ago":null,"rev_n":1,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"+1q","end_date":null,"eps_avg":null,"eps_low":null,"eps_high":null,"eps_year_ago":null,"eps_n":null,"eps_growth":null,"rev_avg":0,"rev_low":0,"rev_high":0,"rev_year_ago":null,"rev_n":0,"rev_growth":null,"eps_trend_now":null,"eps_trend_30d":null,"eps_trend_90d":null},{"period":"0y","end_date":"2026-12-31","eps_avg":7.73164,"eps_low":7.56328,"eps_high":7.9,"eps_year_ago":0.8499,"eps_n":2,"eps_growth":8.0971,"rev_avg":2014480830,"rev_low":2012961660,"rev_high":2016000000,"rev_year_ago":2114900000,"rev_n":2,"rev_growth":-0.0475,"eps_trend_now":7.73164,"eps_trend_30d":3.58011,"eps_trend_90d"