{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T15:53:24+00:00","status":"ok","error":null,"last_success":"2026-10-23T15:53:24+00:00"},"data":{"profile":{"name":"SES S.A.","sector":"Communication Services","industry":"Broadcasting","country":"Luxembourg","city":"Betzdorf","website":"https://www.ses.com","employees":3830,"summary":"SES S.A. provides satellite-based data transmission capacity and ancillary services worldwide. The company offers content connectivity solutions, including network spanning satellite and ground infrastructure to create, deliver, and manage video and data solutions. It also provides data connectivity services through its fleet of geostationary earth orbit and medium earth orbit satellites, and ground infrastructures to the aviation, media and broadcast, cloud, cruise, energy, government, maritime, and telco and mobile network operator industries. In addition, the company provides linear video aggregation and distribution to direct-to-home, direct-to-cable, and internet protocol TV homes; channel management solutions comprising playout; and capacity, live feeds and redundancy features for sports and events organizations. It serves broadcasters, platform operators, and content owners. The company was formerly known as SES Global SA and changed its name to SES S.A. in December 2006. SES S.A. was founded in 1985 and is headquartered in Betzdorf, Luxembourg with an additional manufacturing facility in Kockelscheuer, Luxembourg.","exchange":"Paris","currency":"EUR","financial_currency":"EUR","summary_fr":"SES S.A. fournit des capacités de transmission de données par satellite et des services auxiliaires dans le monde entier. La société propose des solutions de connectivité de contenu, y compris des infrastructures de réseau par satellite et au sol pour créer, fournir et gérer des solutions vidéo et de données. Elle fournit également des services de connectivité de données par le biais de sa flotte de satellites géostationnaires en orbite terrestre et en orbite terrestre moyenne, ainsi que des infrastructures au sol pour les industries de l'aviation, des médias et de la radiodiffusion, du cloud, de la croisière, de l'énergie, du gouvernement, du secteur maritime, des télécommunications et des opérateurs de réseaux mobiles."},"valuation":{"market_cap_yahoo":1611971200,"shares_outstanding":356733841,"trailing_pe":null,"forward_pe":-13.104773,"price_to_book":0.85695744,"ev_to_ebitda":6.211,"ev_to_revenue":2.474,"dividend_yield":0.119399995,"payout_ratio":0.3704,"beta_yahoo":0.978},"targets":{"current_price":3.96,"mean":7.39,"median":7.4,"high":11.3,"low":3.7,"n_analysts":10,"reco_mean":2.6,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-05"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":847500000,"ex_dividend":"2026-10-13","dividend_date":null},"holders":{"insiders_pct":0.0,"institutions_pct":0.48364,"institutions_float_pct":0.48364,"institutions_n":137,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0014,"shares":495946,"value":1963946,"date":"2026-06-30","chg":-0.0774}],"funds":[{"name":"LAZARD FUNDS INC-Lazard Global Listed Infrastructure Portfolio","pct":0.060300004,"shares":20899917,"value":82763672,"date":"2026-06-30","chg":0.0},{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0228,"shares":7914679,"value":31342129,"date":"2026-09-30","chg":-0.0509},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0153,"shares":5318750,"value":21062250,"date":"2026-07-31","chg":-0.0034},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0145000005,"shares":5032566,"value":19928961,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.010199999,"shares":3547737,"value":14049038,"date":"2026-06-30","chg":0.0091},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","p