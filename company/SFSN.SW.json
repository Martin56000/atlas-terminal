{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:37:34+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:37:34+00:00"},"data":{"profile":{"name":"SFS Group AG","sector":"Industrials","industry":"Tools & Accessories","country":"Switzerland","city":"Heerbrugg","website":"https://www.sfs.com/ch/en","employees":14341,"summary":"SFS Group AG supplies precision components and assemblies, mechanical fastening systems, tools, and procurement solutions in Switzerland and internationally. It operates in three segments: Engineered Components, Fastening Systems, and Distribution & Logistics. The company offers airbag restraint systems; automation; brake systems; building technology; clip nuts; communication technology; components, assemblies, and complete devices; connections and reinforcements for timber construction; and domestic and kitchen appliances. It also provides fasteners for flat roof and industrial lightweight construction; fasters for inserts; fastening and hinge technology for doors, windows, and glass facades; fastening system for the facade; furniture fittings; hard disk drives; inserts; interior plastics; life-saving fall protection; lifestyle electronics; mobile devices; sensors; seats and doors; powertrain; powertrain technology; snap and click system; tools, forestry, and garden equipment; wire and hypo tubing; and window fittings. In addition, it offers products under the SFS, UNISTEEL, Tegra Medical, GESIPA, TFC, HECO, Hoffmann, GARANT, HOLEX, and other brand names. It serves aircraft, automotive, construction, electronics, medical, and other industries. SFS Group AG was founded in 1928 and is based in Heerbrugg, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"CHF","summary_fr":"SFS Group AG fournit des composants et des assemblages de précision, des systèmes de fixation mécanique, des outils et des solutions d'approvisionnement en Suisse et à l'international. Elle opère sur trois segments : les composants techniques, les systèmes de fixation et la distribution et la logistique. La société propose des systèmes de retenue pour airbags; automatisation; systèmes de freinage; technologie du bâtiment; écrous à clip; technologie de communication; composants, assemblages et dispositifs complets; connexions et renforts pour la construction en bois; et appareils ménagers et de cuisine."},"valuation":{"market_cap_yahoo":5318160896,"shares_outstanding":38875443,"trailing_pe":20.417912,"forward_pe":18.024357,"price_to_book":3.3963108,"ev_to_ebitda":11.345,"ev_to_revenue":1.825,"dividend_yield":0.0183,"payout_ratio":0.37939999,"beta_yahoo":0.718},"targets":{"current_price":136.8,"mean":146.0,"median":145.0,"high":152.0,"low":140.0,"n_analysts":5,"reco_mean":null,"reco_key":"none"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-04-28","dividend_date":"2025-05-07"},"holders":{"insiders_pct":0.57883,"institutions_pct":0.21621001,"institutions_float_pct":0.51335,"institutions_n":140,"institutions":[],"funds":[{"name":"Vanguard International Stock Index-Total Intl Stock Indx","pct":0.0063,"shares":244893,"value":33501363,"date":"2024-10-31","chg":0.0},{"name":"Vanguard Tax Managed Fund-Vanguard Developed Markets Index Fund","pct":0.0038,"shares":149155,"value":20404404,"date":"2024-09-30","chg":0.0194},{"name":"iShares Core MSCI EAFE ETF","pct":0.0034,"shares":131101,"value":17934617,"date":"2024-11-30","chg":0.008},{"name":"DFA Continental Small Company Series","pct":0.0032,"shares":122860,"value":16807248,"date":"2024-10-31","chg":-0.0167},{"name":"DFA International Core Equity Portfolio","pct":0.0021,"shares":83309,"value":11396671,"date":"2024-10-31","chg":-0.0179},{"name":"Vanguard Intl Equity Index Fds-FTSE All World ex U.S.Small Cap Index","pct":0.0016,"shares":61931,"value":8472160,"date":"2024-10-31","chg":0.0168},{"name":"iShares MSCI EAFE Small Cap ET