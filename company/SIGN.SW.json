{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T07:38:15+00:00","status":"ok","error":null,"last_success":"2026-10-30T07:38:15+00:00"},"data":{"profile":{"name":"SIG Group AG","sector":"Consumer Cyclical","industry":"Packaging & Containers","country":"Switzerland","city":"Neuhausen am Rheinfall","website":"https://www.sig.biz","employees":9700,"summary":"SIG Group AG provides aseptic carton packaging systems and solutions for beverage and food products primarily in Europe, India, the Middle East, Africa, the Asia Pacific, and the Americas. The company provides carton, bag-in-box, and spouted pouch packaging solutions; filling lines and other related equipment, packaging material, and after-sales services; carton sleeves, closures, and barrier film and fitments; and commodity hedging products. It operates in China, the United States, Germany, India, Brazil, the Netherlands, Australia, Austria, Mexico, Russia, Saudi Arabia, South Korea, Switzerland, Taiwan, Thailand, Spain, and the United Arab Emirates. The company was formerly known as SIG Combibloc Group AG and changed its name to SIG Group AG in April 2022. SIG Group AG was founded in 1853 and is headquartered in Neuhausen am Rheinfall, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"EUR","summary_fr":"SIG Group AG fournit des systèmes et des solutions d'emballage en carton aseptique pour les boissons et les produits alimentaires principalement en Europe, en Inde, au Moyen-Orient, en Afrique, en Asie-Pacifique et dans les Amériques. La société fournit des solutions d'emballage en carton, en sac-en-boîte et en sachet à bec; des lignes de remplissage et d'autres équipements connexes, du matériel d'emballage et des services après-vente; des manchons en carton, des fermetures et des films barrières et des montages; et des produits de couverture de marchandises. Elle opère en Chine, aux États-Unis, en Allemagne, en Inde, au Brésil, aux Pays-Bas, en Australie, en Autriche, au Mexique, en Russie, en Arabie saoudite, en Corée du Sud, en Suisse, à Taiwan, en Thaïlande, en Espagne et aux Émirats arabes unis."},"valuation":{"market_cap_yahoo":5559513600,"shares_outstanding":382097138,"trailing_pe":null,"forward_pe":19.021658,"price_to_book":2.0638735,"ev_to_ebitda":11.531,"ev_to_revenue":2.39,"dividend_yield":0.0,"payout_ratio":0.97120005,"beta_yahoo":0.759},"targets":{"current_price":14.55,"mean":16.614487,"median":17.503412,"high":19.169657,"low":13.80749,"n_analysts":13,"reco_mean":1.92857,"reco_key":"buy"},"calendar":{"earnings_dates":[],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":803850000,"ex_dividend":"2025-04-11","dividend_date":"2025-04-15"},"holders":{"insiders_pct":0.11356,"institutions_pct":0.59389997,"institutions_float_pct":0.66998,"institutions_n":248,"institutions":[{"name":"Williams Jones Wealth Management, LLC.","pct":0.0001,"shares":26000,"value":378300,"date":"2024-09-30","chg":-0.1419}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0125,"shares":4792226,"value":69726889,"date":"2026-07-31","chg":-0.0092},{"name":"SPDR INDEX SHARES Fd.S-State Street SPDR S&P Global Natural Resources ","pct":0.0099,"shares":3777404,"value":54961228,"date":"2026-09-30","chg":0.1731},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0082,"shares":3123928,"value":45453152,"date":"2026-06-30","chg":-0.017},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0058,"shares":2199403,"value":32001314,"date":"2026-09-30","chg":0.0139999995},{"name":"Victory Portfolios-Victory Trivalent International Small-Cap Fund","pct":0.0027,"shares":1040049,"value":15132713,"date":"2026-06-30","chg":1.0},{"name":"iShares Trust-iShares MSCI EAFE Small-Cap ETF","pct":0.0026,"shares":979147,"value":14246589,"date":"2026-09-30","chg":-0.004},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.00