{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T15:51:24+00:00","status":"ok","error":null,"last_success":"2026-10-23T15:51:24+00:00"},"data":{"profile":{"name":"Swedish Orphan Biovitrum AB (publ)","sector":"Healthcare","industry":"Drug Manufacturers - Specialty & Generic","country":"Sweden","city":"Stockholm","website":"https://www.sobi.com","employees":2119,"summary":"Swedish Orphan Biovitrum AB (publ), a biopharma company, provides medicines in the areas of haematology, immunology, and specialty care in Europe, North America, the Middle East, Asia, and Australia. The company operates through three segments: Haematology, Immunology, and Specialty Care. It offers Alprolix for haemophilia B; ALTUVOCT for the treatment and prophylaxis of bleeding in patients with haemophilia A; Aspaveli/Empaveli for treating adult patients with paroxysmal nocturnal haemoglobinuria; Doptelet for the treatment of immune thrombocytopenia and thrombocytopenia; Elocta/Eloctate for the treatment and prophylaxis of bleeding in patients with haemophilia A; Gamifant for treating hemophagocytic lymphohistiocytosis; Kineret for the treatment of cryopyrin-associated periodic syndrome, rheumatoid arthritis, familial Mediterranean fever, deficiency of interleukin-1 receptor antagonist, and systemic juvenile idiopathic arthritis; Orfadin for hereditary tyrosinemia type 1 and alkaptonuria; Synagis for the prevention of serious lower respiratory tract infection caused by respiratory syncytial virus in infants and young children; VONJO, a kinase inhibitor indicated for the treatment of post-polycythemia vera or post-essential thrombocythemia myelofibrosis; and Zynlonta for treating adult patients with relapsed or refractory diffuse large and high grade B-cell lymphoma. The company also provides other medicines, such as Akynzeo, Jyseleca, Tegsedi, and Waylivra, as well as develops drug substances for ReFacto AF/Xyntha for Pfizer. The company has collaboration agreements with Sanofi, Apellis Pharmaceuticals, Inc., ADC Therapeutics SA, and Cartesian Therapeutics, Inc. The company is in strategic partnership with Innate Pharma SA to enable initiation of the TELLOMAK-3 confirmatory Phase 3 study in cutaneous T cell lymphoma. The company was incorporated in 1939 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK"},"valuation":{"market_cap_yahoo":158063673344,"shares_outstanding":348004559,"trailing_pe":118.28126,"forward_pe":29.209003,"price_to_book":3.7323735,"ev_to_ebitda":13.975,"ev_to_revenue":5.665,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":0.362},"targets":{"current_price":454.2,"mean":498.33334,"median":497.5,"high":590.0,"low":350.0,"n_analysts":12,"reco_mean":2.07692,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-10-27"],"eps_avg":6.215,"eps_low":6.21,"eps_high":6.22,"revenue_avg":8915696280,"ex_dividend":null,"dividend_date":null},"holders":{"insiders_pct":0.09799,"institutions_pct":0.76563,"institutions_float_pct":0.84880996,"institutions_n":330,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":64,"value":29068,"date":"2026-06-30","chg":1.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0089,"shares":2766549,"value":1256566589,"date":"2026-07-31","chg":0.0161},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0058999998,"shares":1831975,"value":832083067,"date":"2026-06-30","chg":0.019299999},{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Intl Fd.","pct":0.0053,"shares":1641012,"value":745347670,"date":"2026-08-31","chg":0.231},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0044,"shares":1377942,"value":625861273,"date":"2026-08-31","chg":-0.0068},{"name":"John Hancock Investment Trust-International Dynamic Growth Fund","pct":0.003,"shares":915276,"value":415718370,"date":"2026-08-31","chg"