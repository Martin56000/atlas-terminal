, and operation and maintenance; and capacity, accessibility, and strategic planning services, as well as intelligent transportation systems. The company also offers urban planning; landscape, building, and interior architecture; and cultural heritage and lighting design services. The company was founded in 1889 and is headquartered in Stockholm, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK"},"valuation":{"market_cap_yahoo":49923473408,"shares_outstanding":330241190,"trailing_pe":21.936506,"forward_pe":19.1148,"price_to_book":3.9455276,"ev_to_ebitda":13.664,"ev_to_revenue":1.716,"dividend_yield":0.027,"payout_ratio":0.5873,"beta_yahoo":0.874},"targets":{"current_price":138.2,"mean":170.33333,"median":169.5,"high":200.0,"low":133.0,"n_analysts":6,"reco_mean":1.5,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-10-29"],"eps_avg":1.52667,"eps_low":1.43,"eps_high":1.6,"revenue_avg":7737000000,"ex_dividend":"2026-04-23","dividend_date":null},"holders":{"insiders_pct":0.09797,"institutions_pct":0.7356,"institutions_float_pct":0.81549,"institutions_n":153,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":1.52667,"eps_low":1.43,"eps_high":1.6,"eps_year_ago":1.33771,"eps_n":3,"eps_growth":0.14130001,"rev_avg":7737000000,"rev_low":7686000000,"rev_high":7821000000,"rev_year_ago":7138000000,"rev_n":4,"rev_growth":0.083900005,"eps_trend_now":1.52667,"eps_trend_30d":1.63,"eps_trend_90d":1.43},{"period":"+1q","end_date":"2026-12-31","eps_avg":2.41,"eps_low":2.32,"eps_high":2.5,"eps_year_ago":1.9659,"eps_n":3,"eps_growth":0.2259,"rev_avg":9547500000,"rev_low":9452000000,"rev_high":9676000000,"rev_year_ago":8548000000,"rev_n":4,"rev_growth":0.1169,"eps_trend_now":2.41,"eps_trend_30d":2.455,"eps_trend_90d":2.26},{"period":"0y","end_date":"2026-12-31","eps_avg":7.21336,"eps_low":6.72,"eps_high":7.71,"eps_year_ago":6.647,"eps_n":6,"eps_growth":0.085200004,"rev_avg":34095498939,"rev_l