{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:51:59+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:51:59+00:00"},"data":{"profile":{"name":"TBC Bank Group PLC","sector":"Financial Services","industry":"Banks - Regional","country":"United Kingdom","city":"London","website":"https://www.tbcbankgroup.com","employees":14000,"summary":"TBC Bank Group PLC, through its subsidiaries, provides banking, leasing, insurance, brokerage, and card processing services to corporate and individual customers in Georgia, Azerbaijan, and Uzbekistan. The company operates through Georgian Financial Services; Uzbekistan Operations; and Other Operations segments. It offers banking business solutions, such as deposit and loans; and other financial services, including non-health insurance and leasing services; asset finance solutions; advisory services; and financial leasing, operating leasing, and sale and leasebacks. The company also offers digital banking services comprising cash loans, deposits, debit cards, remittances, gamification, installment/POS loans, daily banking, credit cards, MSME, and buy now, pay later (BNPL). In addition, it provides payment solutions, such as P2P transfers, utility and government payments, PFM, and QR payments, as well as Payme travel, goals, tickets, and subscription. Further, the company offers brokerage and research solutions, leasing, payment processing, asset management, healthcare e-commerce, retail trade and leasing, PR and marketing, education, data analytics, computer programming, investment vehicle, ecosystem, and digital banking platform, as well as investment banking, financial, customer experience servicing, software services, and postal services. TBC Bank Group PLC was founded in 1992 and is based in London, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"GEL","summary_fr":"TBC Bank Group PLC, par l'intermédiaire de ses filiales, fournit des services bancaires, de crédit-bail, d'assurance, de courtage et de traitement des cartes aux entreprises et aux particuliers en Géorgie, en Azerbaïdjan et en Ouzbékistan. La société opère par l'intermédiaire des services financiers géorgiens, des opérations en Ouzbékistan et d'autres secteurs d'opérations. Il offre des solutions d'affaires bancaires, telles que le dépôt et les prêts; et d'autres services financiers, y compris les services d'assurance non-santé et de crédit-bail; solutions de financement d'actifs; services de conseil; et le crédit-bail financier, le crédit-bail d'exploitation et les ventes et cessions-bail."},"valuation":{"market_cap_yahoo":2509399040,"shares_outstanding":55006557,"trailing_pe":6.2837462,"forward_pe":1.7118199,"price_to_book":42.42813,"ev_to_ebitda":null,"ev_to_revenue":null,"dividend_yield":0.040799998,"payout_ratio":0.3377,"beta_yahoo":0.636},"targets":{"current_price":4562.0,"mean":5871.3125,"median":5807.925,"high":6128.889,"low":5547.7554,"n_analysts":5,"reco_mean":1.0,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-11-06"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":951000000,"ex_dividend":"2026-10-22","dividend_date":null},"holders":{"insiders_pct":0.19139999,"institutions_pct":0.50929,"institutions_float_pct":0.62984,"institutions_n":140,"institutions":[],"funds":[{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Emerging Ma","pct":0.0152,"shares":848795,"value":3872202790,"date":"2026-08-31","chg":0.0},{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0143,"shares":796192,"value":3632227904,"date":"2026-09-30","chg":0.0148},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0117999995,"shares":657156,"value":2997945672,"date":"2026-07-31","chg":0.0052},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.007900001,"shares":440442,"value":2009296404,"date":"2026-07-3