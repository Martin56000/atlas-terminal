{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:52:38+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:52:38+00:00"},"data":{"profile":{"name":"Tele2 AB (publ)","sector":"Communication Services","industry":"Telecom Services","country":"Sweden","city":"Kista","website":"https://www.tele2.com","employees":3711,"summary":"Tele2 AB (publ) provides fixed and mobile connectivity and entertainment services in Sweden, Lithuania, Latvia, and Estonia. The company offers handset related data services, linear and streaming services, mobile telephony and data, fixed broadband and telephony, switch and contact center, cloud services, IT services, network services, workplace, video and collaboration, united communications, and security services. It also provides data network services, including dark fiber, dedicated wavelength, ethernet and IP VPN, and internet services; and unified communications comprising service provider, mobile virtual network operator, and carrier SIP-interconnect services. In addition, the company offers single and dual IMSI solutions for consumer and IoT applications; on-demand roaming services, such as subscription management, data plan management, real time charging, eSIM delivery, SIM management, and set up services; routing and termination solutions for international voice traffic; application-2-person messaging services; and value-added services comprising shortcodes and long numbers for businesses to have 2-way communication with their customers. Tele2 AB (publ) was formerly known as NetCom AB and changed its name to Tele2 AB (publ) in February 2001. The company was incorporated in 1990 and is headquartered in Kista, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Tele2 AB (publ) fournit des services de connectivité et de divertissement fixes et mobiles en Suède, en Lituanie, en Lettonie et en Estonie. La société propose des services de données liés aux combinés, des services linéaires et de streaming, la téléphonie mobile et les données, le haut débit fixe et la téléphonie, le centre de commutation et de contact, les services cloud, les services informatiques, les services de réseau, le lieu de travail, la vidéo et la collaboration, les communications unifiées et les services de sécurité. Il fournit également des services de réseau de données, y compris la fibre noire, longueur d'onde dédiée, ethernet et IP VPN, et les services Internet; et les communications unifiées comprenant fournisseur de services, opérateur de réseau virtuel mobile, et les services d'interconnexion SIP opérateur."},"valuation":{"market_cap_yahoo":110691565568,"shares_outstanding":689095522,"trailing_pe":10.886767,"forward_pe":24.145235,"price_to_book":4.5660014,"ev_to_ebitda":11.185,"ev_to_revenue":4.463,"dividend_yield":0.066199996,"payout_ratio":0.573,"beta_yahoo":0.34},"targets":{"current_price":159.6,"mean":172.42632,"median":170.0,"high":215.0,"low":140.0,"n_analysts":19,"reco_mean":2.66667,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-20"],"eps_avg":-5.61,"eps_low":-5.61,"eps_high":-5.61,"revenue_avg":8154354230,"ex_dividend":"2026-10-12","dividend_date":null},"holders":{"insiders_pct":0.24542,"institutions_pct":0.47807,"institutions_float_pct":0.63356,"institutions_n":353,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.00059999997,"shares":412959,"value":65908258,"date":"2026-06-30","chg":0.1774}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0121,"shares":8093396,"value":1291706050,"date":"2026-07-31","chg":0.0125},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.008,"shares":5365600,"value":856349792,"date":"2026-06-30","chg":0.0155},{"name":"JANUS INVESTMENT FUND-Janus Henderson Global Equity Income Fund","pct":0.0069999998,"shares":4709772,"value":751679639,"date":"2026-06-30","chg":-0.044499997},{"name":