{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-30T16:52:40+00:00","status":"ok","error":null,"last_success":"2026-10-30T16:52:40+00:00"},"data":{"profile":{"name":"Telia Company AB (publ)","sector":"Communication Services","industry":"Telecom Services","country":"Sweden","city":"Solna","website":"https://www.teliacompany.com","employees":14094,"summary":"Telia Company AB (publ) provides communication services to businesses, individuals, families, and communities in Sweden, Finland, Norway, Denmark, Lithuania, Estonia, and Latvia. It offers mobile, broadband, television, and fixed-line services; and networking, cloud and security, mobility, enterprise mobile network, contact center, managed mobility services, collaboration solutions, and telephony. The company also offers Internet of Things (IoT), broadband services via mobile network and fiber, LAN and WiFi, SD-WAN, mobile LAN, dedicated private networks, and data analysis services, as well as colocation solutions. In addition, it provides smart public transport, and smart utilities, as well as transport and logistics solutions comprising connected vehicle, GPS positioning, and fleet management services. It also provides data communication and security solutions to individuals and companies. The company markets its products and services under the Telia, Telia Cygate, TV4, Halebop, Fello, MTV, Phonero, Onecall, MyCall, Ezys, and Diil brand names for transport and logistics, forestry, healthcare and community, agriculture, and energy and mining, as well as manufacturing industries. Telia Company AB (publ) was formerly known as TeliaSonera AB (publ) and changed its name to Telia Company AB (publ) in April 2016. The company was founded in 1853 and is based in Solna, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK","summary_fr":"Telia Company AB (publ) fournit des services de communication aux entreprises, aux particuliers, aux familles et aux communautés en Suède, en Finlande, en Norvège, au Danemark, en Lituanie, en Estonie et en Lettonie. Il offre des services mobiles, à large bande, de télévision et de téléphonie fixe, ainsi que des services de réseau, de cloud et de sécurité, de mobilité, de réseau mobile d'entreprise, de centre de contact, de services de mobilité gérés, de solutions de collaboration et de téléphonie. La société propose également des services Internet des objets (IoT), des services à large bande via réseau mobile et fibre, LAN et WiFi, SD-WAN, LAN mobile, réseaux privés dédiés, et des services d'analyse de données, ainsi que des solutions de colocation."},"valuation":{"market_cap_yahoo":194128232448,"shares_outstanding":3932109286,"trailing_pe":36.57037,"forward_pe":25.317947,"price_to_book":3.469187,"ev_to_ebitda":10.106,"ev_to_revenue":3.291,"dividend_yield":0.043,"payout_ratio":1.4963001,"beta_yahoo":0.225},"targets":{"current_price":49.37,"mean":48.049,"median":49.0,"high":59.0,"low":39.2,"n_analysts":20,"reco_mean":2.89474,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":0.635,"eps_low":0.63,"eps_high":0.64,"revenue_avg":22337196600,"ex_dividend":"2027-02-04","dividend_date":null},"holders":{"insiders_pct":0.41132998,"institutions_pct":0.31954,"institutions_float_pct":0.54282004,"institutions_n":345,"institutions":[{"name":"Paradigm Asset Management Company, LLC","pct":0.0,"shares":12700,"value":626998,"date":"2026-06-30","chg":0.0466}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0086,"shares":33916457,"value":1674455445,"date":"2026-07-31","chg":0.0108},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0057,"shares":22323872,"value":1102129536,"date":"2026-06-30","chg":0.0106},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0044,"shares":17491596,"value":863560075,"date":"2026-09-30","chg":0.0121},{"name":"iShares Trust-iShares International Select D