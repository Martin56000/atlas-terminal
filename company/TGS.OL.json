{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:54:46+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:54:46+00:00"},"data":{"profile":{"name":"TGS ASA","sector":"Energy","industry":"Oil & Gas Equipment & Services","country":"Norway","city":"Oslo","website":"https://www.tgs.com","employees":1640,"summary":"TGS ASA provides geoscience data services to the oil and gas industry in Norway and internationally. It operates through Multi client, Marine Data Acquisition (MDA), Imaging, New Energy Solutions (NES), and Shared Services segments. The company offers seismic data using robust technology and imaging solutions; well data recorded expertly matched and validated, from permit to abandonment; carbon storage and monitoring solutions; wind energy data partner throughout the wind development lifecycle; solar operations; and asset management services. It also offers applications for oil and gas, new energies, data platforms, and ai/machine learning. TGS ASA has a agreement with Ministry of Hydrocarbon and Mining Development of the Republic of Equatorial Guinea to create an offshore MegaSurvey. The company was formerly known as TGS-NOPEC Geophysical Company ASA and changed its name to TGS ASA in June 2021. TGS ASA was founded in 1981 and is headquartered in Oslo, Norway.","exchange":"Oslo","currency":"NOK","financial_currency":"USD","summary_fr":"TGS ASA fournit des services de données géoscientifiques à l'industrie pétrolière et gazière en Norvège et à l'international. Elle opère à travers les segments Multi-clients, Acquisition de données marines (MDA), Imagerie, Nouvelles solutions énergétiques (NES) et Services partagés. La société propose des données sismiques utilisant une technologie robuste et des solutions d'imagerie; des données de puits enregistrées et validées par des experts, du permis à l'abandon; des solutions de stockage et de surveillance du carbone; des partenaires de données sur l'énergie éolienne tout au long du cycle de vie du développement éolien; des opérations solaires; et des services de gestion d'actifs.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":28532234240,"shares_outstanding":196502987,"trailing_pe":41.604584,"forward_pe":11.685502,"price_to_book":1.5437152,"ev_to_ebitda":51.148,"ev_to_revenue":21.277,"dividend_yield":0.0414,"payout_ratio":1.7006,"beta_yahoo":-0.064},"targets":{"current_price":145.2,"mean":149.03484,"median":178.15181,"high":197.5411,"low":67.33472,"n_analysts":7,"reco_mean":2.875,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":0.29643,"eps_low":0.22929,"eps_high":0.38,"revenue_avg":416603000,"ex_dividend":"2026-10-29","dividend_date":null},"holders":{"insiders_pct":0.0,"institutions_pct":0.72699,"institutions_float_pct":0.72699,"institutions_n":139,"institutions":[{"name":"Legato Capital Management LLC","pct":0.0002,"shares":21990,"value":3192947,"date":"2022-09-30","chg":0.5647}],"funds":[{"name":"T. ROWE PRICE Intl Fd.S, INC.-T. Rowe Price Intl Discovery Fd.","pct":0.024300002,"shares":4767547,"value":692247809,"date":"2026-07-31","chg":-0.025899999},{"name":"American Century ETF Trust-Avantis International Small Cap Value ETF","pct":0.0239,"shares":4693362,"value":681476148,"date":"2026-09-30","chg":0.0482},{"name":"Legg Mason Global Asset Management Trust-ClearBridge Value Fund","pct":0.0163,"shares":3200000,"value":464639990,"date":"2026-07-31","chg":1.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0145000005,"shares":2847265,"value":413422869,"date":"2026-07-31","chg":0.0165},{"name":"Fidelity Capital Trust-Fidelity Value Fund","pct":0.0109,"shares":2134400,"value":309914873,"date":"2026-08-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0097,"shares":1913545,"value":277846728,"date":"2026-06-30","chg":0.028199999},{"name":"Fidelity Investment Trust-Fidelity Series Inter