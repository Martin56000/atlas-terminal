{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T15:55:27+00:00","status":"ok","error":null,"last_success":"2026-10-22T15:55:27+00:00"},"data":{"profile":{"name":"Telekom Austria AG","sector":"Communication Services","industry":"Telecom Services","country":"Austria","city":"Vienna","website":"https://a1.group","employees":16255,"summary":"Telekom Austria AG, together with its subsidiaries, provides fixed-line and mobile communications solutions to individuals, commercial and non-commercial organizations, and other national and foreign carriers in Austria, Bulgaria, Croatia, Belarus, Slovenia, Serbia, and North Macedonia. The company offers fixed-line services, including access, internet, fixed-to-mobile calls, international traffic, voice value-added, interconnection, call center, television, IPTV, and smart home services, as well as data and ICT solutions; and digital mobile communications services, such as text and multimedia messaging, m-commerce, information, and entertainment services. It provides end-user terminal equipment; digital products; cloud, security, and IoT solutions; and mobile payment services. The company was founded in 1996 and is headquartered in Vienna, Austria. Telekom Austria AG operates as a subsidiary of América Móvil B.V.","exchange":"Vienna","currency":"EUR","financial_currency":"EUR","summary_fr":"Telekom Austria AG, avec ses filiales, fournit des solutions de communications fixes et mobiles aux particuliers, aux organisations commerciales et non commerciales et à d'autres transporteurs nationaux et étrangers en Autriche, en Bulgarie, en Croatie, en Biélorussie, en Slovénie, en Serbie et en Macédoine du Nord. La société propose des services de téléphonie fixe, y compris l'accès, Internet, les appels fixes à mobiles, le trafic international, la valeur ajoutée vocale, l'interconnexion, les centres d'appels, la télévision, l'IPTV et les services de maison intelligente, ainsi que des solutions de données et de TIC; et des services de communications mobiles numériques, tels que la messagerie texte et multimédia, le commerce mobile, l'information et les services de divertissement. Il fournit des équipements terminaux aux utilisateurs finaux, des produits numériques, des solutions cloud, de sécurité et IoT, ainsi que des services de paiement mobile."},"valuation":{"market_cap_yahoo":null,"shares_outstanding":null,"trailing_pe":8.626263,"forward_pe":7.855257,"price_to_book":1.0236125,"ev_to_ebitda":4.354,"ev_to_revenue":1.291,"dividend_yield":0.048600003,"payout_ratio":0.42419997,"beta_yahoo":null},"targets":{"current_price":8.54,"mean":10.8,"median":10.6,"high":12.0,"low":9.6,"n_analysts":6,"reco_mean":2.66667,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-10-20"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-26","dividend_date":"1970-08-23"},"holders":{"insiders_pct":0.894,"institutions_pct":0.03684,"institutions_float_pct":0.34754002,"institutions_n":103,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":697,"value":5952,"date":"2026-06-30","chg":0.9914}],"funds":[{"name":"Fidelity Investment Trust-Fidelity International Small Cap Fund","pct":0.0036000002,"shares":2404700,"value":20536137,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0017,"shares":1101434,"value":9406246,"date":"2026-07-31","chg":0.0},{"name":"DFA INVESTMENT TRUST CO-The Continental Small Company Series","pct":0.0016,"shares":1067703,"value":9118183,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.001,"shares":689047,"value":5884461,"date":"2026-06-30","chg":-0.039300002},{"name":"JPMorgan Trust I-JPMorgan Developed International Value Fund","pct":0.0008,"shares":547804,"value":4678246,"date":"2026-07-31","chg":0.0},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-Intl Core Eqy. 2 