{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:57:12+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:57:12+00:00"},"data":{"profile":{"name":"Tokmanni Group Oyj","sector":"Consumer Defensive","industry":"Discount Stores","country":"Finland","city":"Mäntsälä","website":"https://www.tokmanni.fi","employees":7666,"summary":"Tokmanni Group Oyj operates as a variety discount retailer in Finland, Sweden, and Denmark. It provides beauty care and cleaning, health and well-being, and cosmetics products; laundry and clothing care, clear-out, and home washing, cleaning, and storage products, as well as toilet paper, kitchen paper, and handkerchiefs; shoes for women, men, and children; clothing and accessories for women, men, and children; wallets, training bags, backpacks, and rain gears; and reflectors, including reflective strips, hanging reflectors, and reflective vests and harnesses. The company also offers home decoration products, such as interior furniture, minimization, soft furnishings, bed linen, and bathroom and sauna; dishes and cutlery, food preparation, kitchen textiles, and kitchen papers and supplies; crafts, craft supplies, drawing tools, stationery, office supplies, and books and paperbacks; and party supplies, including cake candles, balloons, party wear and accessories, party decorations and tableware, party games, and cards and packaging. In addition, it provides toys and children's items; food products, such as sweets and chewing gums, chips, snacks, nuts, Tex-Mex, dry food ingredients, soups and sauces, seasoning and sweetening, drinks, children's food and drink, pastas, rice, flours, biscuits, rusks, rice cakes, cereals, muesli, flakes, preserves, jams, and marmalades; and home renovation products comprising tools, lamps, hardware and HVAC, construction and workwear, and solar panels and accessories. Further, the company offers car accessories, automotive chemicals and oils, and car wash products; leisure products; domestic appliances, entertainment electronics, information technology and gaming, phones and tablets, health and wellness equipment, and batteries; gift cards; and yard and garden products. Tokmanni Group Oyj was founded in 1989 and is headquartered in Mäntsälä, Finland.","exchange":"Helsinki","currency":"EUR","financial_currency":"EUR"},"valuation":{"market_cap_yahoo":404831488,"shares_outstanding":58123687,"trailing_pe":null,"forward_pe":8.887217,"price_to_book":1.7904885,"ev_to_ebitda":9.655,"ev_to_revenue":0.741,"dividend_yield":0.048699997,"payout_ratio":0.5574,"beta_yahoo":0.891},"targets":{"current_price":6.965,"mean":7.13333,"median":7.0,"high":7.4,"low":7.0,"n_analysts":3,"reco_mean":3.25,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-06"],"eps_avg":0.2425,"eps_low":0.22,"eps_high":0.26,"revenue_avg":453075000,"ex_dividend":"2026-04-29","dividend_date":null},"holders":{"insiders_pct":0.04127,"institutions_pct":0.44709998,"institutions_float_pct":0.46633998,"institutions_n":46,"institutions":[],"funds":[],"insider_trades":[]},"estimates":[{"period":"0q","end_date":"2026-09-30","eps_avg":0.2425,"eps_low":0.22,"eps_high":0.26,"eps_year_ago":0.2239,"eps_n":4,"eps_growth":0.083100006,"rev_avg":453075000,"rev_low":450000000,"rev_high":455300000,"rev_year_ago":432800000,"rev_n":4,"rev_growth":0.0468,"eps_trend_now":0.2425,"eps_trend_30d":0.2325,"eps_trend_90d":0.24},{"period":"+1q","end_date":"2026-12-31","eps_avg":0.5375,"eps_low":0.5,"eps_high":0.56,"eps_year_ago":0.516,"eps_n":4,"eps_growth":0.0417,"rev_avg":536350000,"rev_low":534000000,"rev_high":539400000,"rev_year_ago":510800000,"rev_n":4,"rev_growth":0.05,"eps_trend_now":0.5375,"eps_trend_30d":0.5425,"eps_trend_90d":0.54},{"period":"0y","end_date":"2026-12-31","eps_avg":0.61048,"eps_low":0.59,"eps_high":0.64,"eps_year_ago":0.6328,"eps_n":4,"eps_growth":-0.0353,"rev_avg":1810596540,"rev_low":1807000000,"rev_high":1816100000,"rev_year_ago":172830000