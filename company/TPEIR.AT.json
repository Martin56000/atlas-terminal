{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:59:27+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:59:27+00:00"},"data":{"profile":{"name":"Piraeus Bank S.A.","sector":"Financial Services","industry":"Banks - Regional","country":"Greece","city":"Athens","website":"https://www.piraeusbank.gr","employees":8518,"summary":"Piraeus Bank S.A. provides various banking products and services in Greece, Europe, and internationally. The company operates through five segments: Retail Banking, Business Banking, Piraeus Financial Markets, Snappi, and Other. It offers term deposits, savings, current, and payroll and pension accounts; mortgage and personal loans; credit, debit, and prepaid cards; car, civil liability and legal protection, home security, health, pension plans, life and accident, and lifestyle insurance plans; investment products, including savings programs, portfolio management, mutual funds, stock market transactions and services, government bonds and treasury bills, gold investment, and securities custody; and electronic banking services. The company also provides corporate banking products and services, such as professional and farmer accounts; corporate cards; farmer's, business premise, liability, and photovoltaic park insurance plans; and payments and receipts comprising IRIS payments for businesses, business remittance, payment records, collection through bank channels, payroll, accepting cards, money management, checks, and management of bills of exchange. In addition, it offers financing solutions for businesses, which include working capital; professional housing and equipment; co-financed programs, such as farmer financing and specialized solutions; factoring; and letter of guarantee, as well as real estate, equipment, and development leasing. Further, the company provides online stock and bond trading; wealth services comprising investment advice, wealth advisor, multi-family office, execution of transactions, and custody; asset management products, including alternative, structured, and thematic products; and economic and financial planning. It offers its products and services through e-banking, Piraeus app, phone banking, and stores and ATMs. Piraeus Bank S.A. was founded in 1916 and is headquartered in Athens, Greece.","exchange":"Athens","currency":"EUR","financial_currency":"EUR"},"valuation":{"market_cap_yahoo":12584911872,"shares_outstanding":1232003102,"trailing_pe":11.74138,"forward_pe":9.131379,"price_to_book":1.3067673,"ev_to_ebitda":null,"ev_to_revenue":4.761,"dividend_yield":0.0404,"payout_ratio":0.0,"beta_yahoo":0.939},"targets":{"current_price":10.215,"mean":11.66085,"median":12.0,"high":13.7,"low":9.75,"n_analysts":15,"reco_mean":1.1875,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-10-30"],"eps_avg":0.25292,"eps_low":0.25,"eps_high":0.25585,"revenue_avg":755499930,"ex_dividend":"2026-08-03","dividend_date":"2018-01-17"},"holders":{"insiders_pct":0.0,"institutions_pct":0.61131,"institutions_float_pct":0.61131,"institutions_n":302,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":4994,"value":51013,"date":"2026-06-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0128,"shares":15813604,"value":161535967,"date":"2026-07-31","chg":0.0148},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard Emerging Markets Stock Index Fd","pct":0.0121,"shares":14940223,"value":152614380,"date":"2026-07-31","chg":0.0162},{"name":"Columbia Funds Series Trust-Columbia Overseas Value Fund","pct":0.0115,"shares":14220212,"value":145259467,"date":"2026-05-31","chg":0.0871},{"name":"Fidelity Investment TRT-Fidelity Series Emerging Markets Opportunities","pct":0.0111,"shares":13708069,"value":140027926,"date":"2026-08-31","chg":0.16549999},{"name":"Artisan Partners Funds Inc.-Artisan International Fund","pct":0.0104,"shares":12793879,"value":130689475,"date