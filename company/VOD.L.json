{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-23T06:40:12+00:00","status":"ok","error":null,"last_success":"2026-10-23T06:40:12+00:00"},"data":{"profile":{"name":"Vodafone Group Public Limited Company","sector":"Communication Services","industry":"Telecom Services","country":"United Kingdom","city":"Newbury","website":"https://www.vodafone.com","employees":91128,"summary":"Vodafone Group Public Limited Company provides telecommunication services in Germany, the United Kingdom, rest of Europe, Turkey, and South Africa. It offers mobile and fixed services; connectivity business solutions, such as digital services, the Internet of Things (IoT) and financial services; and IoT platforms. The company also provides cloud, multi-cloud, and edge computing solutions; M-PESA, an African mobile money platform to make payments and offer financial services; and international voice and roaming services. In addition, it offers unified communications, mobile connectivity, IoT connectivity, cloud and edge, E2E solutions, and security services; leases fibre and other fixed connectivity services; and engages in infrastructure assets, shared operations, growth platforms, retail, and service operations. The company serves private and public sector customers in health, banking and finance, transport and logistics, retail, utilities, and agriculture industries. Vodafone Group Public Limited Company was incorporated in 1984 and is based in Newbury, the United Kingdom.","exchange":"LSE","currency":"GBp","financial_currency":"EUR","summary_fr":"Vodafone Group Public Limited Company fournit des services de télécommunication en Allemagne, au Royaume-Uni, dans le reste de l'Europe, en Turquie et en Afrique du Sud. Il propose des services mobiles et fixes, des solutions de connectivité pour les entreprises, telles que les services numériques, l’Internet des objets (IoT) et les services financiers, ainsi que des plateformes IoT. La société fournit également des solutions cloud, multi-cloud et Edge Computing; M-PESA, une plate-forme africaine d'argent mobile pour effectuer des paiements et offrir des services financiers; et des services vocaux et d'itinérance internationaux.","summary_fr_excerpt":true},"valuation":{"market_cap_yahoo":27754373120,"shares_outstanding":23167256725,"trailing_pe":null,"forward_pe":12.052482,"price_to_book":65.13176,"ev_to_ebitda":7.963,"ev_to_revenue":1.761,"dividend_yield":0.0332,"payout_ratio":1.0171,"beta_yahoo":0.298},"targets":{"current_price":119.8,"mean":120.18591,"median":125.77898,"high":156.14932,"low":83.87666,"n_analysts":16,"reco_mean":2.5625,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-10"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-06-04","dividend_date":null},"holders":{"insiders_pct":0.00127,"institutions_pct":0.66950995,"institutions_float_pct":0.67037004,"institutions_n":505,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0015,"shares":40558509,"value":4858909501,"date":"2026-06-30","chg":0.104499996},{"name":"Huntington National Bank","pct":0.0,"shares":1,"value":119,"date":"2026-06-30","chg":1.0}],"funds":[{"name":"THORNBURG INVESTMENT TRUST-Thornburg Investment Income Builder Fund","pct":0.0127,"shares":343085324,"value":41101622862,"date":"2026-06-30","chg":0.0467},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0099,"shares":268422416,"value":32157006255,"date":"2026-07-31","chg":0.0047},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0066000004,"shares":177849629,"value":21306386096,"date":"2026-06-30","chg":0.0057},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0050999997,"shares":136456753,"value":16347519425,"date":"2026-08-31","chg":0.0044},{"name":"SCHWAB STRATEGIC TRUST-Schwab Fundamental International Equity ETF","pct":0.0031,"shares":84190623,"value":10086036892,"date":"2026-05-31","chg":-0.0