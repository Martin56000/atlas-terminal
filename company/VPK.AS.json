{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-28T16:51:53+00:00","status":"ok","error":null,"last_success":"2026-10-28T16:51:53+00:00"},"data":{"profile":{"name":"Koninklijke Vopak N.V.","sector":"Energy","industry":"Oil & Gas Midstream","country":"Netherlands","city":"Rotterdam","website":"https://www.vopak.com","employees":4794,"summary":"Koninklijke Vopak N.V., an independent tank storage company, stores and handles liquid chemicals, gases, and oil products to the energy and manufacturing markets worldwide. It operates gas, industrial, chemical, and oil terminals and owns and operates facilities consisting of tanks, jetties, truck loading stations, and pipelines. The company also stores and handles chemicals, such as methanol, xylenes, styrene, alpha olefins, and mono-ethylene glycol; gas, including liquefied natural gas, liquid petroleum gas, ethylene, butadiene, and ammonia; oil products consisting of crude oil, fuel oil, diesel, jet fuel, gasoline, and naphtha; and vegoils and biofuels comprising ethanol, biodiesel, and sustainable aviation fuel. In addition, it is involved in the development of infrastructure solutions for hydrogen, ammonia, CO2, battery energy storage, and low-carbon fuels and feedstocks. It serves producers, manufacturers, distributors, governments, and traders. The company was founded in 1616 and is based in Rotterdam, the Netherlands. Koninklijke Vopak N.V. operates as a subsidiary of HAL Trust.","exchange":"Amsterdam","currency":"EUR","financial_currency":"EUR","summary_fr":"Koninklijke Vopak N.V., une société indépendante de stockage de réservoirs, stocke et traite des produits chimiques liquides, des gaz et des produits pétroliers sur les marchés de l'énergie et de la fabrication dans le monde entier. Elle exploite des terminaux gaziers, industriels, chimiques et pétroliers et possède et exploite des installations comprenant des réservoirs, des jetées, des stations de chargement de camions et des pipelines. La société stocke et traite également des produits chimiques, tels que le méthanol, les xylènes, le styrène, les alpha-oléfines et le monoéthylène glycol; gaz, y compris le gaz naturel liquéfié, le gaz de pétrole liquide, l'éthylène, le butadiène et l'ammoniac; produits pétroliers constitués de pétrole brut, de mazout, de diesel, de carburéacteur, d'essence et de naphta; et les véhicules et biocarburants."},"valuation":{"market_cap_yahoo":6188093440,"shares_outstanding":113961206,"trailing_pe":13.179612,"forward_pe":13.541013,"price_to_book":1.886006,"ev_to_ebitda":14.121,"ev_to_revenue":6.832,"dividend_yield":0.0468,"payout_ratio":0.4369,"beta_yahoo":0.709},"targets":{"current_price":54.3,"mean":59.6,"median":64.0,"high":68.0,"low":48.0,"n_analysts":5,"reco_mean":1.8,"reco_key":"buy"},"calendar":{"earnings_dates":["2026-07-30"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-09-17","dividend_date":null},"holders":{"insiders_pct":0.52625,"institutions_pct":0.21145001,"institutions_float_pct":0.44634,"institutions_n":145,"institutions":[{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":273,"value":14823,"date":"2025-12-31","chg":-0.0521}],"funds":[{"name":"VANGUARD TRUSTEES' EQUITY FUND-Vanguard International Value Fund","pct":0.0105,"shares":1208611,"value":65627576,"date":"2026-07-31","chg":0.22489999},{"name":"Cohen & Steers Infrastructure Fund Inc","pct":0.0095999995,"shares":1105927,"value":60051835,"date":"2026-06-30","chg":0.36130002},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0069999998,"shares":801787,"value":43537033,"date":"2026-07-31","chg":-0.0185},{"name":"DFA INVESTMENT DIMENSIONS GROUP INC-DFA Intl Small Cap Value PORT.","pct":0.0054,"shares":623560,"value":33859307,"date":"2026-07-31","chg":0.0},{"name":"SPDR-EUROPE-SSgA SPDR ETFS Europe I-State Street SPDR S&P Euro Dividen","pct":0.0047999998,"shares":551799,"value":29962685,"date":"202