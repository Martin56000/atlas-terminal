{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-29T16:53:54+00:00","status":"ok","error":null,"last_success":"2026-10-29T16:53:54+00:00"},"data":{"profile":{"name":"Wienerberger AG","sector":"Basic Materials","industry":"Building Materials","country":"Austria","city":"Vienna","website":"https://www.wienerberger.com","employees":20941,"summary":"Wienerberger AG produces and sells clay blocks, facing bricks, roof tiles, and ceramic pavers in Europe West, Europe East, and North America. The company offers wall, facade, and roof system for single, two, and multi-family homes, as well as non-residential construction; and electrical cooling and heating installation, drinking water and wastewater, garden irrigation, irrigation systems and water storage. It also provides engineering services for buildings; pipe systems for safe and secure energy; and water supply and systems for rainwater management and wastewater disposal. In addition, the company offers freshwater, stormwater, and wastewater; transport energy; and agricultural solutions. Wienerberger AG was founded in 1819 and is headquartered in Vienna, Austria.","exchange":"Vienna","currency":"EUR","financial_currency":"EUR","summary_fr":"Wienerberger AG produit et vend des blocs d'argile, des briques de parement, des tuiles et des pavés en céramique en Europe de l'Ouest, en Europe de l'Est et en Amérique du Nord. La société propose des systèmes de murs, de façades et de toits pour des maisons unifamiliales, deux et multifamiliales, ainsi que des constructions non résidentielles; et des installations de refroidissement et de chauffage électriques, de l'eau potable et des eaux usées, des systèmes d'irrigation de jardin, des systèmes d'irrigation et de stockage de l'eau. Il fournit également des services d'ingénierie pour les bâtiments, les systèmes de canalisations pour une énergie sûre et sécurisée, l'approvisionnement en eau et les systèmes de gestion des eaux de pluie et d'évacuation des eaux usées."},"valuation":{"market_cap_yahoo":1796370688,"shares_outstanding":109201866,"trailing_pe":29.375002,"forward_pe":11.699858,"price_to_book":0.67197716,"ev_to_ebitda":8.179,"ev_to_revenue":0.909,"dividend_yield":0.0587,"payout_ratio":1.6964,"beta_yahoo":1.196},"targets":{"current_price":16.45,"mean":18.84444,"median":17.5,"high":24.2,"low":14.5,"n_analysts":9,"reco_mean":3.11111,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-11-12"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":1280538160,"ex_dividend":"2026-05-12","dividend_date":"1970-08-23"},"holders":{"insiders_pct":0.0034999999,"institutions_pct":0.68413,"institutions_float_pct":0.68653,"institutions_n":207,"institutions":[],"funds":[{"name":"Fidelity Puritan Trust-Fidelity Low-Priced Stock Fund","pct":0.0186,"shares":2038370,"value":33531188,"date":"2026-07-31","chg":0.0},{"name":"SPDR-EUROPE-SSgA SPDR ETFS Europe I-State Street SPDR S&P Euro Dividen","pct":0.017,"shares":1866602,"value":30705604,"date":"2026-09-30","chg":0.0342},{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.014400001,"shares":1573347,"value":25881559,"date":"2026-07-31","chg":0.0},{"name":"Bridge Builder Trust-Bridge Builder International Equity Fund","pct":0.01,"shares":1092594,"value":17973172,"date":"2026-06-30","chg":0.0124},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0097,"shares":1058563,"value":17413362,"date":"2026-06-30","chg":0.0232},{"name":"Fidelity Investment Trust-Fidelity International Small Cap Fund","pct":0.0086,"shares":946000,"value":15561700,"date":"2026-07-31","chg":0.0},{"name":"SPDR-EUROPE-SSgA SPDR ETFS Europe I-SPDR S&P Euro Dvdnd Arstcrts UCITS","pct":0.0078,"shares":853830,"value":14045504,"date":"2026-01-31","chg":0.0257},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0078,"shares":851472,"value":14006715,"date":"2026-09-30","chg":0.013300001},{"name":"HARBOR FUND