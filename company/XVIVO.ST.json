{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-21T15:54:34+00:00","status":"ok","error":null,"last_success":"2026-10-21T15:54:34+00:00"},"data":{"profile":{"name":"Xvivo Perfusion AB (publ)","sector":"Healthcare","industry":"Medical Devices","country":"Sweden","city":"Mölndal","website":"https://www.xvivogroup.com","employees":197,"summary":"Xvivo Perfusion AB (publ), a medical technology company, develops and markets machines and perfusion solutions for assessing usable organs and maintains in optimal condition pending transplantation in Sweden. It operates through Thoracic; Abdominal; Services; and other segments. The company offers Kidney Assist Transport, a portable device that allows hypothermic pulsatile perfusion of donor kidneys with oxygenated solution for up to 24 hours; Liver Assist that provides clinicians a choice of perfusion protocols whether hypothermic, normothermic, sub-normothermic, or a combination; XVIVO System (XPS), a comprehensive ex vivo lung perfusion (EVLP) platform that offers an overview of the entire process; and STEEN Solution, a buffered extracellular solution intended for the assessment of isolated lungs after removal from the donor in preparation for eventual transplantation into a recipient. It also provides Perfadex Plus, an extracellular, low potassium, dextran-based electrolyte preservation solution; XPS Disposable Lung Kit that contains all the necessary devices and tubing to run a normothermic EVLP procedure on the XPS; XVIVO Organ Chamber, a sterile single-use container intended to be used as a temporary receptacle for isolated donor lungs; and XVIVO Lung Cannula Set, a sterile single-use set that connects isolated donor lungs to an extracorporeal perfusion system for ex-vivo assessment. In addition, the company offers Kidney Assist that provides clinicians with a choice of perfusion protocols from hypothermic to normothermic perfusion; and Gisto, an integrated system for organ transportation. It operates in Sweden; The Netherlands; The United States; Italy; North and South America; Asia/Pacific and Oceania; and internationally. Xvivo Perfusion AB (publ) was incorporated in 1998 and is headquartered in Mölndal, Sweden.","exchange":"Stockholm","currency":"SEK","financial_currency":"SEK"},"valuation":{"market_cap_yahoo":7137780224,"shares_outstanding":31499470,"trailing_pe":80.354614,"forward_pe":38.341797,"price_to_book":3.244141,"ev_to_ebitda":44.54,"ev_to_revenue":7.874,"dividend_yield":0.0,"payout_ratio":0.0,"beta_yahoo":1.469},"targets":{"current_price":226.6,"mean":321.6,"median":330.0,"high":385.0,"low":260.0,"n_analysts":5,"reco_mean":1.25,"reco_key":"strong_buy"},"calendar":{"earnings_dates":["2026-10-22"],"eps_avg":0.71667,"eps_low":0.5,"eps_high":0.96,"revenue_avg":234155860,"ex_dividend":null,"dividend_date":null},"holders":{"insiders_pct":0.08329,"institutions_pct":0.59998,"institutions_float_pct":0.65449995,"institutions_n":87,"institutions":[],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0111,"shares":351131,"value":79566286,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0076,"shares":237958,"value":53921284,"date":"2026-06-30","chg":0.028299998},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0064,"shares":200134,"value":45350365,"date":"2026-08-31","chg":0.0053},{"name":"Manager Directed Portfolios-Hood River International Opportunity Fund","pct":0.0039,"shares":121700,"value":27577220,"date":"2026-07-31","chg":0.0},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard FTSE All-World ex-US Small-Cap ","pct":0.003,"shares":94050,"value":21311730,"date":"2026-07-31","chg":0.020499999},{"name":"iShares Trust-iShares MSCI EAFE Small-Cap ETF","pct":0.0028,"shares":88635,"value":20084691,"date":"2026-08-31","chg":-0.0341},{"name":"VANGUARD Intl Eqy. INDEX Fd.S-Vanguard European Stock Index Fd.","p