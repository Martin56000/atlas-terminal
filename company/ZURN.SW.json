{"_meta":{"source":"Yahoo Finance via yfinance (profile, statements, analyst estimates)","fetched_at":"2026-10-22T15:53:04+00:00","status":"ok","error":null,"last_success":"2026-10-22T15:53:04+00:00"},"data":{"profile":{"name":"Zurich Insurance Group AG","sector":"Financial Services","industry":"Insurance - Diversified","country":"Switzerland","city":"Zurich","website":"https://www.zurich.com","employees":65000,"summary":"Zurich Insurance Group AG provides insurance products and related services in Europe, the Middle East, Africa, North America, Latin America, and the Asia Pacific. It operates through Property & Casualty Regions, Life Regions, and Farmers segments. The company offers car and motor, home, travel, general liability, life and critical illness, and other insurance products; and saving and investment, and pension and retirement planning products. It also provides property, casualty, energy and engineering lines, and marine; management liability, financial institutions, and professional indemnity; and cyber, accident and health, and credit lines and surety insurance products, as well as non-claims and ancillary services to the farmers exchanges. In addition, it offers employee benefit insurance products; and climate resilience, risk engineering, captive, cyber resilience, and reinsurance services. It serves individuals, small businesses, mid-sized and large companies, and multinational corporations. The company sells its products through agents, brokers, and bank distribution channels. Zurich Insurance Group AG was founded in 1872 and is based in Zurich, Switzerland.","exchange":"Swiss","currency":"CHF","financial_currency":"USD","summary_fr":"Zurich Insurance Group AG fournit des produits d'assurance et des services connexes en Europe, au Moyen-Orient, en Afrique, en Amérique du Nord, en Amérique latine et en Asie-Pacifique. Il opère à travers les segments Immobilier & Casualty Regions, Life Regions et Farmers. L'entreprise offre des produits d'assurance automobile, automobile, habitation, voyage, responsabilité civile générale, vie et maladies graves, ainsi que d'autres produits d'assurance, d'épargne et d'investissement, ainsi que des produits de planification des pensions et de la retraite."},"valuation":{"market_cap_yahoo":92907683840,"shares_outstanding":149369269,"trailing_pe":15.871396,"forward_pe":14.32477,"price_to_book":3.541018,"ev_to_ebitda":6.732,"ev_to_revenue":0.995,"dividend_yield":0.048,"payout_ratio":0.75699997,"beta_yahoo":0.313},"targets":{"current_price":622.0,"mean":616.79724,"median":601.08075,"high":902.0,"low":525.0,"n_analysts":14,"reco_mean":2.71429,"reco_key":"hold"},"calendar":{"earnings_dates":["2026-08-06"],"eps_avg":null,"eps_low":null,"eps_high":null,"revenue_avg":null,"ex_dividend":"2026-04-10","dividend_date":"2025-04-15"},"holders":{"insiders_pct":0.0018600001,"institutions_pct":0.44127,"institutions_float_pct":0.4421,"institutions_n":621,"institutions":[{"name":"Bridges Investment Management, Inc.","pct":0.0,"shares":3447,"value":2144034,"date":"2026-06-30","chg":0.0},{"name":"Pacer Advisors, Inc.","pct":0.0,"shares":1173,"value":729606,"date":"2026-06-30","chg":-0.0369},{"name":"Gamma Investing LLC","pct":0.0,"shares":396,"value":246312,"date":"2026-09-30","chg":0.0}],"funds":[{"name":"VANGUARD STAR FUNDS-Vanguard Total International Stock Index Fund","pct":0.0146,"shares":2200493,"value":1368706646,"date":"2026-07-31","chg":0.0068},{"name":"VANGUARD TAX-MANAGED FUNDS-Vanguard Developed Markets Index Fund","pct":0.0097,"shares":1460630,"value":908511860,"date":"2026-06-30","chg":0.0109},{"name":"iShares Trust-iShares Core MSCI EAFE ETF","pct":0.0073,"shares":1105060,"value":687347320,"date":"2026-08-31","chg":0.0033000002},{"name":"Capital Income Builder","pct":0.0047999998,"shares":723225,"value":449845950,"date":"2026-09-30","chg":0.0},{"name":"Fidelity Rutland Square TRT II-Strategic Advisers Fidelity Intl Fd.","pct":0.0047,"shares":707916,"value":440323752,"date":"2026-08-3